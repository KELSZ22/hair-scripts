<details
  class="custom-product-accordion__item"
  {{ block.shopify_attributes }}
>
  <summary class="custom-product-accordion__summary">
    <span class="custom-product-accordion__title">
      {{ block.settings.heading | escape }}
    </span>

    <span class="custom-product-accordion__icon" aria-hidden="true">
      <span class="custom-product-accordion__icon-plus">
        {{ accordion_icon_plus }}
      </span>

      <span class="custom-product-accordion__icon-minus">
        {{ accordion_icon_minus }}
      </span>
    </span>
  </summary>

  <div class="custom-product-accordion__content-wrap">
    <div class="custom-product-accordion__content">
      {{ block.settings.content }}
    </div>
  </div>
</details>

{% schema %}
{
  "name": "Accordion row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accordion title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your accordion content here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Accordion row"
    }
  ]
}
{% endschema %}