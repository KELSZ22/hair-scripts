{% render 'custom-product-accordion-item',
  heading: block.settings.heading,
  content: block.settings.content,
  content_list_style: block.settings.content_list_style,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Accordion row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accordion title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your accordion content here.</p>"
    },
    {
      "type": "select",
      "id": "content_list_style",
      "label": "Content layout",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "bullet_list",
          "label": "Bullet list"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Accordion row"
    }
  ]
}
{% endschema %}
