{% render 'custom-product-accordion-item',
  heading: block.settings.heading,
  content: block.settings.content,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Accordion row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accordion title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your accordion content here.</p>"
    }
  ],
  "presets": [
    {
      "name": "Accordion row"
    }
  ]
}
{% endschema %}
