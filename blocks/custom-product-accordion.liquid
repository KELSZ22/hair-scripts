{% liquid
  assign accordion_product = closest.product
%}

<div
  class="custom-product-accordion"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

<script>
  (() => {
    const initCustomProductAccordion = (root = document) => {
      const accordions = root.querySelectorAll('.custom-product-accordion');

      accordions.forEach((accordion) => {
        if (accordion.dataset.customAccordionReady === 'true') return;
        accordion.dataset.customAccordionReady = 'true';

        const items = accordion.querySelectorAll('.custom-product-accordion__item');

      /*
        This adds numbers to every accordion item.

        Example:
        Accordion 1 = .custom-product-accordion__item--1
        Accordion 2 = .custom-product-accordion__item--2
        Accordion 3 = .custom-product-accordion__item--3

        It also numbers the content and every p tag inside the content.
      */
      items.forEach((item, index) => {
        const accordionNumber = index + 1;
        const summary = item.querySelector('.custom-product-accordion__summary');
        const title = item.querySelector('.custom-product-accordion__title');
        const icon = item.querySelector('.custom-product-accordion__icon');
        const contentWrap = item.querySelector('.custom-product-accordion__content-wrap');
        const content = item.querySelector('.custom-product-accordion__content');
        const paragraphs = content ? content.querySelectorAll('p') : [];

        item.classList.add(`custom-product-accordion__item--${accordionNumber}`);
        item.setAttribute('data-accordion-index', accordionNumber);

        if (summary) {
          summary.classList.add(`custom-product-accordion__summary--${accordionNumber}`);
          summary.setAttribute('data-accordion-index', accordionNumber);
        }

        if (title) {
          title.classList.add(`custom-product-accordion__title--${accordionNumber}`);
          title.setAttribute('data-accordion-index', accordionNumber);
        }

        if (icon) {
          icon.classList.add(`custom-product-accordion__icon--${accordionNumber}`);
          icon.setAttribute('data-accordion-index', accordionNumber);
        }

        if (contentWrap) {
          contentWrap.classList.add(`custom-product-accordion__content-wrap--${accordionNumber}`);
          contentWrap.setAttribute('data-accordion-index', accordionNumber);
        }

        if (content) {
          content.classList.add(`custom-product-accordion__content--${accordionNumber}`);
          content.setAttribute('data-accordion-index', accordionNumber);
        }

        paragraphs.forEach((paragraph, paragraphIndex) => {
          const paragraphNumber = paragraphIndex + 1;

          paragraph.classList.add('custom-product-accordion__paragraph');
          paragraph.classList.add(`custom-product-accordion__paragraph--${accordionNumber}-${paragraphNumber}`);
          paragraph.setAttribute('data-accordion-index', accordionNumber);
          paragraph.setAttribute('data-paragraph-index', paragraphNumber);
        });
      });

      const stripIngredientBullet = (listItem) => {
        const strong = listItem.querySelector('strong');
        if (!strong) return;
        strong.textContent = strong.textContent.replace(/^\s*•\s*/, '');
      };

      const wrapIngredientDescription = (listItem) => {
        listItem.querySelectorAll('br').forEach((br) => br.remove());

        const strong = listItem.querySelector('strong');
        if (!strong || listItem.querySelector('.custom-product-accordion__ingredient-desc')) return;

        const descriptionNodes = [];
        let node = strong.nextSibling;

        while (node) {
          const next = node.nextSibling;

          if (node.nodeType === Node.TEXT_NODE && !node.textContent.trim()) {
            node.remove();
            node = next;
            continue;
          }

          descriptionNodes.push(node);
          node = next;
        }

        if (descriptionNodes.length === 0) return;

        const description = document.createElement('span');
        description.className = 'custom-product-accordion__ingredient-desc';
        descriptionNodes.forEach((descriptionNode) => description.append(descriptionNode));
        strong.insertAdjacentElement('afterend', description);
      };

      const normalizeIngredientListItems = (list) => {
        if (!list) return;
        list.querySelectorAll(':scope > li').forEach((listItem) => {
          stripIngredientBullet(listItem);
          wrapIngredientDescription(listItem);
        });
      };

      const formatRichtextBulletList = (contentEl) => {
        if (!contentEl || contentEl.dataset.bulletListReady === 'true') return;
        if (contentEl.querySelector('ul')) return;

        const paragraphs = [...contentEl.querySelectorAll(':scope > p')];
        if (paragraphs.length === 0) return;

        const hasBulletParagraph = paragraphs.some(
          (paragraph) =>
            paragraph.textContent.includes('•') ||
            paragraph.innerHTML.includes('&bull;') ||
            paragraph.innerHTML.includes('&#8226;')
        );
        if (!hasBulletParagraph) return;

        contentEl.dataset.bulletListReady = 'true';

        const list = document.createElement('ul');
        list.className = 'custom-product-accordion__ingredient-list';

        const addListItem = (html) => {
          const listItem = document.createElement('li');
          listItem.innerHTML = html;
          stripIngredientBullet(listItem);
          wrapIngredientDescription(listItem);
          list.appendChild(listItem);
        };

        paragraphs.forEach((paragraph) => {
          const html = paragraph.innerHTML;

          if (!html.includes('•')) return;

          const bulletMatch = html.match(/<strong>\s*•/i);
          if (bulletMatch && typeof bulletMatch.index === 'number' && bulletMatch.index > 0) {
            const introHtml = html.slice(0, bulletMatch.index).replace(/(<br\s*\/?>\s*)+$/gi, '');
            const itemHtml = html.slice(bulletMatch.index);

            if (introHtml.trim()) {
              paragraph.innerHTML = introHtml;
            } else {
              paragraph.remove();
            }

            addListItem(itemHtml);
            return;
          }

          addListItem(html);
          paragraph.remove();
        });

        if (list.children.length === 0) return;

        const introParagraph = contentEl.querySelector(':scope > p');
        if (introParagraph) {
          introParagraph.insertAdjacentElement('afterend', list);
        } else {
          contentEl.appendChild(list);
        }
      };

      accordion.querySelectorAll('.custom-product-accordion__content--bullet-list').forEach(formatRichtextBulletList);
      accordion.querySelectorAll('.custom-product-accordion__ingredient-list').forEach(normalizeIngredientListItems);

        const closeItem = (item) => {
        const contentWrap = item.querySelector('.custom-product-accordion__content-wrap');

        if (!contentWrap || !item.open) return;

        contentWrap.style.maxHeight = `${contentWrap.scrollHeight}px`;

        requestAnimationFrame(() => {
          contentWrap.style.maxHeight = '0px';
        });

        setTimeout(() => {
          item.open = false;
        }, 280);
      };

      const openItem = (item) => {
        const contentWrap = item.querySelector('.custom-product-accordion__content-wrap');

        if (!contentWrap) return;

        items.forEach((otherItem) => {
          if (otherItem !== item) {
            closeItem(otherItem);
          }
        });

        item.open = true;
        contentWrap.style.maxHeight = '0px';

        requestAnimationFrame(() => {
          contentWrap.style.maxHeight = `${contentWrap.scrollHeight}px`;
        });

        setTimeout(() => {
          if (item.open) {
            contentWrap.style.maxHeight = 'none';
          }
        }, 280);
      };

      items.forEach((item) => {
        const summary = item.querySelector('.custom-product-accordion__summary');
        const contentWrap = item.querySelector('.custom-product-accordion__content-wrap');

        if (!summary || !contentWrap) return;

        if (item.open) {
          contentWrap.style.maxHeight = 'none';
        } else {
          contentWrap.style.maxHeight = '0px';
        }

        summary.addEventListener('click', (event) => {
          event.preventDefault();

          if (item.open) {
            closeItem(item);
          } else {
            openItem(item);
          }
        });
      });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initCustomProductAccordion());
    } else {
      initCustomProductAccordion();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initCustomProductAccordion(event.target);
    });
  })();
</script>

{% stylesheet %}
  .custom-product-accordion {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    align-self: stretch;
  }

  .custom-product-accordion__icon svg path {
    fill: var(--Old-colors-Scheme-1-Text-Dark, #211b18);
  }

  .custom-product-accordion__ingredient-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .custom-product-accordion__ingredient-list > li {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    padding: 10px;
    background-color: #3d7e7a !important;
    color: #ffffff;
    border-radius: 10px;
  }

  .custom-product-accordion__ingredient-list > li br {
    display: none;
  }

  .custom-product-accordion__ingredient-list > li > * {
    margin: 0;
  }

  .custom-product-accordion__ingredient-list > li strong {
    display: block;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    color: #ffffff;
  }

  .custom-product-accordion__ingredient-list > li .custom-product-accordion__ingredient-desc {
    display: block;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.35;
    color: #ffffff;
  }

  .custom-product-accordion__ingredient-list > li:not(:has(strong)) {
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.35;
    color: #ffffff;
  }

  .custom-product-accordion__ingredient-list--benefits > li {
    flex-direction: row;
    align-items: flex-start;
    gap: 8px;
  }

  .custom-product-accordion__benefit-check {
    display: inline-flex;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: #ffffff;
  }

  .custom-product-accordion__benefit-check svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .custom-product-accordion__benefit-text {
    flex: 1;
    min-width: 0;
  }

  .custom-product-accordion__content--bullet-list > p:last-of-type {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .product-details .group-block-content.layout-panel-flex--column > *:has(> .custom-product-accordion) {
      align-self: stretch;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
  }

  .custom-product-accordion__item {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border-bottom: 1px solid rgba(33, 27, 24, 0.16);
  }

  .custom-product-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }

  .custom-product-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .custom-product-accordion__title {
    flex: 1;
    overflow: hidden;
    color: var(--Old-colors-Scheme-1-Text-Dark, #211b18);
    text-align: left;
    text-overflow: ellipsis;

    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }

  .custom-product-accordion__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    min-width: 17px;
  }

  .custom-product-accordion__icon svg {
    display: block;
    width: 17px;
    height: 17px;
  }

  .custom-product-accordion__icon-minus {
    display: none;
  }

  .custom-product-accordion__item[open] .custom-product-accordion__icon-plus {
    display: none;
  }

  .custom-product-accordion__item[open] .custom-product-accordion__icon-minus {
    display: inline-flex;
  }

  .custom-product-accordion__content-wrap {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.28s ease;
  }

  .custom-product-accordion__content {
    padding: 0 0 18px;
    color: var(--new-colors-gray-subhead, #6b6b6b);

    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  .custom-product-accordion__content :is(p, .custom-product-accordion__paragraph) {
    color: var(--new-colors-gray-subhead, #6b6b6b);
  }

  .custom-product-accordion__content p {
    margin: 0;
  }

  .custom-product-accordion__content p + p {
    margin-top: 10px;
  }

  /*
    Now you can target each accordion separately.

    Whole accordion 2:
    .custom-product-accordion__item--2 {}

    Accordion 2 content:
    .custom-product-accordion__content--2 {}

    Accordion 2 first paragraph:
    .custom-product-accordion__paragraph--2-1 {}

    Ingredients bullet list:
    .custom-product-accordion__ingredient-list {}
  */

.custom-product-accordion__item--2 p.custom-product-accordion__paragraph:not(.custom-product-accordion__paragraph--2-1):not(.custom-product-accordion__paragraph--2-10) {
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.35;
    color: #ffffff !important;
    background-color: #3d7e7a !important;
    padding: 10px !important;
    border-radius: 10px !important;
    margin: 0 0 5px !important;
}
p.custom-product-accordion__paragraph.custom-product-accordion__paragraph--2-10 {
    margin-top: 20px;
}
p.custom-product-accordion__paragraph.custom-product-accordion__paragraph--2-1 {
    margin-bottom: 15px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Custom accordion",
  "blocks": [
    {
      "type": "custom-product-accordion-row"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Only accordion rows added in the Shopify editor will be shown."
    }
  ],
  "presets": [
    {
      "name": "Custom accordion"
    }
  ]
}
{% endschema %}