{% liquid
  assign accordion_product = closest.product
  assign mf_description = blank
  assign mf_key_benefits = blank
  assign mf_ingredients = blank
  if accordion_product != blank
    assign mf_description = accordion_product.metafields.custom.description
    assign mf_key_benefits = accordion_product.metafields.custom.key_benefits
    assign mf_ingredients = accordion_product.metafields.custom.ingredients
  endif
  assign mf_rows = false
  if mf_description != blank or mf_key_benefits != blank or mf_ingredients != blank
    assign mf_rows = true
  endif

  assign heading_description = block.settings.heading_description | default: 'Description'
  assign heading_key_benefits = block.settings.heading_key_benefits | default: 'Key benefits'
  assign heading_ingredients = block.settings.heading_ingredients | default: 'Ingredients'
%}

<div
  class="custom-product-accordion"
  {{ block.shopify_attributes }}
>
  {% if mf_rows %}
    {% if mf_description != blank %}
      {% render 'custom-product-accordion-item',
        heading: heading_description,
        metafield: mf_description
      %}
    {% endif %}
    {% if mf_key_benefits != blank %}
      {% render 'custom-product-accordion-item',
        heading: heading_key_benefits,
        metafield: mf_key_benefits
      %}
    {% endif %}
    {% if mf_ingredients != blank %}
      {% render 'custom-product-accordion-item',
        heading: heading_ingredients,
        metafield: mf_ingredients
      %}
    {% endif %}
  {% else %}
    {% content_for 'blocks' %}
  {% endif %}
</div>

<script>
  (() => {
    const accordions = document.querySelectorAll('.custom-product-accordion');

    accordions.forEach((accordion) => {
      if (accordion.dataset.customAccordionReady === 'true') return;
      accordion.dataset.customAccordionReady = 'true';

      const items = accordion.querySelectorAll('.custom-product-accordion__item');

      const closeItem = (item) => {
        const contentWrap = item.querySelector('.custom-product-accordion__content-wrap');

        if (!contentWrap || !item.open) return;

        contentWrap.style.maxHeight = `${contentWrap.scrollHeight}px`;

        requestAnimationFrame(() => {
          contentWrap.style.maxHeight = '0px';
        });

        setTimeout(() => {
          item.open = false;
        }, 280);
      };

      const openItem = (item) => {
        const contentWrap = item.querySelector('.custom-product-accordion__content-wrap');

        if (!contentWrap) return;

        items.forEach((otherItem) => {
          if (otherItem !== item) {
            closeItem(otherItem);
          }
        });

        item.open = true;
        contentWrap.style.maxHeight = '0px';

        requestAnimationFrame(() => {
          contentWrap.style.maxHeight = `${contentWrap.scrollHeight}px`;
        });

        setTimeout(() => {
          if (item.open) {
            contentWrap.style.maxHeight = 'none';
          }
        }, 280);
      };

      items.forEach((item) => {
        const summary = item.querySelector('.custom-product-accordion__summary');
        const contentWrap = item.querySelector('.custom-product-accordion__content-wrap');

        if (!summary || !contentWrap) return;

        if (item.open) {
          contentWrap.style.maxHeight = 'none';
        } else {
          contentWrap.style.maxHeight = '0px';
        }

        summary.addEventListener('click', (event) => {
          event.preventDefault();

          if (item.open) {
            closeItem(item);
          } else {
            openItem(item);
          }
        });
      });
    });
  })();
</script>

{% stylesheet %}
  .custom-product-accordion {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    align-self: stretch;
  }

  /*
    Product details uses a column flex (.layout-panel-flex--column) with align-items from theme
    settings (often flex-start). Shopify wraps each block in a div that then shrinks to content
    width. Stretch that wrapper on desktop so the accordion row/summary span the full column.
  */
  @media screen and (min-width: 750px) {
    .product-details .group-block-content.layout-panel-flex--column > *:has(> .custom-product-accordion) {
      align-self: stretch;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
  }

  .custom-product-accordion__item {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border-bottom: 1px solid rgba(33, 27, 24, 0.16);
  }

  .custom-product-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }

  .custom-product-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .custom-product-accordion__title {
    flex: 1;
    overflow: hidden;
    color: var(--Old-colors-Scheme-1-Text-Dark, #211B18);
    text-align: left;
    text-overflow: ellipsis;

    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }

  .custom-product-accordion__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    min-width: 17px;
  }

  .custom-product-accordion__icon svg {
    display: block;
    width: 17px;
    height: 17px;
  }

  .custom-product-accordion__icon-minus {
    display: none;
  }

  .custom-product-accordion__item[open] .custom-product-accordion__icon-plus {
    display: none;
  }

  .custom-product-accordion__item[open] .custom-product-accordion__icon-minus {
    display: inline-flex;
  }

  .custom-product-accordion__content-wrap {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.28s ease;
  }

  .custom-product-accordion__content {
    padding: 0 0 18px;
    color: var(--new-colors-gray-subhead, #6B6B6B);

    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  .custom-product-accordion__content p {
    margin: 0;
  }

  .custom-product-accordion__content p + p {
    margin-top: 10px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom accordion",
  "blocks": [
    {
      "type": "custom-product-accordion-row"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "When the product has any of the metafields custom.description, custom.key_benefits, or custom.ingredients, those rows are shown automatically. Otherwise, accordion rows configured below are used."
    },
    {
      "type": "header",
      "content": "Metafield row headings"
    },
    {
      "type": "text",
      "id": "heading_description",
      "label": "Description heading",
      "default": "Description"
    },
    {
      "type": "text",
      "id": "heading_key_benefits",
      "label": "Key benefits heading",
      "default": "Key benefits"
    },
    {
      "type": "text",
      "id": "heading_ingredients",
      "label": "Ingredients heading",
      "default": "Ingredients"
    }
  ],
  "presets": [
    {
      "name": "Custom accordion"
    }
  ]
}
{% endschema %}