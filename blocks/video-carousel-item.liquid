{% assign video_url = block.settings.youtube_link | append: '' %}
{% assign youtube_id = blank %}

{% if video_url contains 'youtu.be/' %}
  {% assign youtube_id = video_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
{% elsif video_url contains 'youtube.com/shorts/' %}
  {% assign youtube_id = video_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
{% elsif video_url contains 'youtube.com/embed/' %}
  {% assign youtube_id = video_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
{% elsif video_url contains 'youtube.com/live/' %}
  {% assign youtube_id = video_url | split: 'youtube.com/live/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
{% elsif video_url contains 'v=' %}
  {% assign youtube_id = video_url | split: 'v=' | last | split: '&' | first | split: '#' | first %}
{% endif %}

<div
  class="video-carousel-block__card"
  {{ block.shopify_attributes }}
>
  {% if block.settings.youtube_link != blank %}
    <a
      href="{{ block.settings.youtube_link }}"
      class="video-carousel-block__link"
      data-video-url="{{ block.settings.youtube_link | escape }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{{ block.settings.card_text | default: 'Open YouTube video' | escape }}"
    >
      {% if youtube_id != blank %}
        <img
          src="https://img.youtube.com/vi/{{ youtube_id }}/maxresdefault.jpg"
          onerror="this.onerror=null; this.src='https://img.youtube.com/vi/{{ youtube_id }}/hqdefault.jpg';"
          loading="lazy"
          class="video-carousel-block__image"
          alt="{{ block.settings.card_text | default: 'YouTube video thumbnail' | escape }}"
        >
      {% else %}
        <div class="video-carousel-block__placeholder"></div>
      {% endif %}

      {% if block.settings.card_text != blank %}
        <span class="video-carousel-block__card-title">
          {{ block.settings.card_text | escape }}
        </span>
      {% endif %}
    </a>
  {% else %}
    <div class="video-carousel-block__link">
      <div class="video-carousel-block__placeholder"></div>

      {% if block.settings.card_text != blank %}
        <span class="video-carousel-block__card-title">
          {{ block.settings.card_text | escape }}
        </span>
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Video item",
  "settings": [
    {
      "type": "url",
      "id": "youtube_link",
      "label": "YouTube / Shorts link"
    },
    {
      "type": "text",
      "id": "card_text",
      "label": "Card text"
    }
  ],
  "presets": [
    {
      "name": "Video item"
    }
  ]
}
{% endschema %}