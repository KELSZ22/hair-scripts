{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {number} product_media_size - Number of media items in the product
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object (`desktop_media_position`, `equal_columns`, optional `media_column_width` % when equal columns off)
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product_media_size: product.media.size,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product_media_size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase

  # Desktop column widths (schema: media_column_width). DOM column 1 = first rendered column.
  assign product_grid_css_vars = ''
  if product_has_media
    unless settings.equal_columns
      assign media_pct = settings.media_column_width | default: 50 | plus: 0
      if media_pct > 65
        assign media_pct = 65
      elsif media_pct < 35
        assign media_pct = 35
      endif
      assign details_pct = 100 | minus: media_pct
      if settings.desktop_media_position == 'left'
        assign col_1_pct = media_pct
        assign col_2_pct = details_pct
      else
        assign col_1_pct = details_pct
        assign col_2_pct = media_pct
      endif
      assign product_grid_css_vars = '--product-information-col-1-pct: ' | append: col_1_pct | append: '%; --product-information-col-2-pct: ' | append: col_2_pct | append: '%;'
    endunless
  endif

  assign hs_mobile_product_title = ''

  if closest.product != blank
    assign hs_mobile_product_title = closest.product.title
  elsif product != blank
    assign hs_mobile_product_title = product.title
  endif
%}

<div class="section-background color-{{ settings.color_scheme }}"></div>

<div
  class="product-information section section--{{ content_width }} spacing-style color-{{ settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}

  <div
    class="{{ product_grid_class }}"
    data-product-grid-content
    {% if product_grid_css_vars != blank %}
      style="{{ product_grid_css_vars }}"
    {% endif %}
  >
    {% if hs_mobile_product_title != blank %}
      <h1 class="hs-mobile-product-title">
        {{ hs_mobile_product_title | escape }}
      </h1>
    {% endif %}

    {% assign render_order_array = render_order | split: ',' %}

    {% capture media %}
      <div class="product-information__media-container">
        <div
          class="product-information__media"
          data-testid="product-information-media"
        >
          {{ media_gallery }}
        </div>
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ product_details }}
      {% endif %}
    {% endfor %}
  </div>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  .hs-mobile-product-title {
    display: none;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
    grid-row: 1;
    align-self: start;
    margin-block-start: 0;
    padding-block-start: 0;
  }

  .product-information__media > media-gallery,
  .product-information__media > media-gallery.spacing-style {
    --padding-block-start: 0px;
    --margin-block-start: 0px;
    margin-block-start: 0;
    padding-block-start: 0;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  .product-information__media-container {
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .spacing-style,
  .inherit-spacing {
    margin-block-start: 0;
    padding-block-start: 0;
  }

  /* RTE text blocks in details: override global gray rte-formatter.rte p (base.css) */
  .product-information
    .product-details
    rte-formatter.text-block.rte:not(.product-description)
    :is(p, li, h1, h2, h3, h4, h5, h6) {
    color: var(--Old-colors-Scheme-1-Text-Dark, #211b18);
  }

  .product-information .product-details rte-formatter.text-block.rte.product-description :is(p, li, h1, h2, h3, h4, h5, h6) {
    color: var(--new-colors-gray-subhead, #6b6b6b);
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__grid:not(.product-information--media-none) {
      display: grid !important;
      grid-template-columns: 1fr !important;
    }

    .hs-mobile-product-title {
      display: block;
      grid-column: 1 / -1 !important;
      width: 100%;
      margin: 0 0 14px;
      color: var(--Old-colors-Scheme-1-Text-Dark, #211B18);
      font-family: "Cormorant Garamond", serif;
      font-size: 32px;
      font-style: normal;
      font-weight: 400;
      line-height: 1.1;
      text-transform: uppercase;
    }

    .product-information .product-details .product-title,
    .product-information .product-details [data-testid="product-title"],
    {
      display: none !important;
    }

    .product-information__media-container,
    .product-information__media,
    .product-details {
      grid-column: 1 / -1 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    .product-information__media-container,
    .product-information__media {
      position: static !important;
      top: auto !important;
    }

    .spacing-style,
    .inherit-spacing {
      margin-block-start: 5px;
    }

    /*
      RTE / text blocks in details: global rules (e.g. hero copy) use rte-formatter.spacing-style p at 18px.
      Keep product PDP subcopy at 14px on small screens to match base typography.
    */
    .product-information .product-details rte-formatter.text-block.rte :is(p, li) {
      font-size: 14px;
    }
    .hs-mobile-supply-below-title {
      overflow: hidden;

      margin-bottom: 10px;
    }

    .hs-mobile-supply-below-title p {
      margin: 0;
            color: var(--Old-colors-Scheme-1-Text-Dark, #211B18);
      text-overflow: ellipsis;
      font-family: "DM Sans";
      font-size: 12px !important;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
    }
    .product-information__grid.product-information--media-left h1{
      margin-bottom: 5px !important;
    }
  }

  @media screen and (max-width: 450px) {
    .hs-mobile-product-title {
      font-size: 28px;
    }

    .product-information .product-details rte-formatter.text-block.rte :is(p, li) {
      font-size: 14px !important;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(.product-information--media-none) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(.product-information--media-none) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    --details-max-width: var(--sidebar-width);
    max-width: var(--details-max-width);
  }

  @media screen and (min-width: 1600px) {
    .product-information__grid--limit-details .product-details > .group-block {
      --details-max-width: 32rem;
    }
  }

  /*
    Desktop media/details columns: widths from section schema (--product-information-col-* on the grid).
    Skips equal-columns layout so the dedicated half-grid template applies.
  */
  @media screen and (min-width: 750px) {
    .product-information__grid:not(.product-information--media-none):not(.product-information__grid--half) {
      display: grid !important;
      grid-template-columns:
        minmax(0, var(--product-information-col-1-pct, 50%)) minmax(0, var(--product-information-col-2-pct, 50%)) !important;
      align-items: start !important;
      align-content: start !important;
    }

    /* layout-panel-style sets --vertical-alignment: center on column groups; that centers blocks vs tall media */
    .product-information__grid:not(.product-information--media-none)
      .product-details
      .group-block-content.layout-panel-flex--column {
      justify-content: flex-start !important;
      align-items: flex-start !important;
    }

    /* Only the outer __media wrapper should be sticky; inner sticky + header offset margins misalign columns */
    .product-information__grid:not(.product-information--media-none)
      .product-information__media
      > media-gallery.sticky-content {
      position: static !important;
      top: auto !important;
      margin-top: 0 !important;
      z-index: auto;
    }

    /* Prevent slides stretch-to-tallest (makes short media look vertically centered in the row) */
    .product-information__grid:not(.product-information--media-none) .product-information__media slideshow-component {
      --slideshow-align-items: flex-start !important;
    }

    .product-information__grid:not(.product-information--media-none)
      .product-information__media
      .media-gallery--carousel
      slideshow-component:has(slideshow-controls[thumbnails]) {
      align-content: start !important;
      justify-content: start !important;
      justify-items: start !important;
    }

    /*
      Thumbnail rail: column flex inherits justify-content: space-between from slideshow-controls,
      which pins the first/last flex children to opposite ends when the rail is min-height: 100% tall.
      Keep rail + thumbnails packed to block-start so the gallery meets the top of the media column.
    */
    .product-information__grid:not(.product-information--media-none)
      .product-information__media
      slideshow-controls[thumbnails]:is([pagination-position='left'], [pagination-position='right']):not(
        [controls-on-media]
      ) {
      justify-content: flex-start !important;
      align-items: flex-start !important;
    }

    .product-information__grid.product-information--media-left .product-information__media {
      grid-column: 1 / 2 !important;
      order: 0 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
      align-self: start !important;
      justify-self: stretch !important;
      margin-block-start: 0 !important;
      margin-inline-start: 0 !important;
      padding-block-start: 0 !important;
      padding-inline-start: 0 !important;
      padding-left: 0 !important;
      padding-right: calc(var(--gap, 0) / 2) !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      align-items: flex-start !important;
      align-content: flex-start !important;
      min-block-size: 0 !important;
    }

    /* Slideshow row defaults can vertically center slides; keep media flush to top of grid cell */
    .product-information__grid.product-information--media-left .product-information__media slideshow-slides {
      align-items: flex-start !important;
    }

    .product-information__grid.product-information--media-left .product-information__media media-gallery {
      align-self: stretch !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      align-items: stretch !important;
    }

    .product-information__grid.product-information--media-left .product-information__media slideshow-component {
      align-self: stretch !important;
      width: 100% !important;
    }

    .product-information__grid.product-information--media-left .product-information__media slideshow-container {
      align-self: start !important;
      width: 100% !important;
    }

    .product-information__grid.product-information--media-left
      .product-information__media
      slideshow-slide.product-media-container {
      align-self: flex-start !important;
    }

    /* Gallery block spacing-style can add block-start padding above the carousel */
    .product-information__grid.product-information--media-left
      .product-information__media
      > media-gallery.spacing-style {
      --padding-block-start: 0px;
      --margin-block-start: 0px;
    }

    .product-information__grid.product-information--media-left .product-details {
      grid-column: 2 / 3 !important;
      order: 1 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
      align-self: start !important;
      padding-left: calc(var(--gap, 0) / 2) !important;
      padding-right: 0 !important;
    }

    .product-information__grid.product-information--media-right .product-details {
      grid-column: 1 / 2 !important;
      order: 0 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
      align-self: start !important;
      padding-left: 0 !important;
      padding-right: calc(var(--gap, 0) / 2) !important;
    }

    .product-information__grid.product-information--media-right .product-information__media {
      grid-column: 2 / 3 !important;
      order: 1 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
      align-self: start !important;
      padding-left: calc(var(--gap, 0) / 2) !important;
      padding-right: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      align-items: flex-start !important;
      align-content: flex-start !important;
      min-block-size: 0 !important;
    }

    .product-information__grid.product-information--media-right .product-information__media slideshow-slides {
      align-items: flex-start !important;
    }

    .product-information__grid.product-information--media-right .product-information__media media-gallery {
      align-self: stretch !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-start !important;
      align-items: stretch !important;
    }

    .product-information__grid.product-information--media-right .product-information__media slideshow-component {
      align-self: stretch !important;
      width: 100% !important;
    }

    .product-information__grid.product-information--media-right .product-information__media slideshow-container {
      align-self: start !important;
      width: 100% !important;
    }

    .product-information__grid.product-information--media-right
      .product-information__media
      slideshow-slide.product-media-container {
      align-self: flex-start !important;
    }

    .product-information__grid.product-information--media-right
      .product-information__media
      > media-gallery.spacing-style {
      --padding-block-start: 0px;
      --margin-block-start: 0px;
    }

    .section--full-width .product-information__grid.product-information--media-left .product-information__media,
    .section--full-width .product-information__grid.product-information--media-left .product-details,
    .section--full-width .product-information__grid.product-information--media-right .product-information__media,
    .section--full-width .product-information__grid.product-information--media-right .product-details {
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100% !important;
    }
  }

  /*
    STICKY PRODUCT MEDIA ON DESKTOP
    Keeps the product media/gallery sticky while the product details scroll.
  */
  @media screen and (min-width: 750px) {
    .product-information__grid:not(.product-information--media-none) .product-information__media {
      position: sticky !important;
      top: calc(var(--header-group-height, 0px) + 20px) !important;
      align-self: start !important;
      height: fit-content !important;
      z-index: 2;
    }
  }

  /*
    Align main gallery media to the start of the product grid column.
    Global .product-media-container.constrain-height uses horizontal auto margins (centers
    the slide in the slideshow flex row); reset that here so the image meets the left edge.
  */
  .product-information__media slideshow-slide.product-media-container.constrain-height {
    margin-inline: 0;
  }

  /* Viewport-constrained slides use flex centering in gallery CSS; top-align on PDP */
  .product-information__media .product-media-container.constrain-height {
    align-items: flex-start !important;
    justify-content: flex-start !important;
  }

  .product-information__media slideshow-slide {
    scroll-snap-align: start;
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  /*
    Recharge Subscription Widget v2 — visual restyle on PDP.
    Targets exposed CSS parts (https://docs.rechargepayments.com) so styling
    survives across Recharge widget updates and crosses the shadow boundary
    without touching internal class names. Functionality is unchanged.
  */
  .product-information recharge-subscription-widget {
    --rc-card-bg: #f7f2e9;
    --rc-card-bg-selected: #c7e2dc;
    --rc-card-border: #e8e0d0;
    --rc-card-border-selected: #1e3a35;
    --rc-text: #211b18;
    --rc-muted: #6b6b6b;
    --rc-badge-bg: #c2613f;
    --rc-badge-text: #ffffff;
    --rc-card-radius: 16px;
    --rc-card-padding: 20px 22px 18px;
    --rc-divider: rgba(33, 27, 24, 0.1);
    --rc-widget-brand-color: #237b84 !important;

    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    color: var(--rc-text);
    font-family: 'DM Sans', sans-serif;
  }

  /*
    Product details renders each block in a Shopify wrapper (div#shopify-block-...) inside
    .layout-panel-flex--column. With the theme's default flex-start cross alignment that
    wrapper shrinks to content width, capping the Recharge widget. Stretch the wrapper on
    desktop so the widget spans the full details column.
  */
  @media screen and (min-width: 750px) {
    .product-details .group-block-content.layout-panel-flex--column > *:has(> recharge-subscription-widget) {
      align-self: stretch;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
  }

  .product-information recharge-subscription-widget::part(rc-content-wrap) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .product-information recharge-subscription-widget::part(rc-plans-button) {
    box-sizing: border-box;
    background-color: transparent;
    border: 1px solid #ffffff;
    border-radius: 9999px;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }

  .product-information recharge-subscription-widget::part(rc-plans-button__selected) {
    background-color: #c4a882;
    border: none;
  }

  .product-information recharge-subscription-widget::part(rc-purchase-option) {
    position: relative;
    display: block;
    box-sizing: border-box;
