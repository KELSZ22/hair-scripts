<script>
  (function () {
    const mobileQuery = window.matchMedia('(max-width: 749px)');

    let eyebrowBlock = null;
    let originalParent = null;
    let originalNextSibling = null;
    let mobileHolder = null;

    function findEyebrowBlock() {
      return Array.from(document.querySelectorAll('rte-formatter.text-block')).find(function (el) {
        return el.textContent.trim().includes('For women 18+') &&
          el.textContent.trim().includes('hair thinning');
      });
    }

    function createMobileHolder() {
      const mediaContainer = document.querySelector('.product-information__media-container');
      const productGrid = document.querySelector('.product-information__grid');

      if (!mediaContainer || !productGrid) return null;

      let holder = document.querySelector('.hs-mobile-product-eyebrow-holder');

      if (!holder) {
        holder = document.createElement('div');
        holder.className = 'hs-mobile-product-eyebrow-holder';
        productGrid.insertBefore(holder, mediaContainer);
      }

      return holder;
    }

    function moveEyebrowForMobile() {
      if (!eyebrowBlock) {
        eyebrowBlock = findEyebrowBlock();
        if (!eyebrowBlock) return;

        originalParent = eyebrowBlock.parentNode;
        originalNextSibling = eyebrowBlock.nextSibling;
      }

      mobileHolder = createMobileHolder();
      if (!mobileHolder) return;

      if (eyebrowBlock.parentNode !== mobileHolder) {
        mobileHolder.appendChild(eyebrowBlock);
      }
    }

    function restoreEyebrowForDesktop() {
      if (!eyebrowBlock || !originalParent) return;

      if (eyebrowBlock.parentNode !== originalParent) {
        originalParent.insertBefore(eyebrowBlock, originalNextSibling);
      }
    }

    function handleLayoutChange() {
      if (mobileQuery.matches) {
        moveEyebrowForMobile();
      } else {
        restoreEyebrowForDesktop();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', handleLayoutChange);
    } else {
      handleLayoutChange();
    }

    mobileQuery.addEventListener('change', handleLayoutChange);
  })();
</script>

<script>
  (function () {
    var mobileQuery = window.matchMedia('(max-width: 749px)');

    var titleSelector = '.hs-mobile-product-title';
    var supplySelector = 'rte-formatter.text-block--ANjBhM2RpS3RTdm9QM__text_Q6BCJN';

    var placeholder = null;
    var supplyBlock = null;
    var mobileTitle = null;

    function setupElements() {
      supplyBlock = document.querySelector(supplySelector);
      mobileTitle = document.querySelector(titleSelector);

      if (!supplyBlock || !mobileTitle) return false;

      if (!placeholder) {
        placeholder = document.createComment('Original position for mobile supply text');
        supplyBlock.parentNode.insertBefore(placeholder, supplyBlock);
      }

      return true;
    }

    function moveSupplyText() {
      if (!setupElements()) return;

      if (mobileQuery.matches) {
        if (mobileTitle.nextElementSibling !== supplyBlock) {
          mobileTitle.insertAdjacentElement('afterend', supplyBlock);
        }

        supplyBlock.classList.add('hs-mobile-supply-below-title');
      } else {
        if (placeholder && placeholder.parentNode) {
          placeholder.parentNode.insertBefore(supplyBlock, placeholder.nextSibling);
        }

        supplyBlock.classList.remove('hs-mobile-supply-below-title');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', moveSupplyText);
    } else {
      moveSupplyText();
    }

    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener('change', moveSupplyText);
    } else {
      mobileQuery.addListener(moveSupplyText);
    }

    document.addEventListener('shopify:section:load', function () {
      placeholder = null;
      moveSupplyText();
    });
  })();
</script>