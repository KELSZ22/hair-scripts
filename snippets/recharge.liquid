<style>
  @import url('https://fonts.googleapis.com/css2?family=Fustat:wght@400;600;700;800&display=swap');

  .rc-custom-widget {
    width: 140%;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: 'Fustat', sans-serif;
    box-sizing: border-box;
  }
  .rc-widget-header {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0 2px;
  }
  .rc-widget-title {
    font-size: 14px;
    font-weight: 700;
    color: #000000;
    font-family: 'Fustat', sans-serif;
    line-height: 1.2;
  }
  .rc-widget-desc {
    font-size: 12px;
    font-weight: 400;
    color: #237B84;
    font-family: 'Fustat', sans-serif;
    line-height: 1.4;
  }
  .rc-card {
    position: relative;
    border: 1.5px solid #ddd8d2;
    border-radius: 16px;
    background: transparent;
    padding: 18px 20px 20px;
    box-sizing: border-box;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .rc-card--selected {
    background: #dff0ec;
    border: 2px solid #3a8c7a;
    padding-top: 28px;
  }
  .rc-badge {
    position: absolute;
    top: -16px;
    left: 87%;
    transform: translateX(-50%);
    background: #b07040;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 22px;
    border-radius: 999px;
    line-height: 1;
    white-space: nowrap;
    font-family: 'Fustat', sans-serif;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }
  .rc-card__label {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    width: 100%;
  }
  .rc-card__selector {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }
  .rc-radio-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .rc-radio-dot {
    width: 20px;
    height: 20px;
    min-width: 20px;
    border-radius: 50%;
    border: 2px solid #bbb;
    background: #fff;
    box-sizing: border-box;
    margin-top: 3px;
    flex-shrink: 0;
    transition: border-color 0.15s, border-width 0.15s;
  }
  .rc-radio-dot--selected {
    border-color: #3a7f6e;
    border-width: 6px;
  }
  .rc-card__title-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .rc-card__title {
    font-size: 17px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.2;
    font-family: 'Fustat', sans-serif;
  }
  .rc-card__subtitle {
    font-size: 12.5px;
    color: #666;
    font-weight: 400;
    line-height: 1.3;
    font-family: 'Fustat', sans-serif;
  }
  .rc-card__prices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    flex-shrink: 0;
    text-align: right;
  }
  .rc-price-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 6px;
  }
  .rc-price--main {
    font-size: 22px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1;
    font-family: 'Fustat', sans-serif;
  }
  .rc-price--mo {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    font-family: 'Fustat', sans-serif;
  }
  .rc-price--original {
    font-size: 13px;
    color: #999;
    text-decoration: line-through;
    font-weight: 400;
    font-family: 'Fustat', sans-serif;
  }
  .rc-price-sub-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }
  .rc-price--per {
    font-size: 12px;
    color: #888;
    font-weight: 400;
    font-family: 'Fustat', sans-serif;
  }
  .rc-price--save {
    font-size: 12px;
    font-weight: 700;
    color: #c0392b;
    font-family: 'Fustat', sans-serif;
  }
  .rc-price--onetime {
    font-size: 22px;
    font-weight: 600;
  }
  .rc-price--per-right { text-align: right; }
  .rc-divider {
    height: 1px;
    background: rgba(0,0,0,0.09);
    margin: 16px 0;
  }
  .rc-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rc-benefits li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: #2a2a2a;
    line-height: 1.35;
    font-family: 'Fustat', sans-serif;
  }
  .rc-benefits li svg { flex-shrink: 0; color: #444; opacity: 0.75; }
  .rc-onetime-link-row {
    text-align: center;
    font-size: 13px;
    color: #555;
    margin: 4px 0 0;
    line-height: 1.5;
    font-family: 'Fustat', sans-serif;
  }
  .rc-onetime-link {
    color: #3a7f6e;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    font-family: 'Fustat', sans-serif;
  }
  .rc-status {
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    font-family: 'Fustat', sans-serif;
  }
  .rc-status--error { background:#fff0f0; color:#c0392b; border:1px solid #f5c6c6; }
  .rc-status--success { background:#f0faf6; color:#27ae60; border:1px solid #b2dfcc; }

  @media (max-width: 480px) {
    .rc-card { padding: 16px 14px 18px; border-radius: 14px; }
    .rc-card--selected { padding-top: 28px; }
    .rc-card__title { font-size: 15px; }
    .rc-card__subtitle { font-size: 11.5px; }
    .rc-price--main { font-size: 18px; }
    .rc-price--mo { font-size: 12px; }
    .rc-price--original { font-size: 11.5px; }
    .rc-price--per, .rc-price--save { font-size: 11px; }
    .rc-badge { font-size: 10px; padding: 6px 16px; top: -14px; }
    .rc-benefits li { font-size: 12.5px; gap: 8px; }
    .rc-benefits li svg { width: 16px; height: 16px; }
    .rc-card__label { gap: 8px; }
    .rc-price-sub-row { gap: 5px; flex-wrap: wrap; justify-content: flex-end; }
    .rc-widget-title { font-size: 16px; }
    .rc-widget-desc { font-size: 12px; }
  }
  @media (min-width: 600px) {
    .rc-card { padding: 20px 24px 22px; }
    .rc-card--selected { padding-top: 32px; }
    .rc-card__title { font-size: 18px; }
    .rc-price--main { font-size: 24px; }
    .rc-badge { font-size: 12px; padding: 8px 24px; top: -17px; }
    .rc-benefits li { font-size: 14px; }
    .rc-widget-title { font-size: 14px; }
    .rc-widget-desc { font-size: 12px; }
  }
  @media screen and (max-width: 768px) {
    .rc-custom-widget {
    width: 100%;
    }
}

</style>

<script>
(function() {
  function init() {
    var widget = document.getElementById('rc-custom-widget-{{ rc_product.id }}');
    if (!widget) return;

    var subCard  = widget.querySelector('#rc-subscription-card');
    var oneCard  = widget.querySelector('#rc-onetime-card');
    var subDot   = subCard.querySelector('.rc-radio-dot');
    var oneDot   = oneCard.querySelector('.rc-radio-dot');
    var oneLink  = widget.querySelector('#rc-onetime-trigger');
    var statusEl = widget.querySelector('#rc-status');

    var PLANS = {
      sub90: '2117107817',
      sub30: '1968406633',
      onetime: ''
    };

    var currentPlanId = PLANS.sub90;

    var formId = '{{ product_form_id }}';
    var productForm = document.getElementById(formId);

    if (!productForm) {
      productForm = document.querySelector('form[data-type="add-to-cart-form"]');
    }

    if (!productForm) {
      console.warn('RC Widget: product form not found with id:', formId);
      return;
    }

    var sellingPlanInput = productForm.querySelector('input[name="selling_plan"]');
    if (!sellingPlanInput) {
      sellingPlanInput = document.createElement('input');
      sellingPlanInput.type = 'hidden';
      sellingPlanInput.name = 'selling_plan';
      productForm.appendChild(sellingPlanInput);
    }

    function showStatus(type, message) {
      if (!statusEl) return;

      statusEl.style.display = 'block';
      statusEl.classList.remove('rc-status--error', 'rc-status--success');

      if (type === 'error') {
        statusEl.classList.add('rc-status--error');
      }

      if (type === 'success') {
        statusEl.classList.add('rc-status--success');
      }

      statusEl.textContent = message;
    }

    function updateATCPrice(priceText) {
      var priceEl = document.querySelector('.add-to-cart-text__price');
      if (priceEl) priceEl.textContent = priceText;

      var priceBlock = document.querySelector('.price__current, .price-item--regular, [data-price]');
      if (priceBlock) priceBlock.textContent = priceText;
    }

    function syncSellingPlanInput() {
      if (currentPlanId) {
        sellingPlanInput.disabled = false;
        sellingPlanInput.value = currentPlanId;
      } else {
        sellingPlanInput.value = '';
        sellingPlanInput.disabled = true;
      }
    }

    function setSellingPlan(planId, priceText) {
      currentPlanId = planId;
      syncSellingPlanInput();

      if (priceText) {
        updateATCPrice(priceText);
      }
    }

    function activateSubscription90() {
      subCard.classList.add('rc-card--selected');
      oneCard.classList.remove('rc-card--selected');

      subDot.classList.add('rc-radio-dot--selected');
      oneDot.classList.remove('rc-radio-dot--selected');

      subCard.querySelector('input').checked = true;

      setSellingPlan(PLANS.sub90, '$45.00');
    }

    function activateSubscription30() {
      oneCard.classList.add('rc-card--selected');
      subCard.classList.remove('rc-card--selected');

      oneDot.classList.add('rc-radio-dot--selected');
      subDot.classList.remove('rc-radio-dot--selected');

      oneCard.querySelector('input').checked = true;

      setSellingPlan(PLANS.sub30, '$49.00');
    }

    function activateOnetime() {
      subCard.classList.remove('rc-card--selected');
      oneCard.classList.remove('rc-card--selected');

      subDot.classList.remove('rc-radio-dot--selected');
      oneDot.classList.remove('rc-radio-dot--selected');

      oneCard.querySelector('input').checked = true;

      setSellingPlan(PLANS.onetime, '$69.00');
    }

    function submitProductForm() {
      syncSellingPlanInput();

      var submitButton = productForm.querySelector(
        'button[name="add"], button[type="submit"], input[type="submit"], .product-form__submit, .add-to-cart-button'
      );

      if (submitButton && submitButton.disabled) {
        showStatus('error', 'This product is not available right now.');
        return;
      }

      showStatus('success', 'Adding one-time purchase to cart...');

      if (submitButton && typeof submitButton.click === 'function') {
        submitButton.click();
        return;
      }

      if (typeof productForm.requestSubmit === 'function') {
        productForm.requestSubmit();
        return;
      }

      var submitEvent = new Event('submit', {
        bubbles: true,
        cancelable: true
      });

      productForm.dispatchEvent(submitEvent);
    }

    subCard.addEventListener('click', activateSubscription90);
    oneCard.addEventListener('click', activateSubscription30);

    if (oneLink) {
      oneLink.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        activateOnetime();

        setTimeout(function() {
          submitProductForm();
        }, 50);
      });
    }

    productForm.addEventListener('submit', function() {
      syncSellingPlanInput();
    }, true);

    var productFormComponent = productForm.closest('product-form-component');
    if (productFormComponent) {
      productFormComponent.addEventListener('submit', function() {
        syncSellingPlanInput();
      }, true);
    }

    var observer = new MutationObserver(function() {
      var existing = productForm.querySelector('input[name="selling_plan"]');

      if (!existing) {
        productForm.appendChild(sellingPlanInput);
      }

      syncSellingPlanInput();
    });

    observer.observe(productForm, {
      childList: true,
      subtree: true
    });

    setSellingPlan(PLANS.sub90, '$45.00');

    console.log('RC Widget initialized. Form:', formId, '| selling_plan input:', sellingPlanInput);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>