    };

    var ITEM_DATA = {
      sub90:   { title: 'HairScripts by Bevy Supplement - 90 Days', variant: '90-day subscription', price: '$135.00', compareAt: '$207.00', save: 'SAVE 34%', href: '/products/hairscripts-by-bevy-supplement-90-days?selling_plan=2124218473&variant=43232223789161' },
      sub30:   { title: 'HairScripts by Bevy Supplement',           variant: '30-day subscription', price: '$49.00',  compareAt: '',        save: '',         href: '/products/hairscripts-by-bevy-supplement?selling_plan=2124185705&variant=43232206454889' },
      onetime: { title: 'HairScripts by Bevy Supplement',           variant: '30-Day Supply',       price: '$69.00',  compareAt: '',        save: '',         href: '/products/hairscripts-by-bevy-supplement?variant=43231934775401' }
    };

    var IMG_SRC = '//bevyscripts.com/cdn/shop/files/2_9ca31d72-534f-49c8-891a-640bc47b1731.png?v=1778765354&width=250';
    var currentMode = 'sub90';
    var isAdding    = false;
    var guardObs    = null;
    var savedWrapperContent = null;

    /* ── STATUS ── */
    function showStatus(type, msg) {
      if (!statusEl) return;
      statusEl.style.display = 'block';
      statusEl.classList.remove('rc-status--error','rc-status--success');
      statusEl.classList.add(type === 'error' ? 'rc-status--error' : 'rc-status--success');
      statusEl.textContent = msg;
    }
    function hideStatus() {
      if (!statusEl) return;
      statusEl.style.display = 'none';
      statusEl.textContent = '';
    }

    function updateATCPrice(p) {
      ['.add-to-cart-text__price','.price__current','.price-item--regular',
       '.price-item--sale','[data-price]','.product__price .price',
       '.product-price','price-component','.price .price-item'].forEach(function(sel){
        document.querySelectorAll(sel).forEach(function(el){ el.textContent = p; });
      });
    }

    function getCurrentCount() {
      var el = document.querySelector('.js-cart-drawer-count');
      return el ? (parseInt(el.textContent.trim(),10)||0) : 0;
    }
    function setCartDrawerCount(n) {
      document.querySelectorAll(
        '.js-cart-drawer-count,[data-cart-count],.cart-count-bubble span,' +
        '.cart-count,#cart-icon-bubble span,.cart-count-bubble'
      ).forEach(function(el){ el.textContent = n; });
    }

    function getCartWrapper() {
      /* The element that holds either the empty state OR the cart-form */
      return document.querySelector('cart-items-component .cart-items__wrapper')
          || document.querySelector('.cart-items__wrapper');
    }

    function buildFakeCartHTML(data) {
      var compareHTML = '';
      if (data.compareAt) {
        compareHTML =
          '<span class="visually-hidden">Regular price</span>' +
          '<s class="compare-at-price">' + data.compareAt + '</s>' +
          (data.save ? '<span class="cart-items__save-badge">' + data.save + '</span>' : '');
      }

      return [
        '<span class="visually-hidden" ref="cartItemCount" aria-hidden="true">1</span>',
        '<form action="/cart" class="cart-form" id="cart-form-ghost" method="post">',
          '<div class="cart-items spacing-style" style="--cart-items-gap:px;">',
            '<table class="cart-items__table" role="table">',
              '<caption class="visually-hidden" role="caption">',
                'Cart total <span>' + data.price + ' USD</span>',
              '</caption>',
              '<thead class="visually-hidden" role="rowgroup">',
                '<tr role="row" class="cart-items__table-row">',
                  '<th id="productImage" scope="col" role="columnheader">Product image</th>',
                  '<th id="productInformation" scope="col" role="columnheader">Product information</th>',
                  '<th id="quantity" scope="col" role="columnheader">Quantity</th>',
                  '<th id="productTotal" scope="col" role="columnheader">Product total</th>',
                '</tr>',
              '</thead>',
              '<tbody role="rowgroup">',
                '<tr role="row" class="cart-items__table-row cart-items__table-row--full-width-variants" data-rc-ghost="1">',
                  '<td class="cart-items__media" role="cell" headers="productImage">',
                    '<a href="' + data.href + '" class="cart-items__media-container" style="--ratio:1;">',
                      '<img src="' + IMG_SRC + '" alt="" width="250" height="250"' +
                      ' class="cart-items__media-image border-style"' +
                      ' style="--border-width:1px;--border-style:none;--border-color:rgba(0,0,0,0.5);--border-radius:0px;">',
                    '</a>',
                  '</td>',
                  '<td class="cart-items__details cart-primary-typography" role="cell" headers="productInformation">',
                    '<div class="cart-items__product-info">',
                      '<p><a href="' + data.href + '" class="cart-items__title">' + data.title + '</a></p>',
                    '</div>',
                    '<div class="cart-items__variants-wrapper"><p>' + data.variant + '</p></div>',
                    '<div class="cart-items__unit-price-wrapper">',
                      '<div>',
                        '<span class="visually-hidden">Sale price</span>',
                        '<span>' + data.price + '</span>',
                        compareHTML,
                      '</div>',
                    '</div>',
                  '</td>',
                  '<td class="cart-items__quantity" role="cell" headers="quantity">',
                    '<div class="cart-items__quantity-controls">',
                      '<div class="quantity-selector-wrapper">',
                        '<div class="quantity-selector cart-primary-typography" style="display:flex;align-items:center;gap:8px;">',
                          '<button class="button quantity-minus button-unstyled" type="button" disabled>−</button>',
                          '<input type="number" value="1" min="1" aria-label="Quantity" style="width:36px;text-align:center;" readonly>',
                          '<button class="button quantity-plus button-unstyled" type="button">+</button>',
                        '</div>',
                      '</div>',
                    '</div>',
                  '</td>',
                  '<td class="cart-items__price cart-secondary-typography" role="cell" headers="productTotal">',
                    '<text-component value="' + data.price + '">' + data.price + '</text-component>',
                  '</td>',
                '</tr>',
              '</tbody>',
            '</table>',
          '</div>',
        '</form>'
      ].join('');
    }


    function injectGhost() {
      var wrapper = getCartWrapper();
      if (!wrapper) return;

      savedWrapperContent = wrapper.innerHTML;

      wrapper.innerHTML = buildFakeCartHTML(ITEM_DATA[currentMode]);

      var finalEl = document.querySelector('.cart-drawer__totals-final');
      if (finalEl) finalEl.textContent = ITEM_DATA[currentMode].price;


      document.querySelectorAll('.js-cart-drawer-empty').forEach(function(el){
        el.setAttribute('hidden','');
        el.style.setProperty('display','none','important');
      });
      document.querySelectorAll('.js-cart-drawer-filled').forEach(function(el){
        el.removeAttribute('hidden');
        el.style.removeProperty('display');
      });
    }

    function startGuard() {
      stopGuard();
      var target = document.querySelector('cart-items-component') || document.body;
      guardObs = new MutationObserver(function(mutations) {
        if (!isAdding) return;
        mutations.forEach(function(m) {
          m.addedNodes.forEach(function(node) {
            if (node.nodeType !== 1) return;
            if (node.classList && (
                node.classList.contains('cart-items__empty-button') ||
                node.classList.contains('cart-items__wrapper')
            )) {
              var wrapper = getCartWrapper();
              if (wrapper && !wrapper.querySelector('[data-rc-ghost]')) {
                wrapper.innerHTML = buildFakeCartHTML(ITEM_DATA[currentMode]);
              }
            }
          });

          if (m.type === 'attributes' && m.attributeName === 'hidden') {
            var t = m.target;
            if (t.classList && t.classList.contains('js-cart-drawer-empty')) {
              t.setAttribute('hidden','');
              t.style.setProperty('display','none','important');
            }
            if (t.classList && t.classList.contains('js-cart-drawer-filled')) {
              t.removeAttribute('hidden');
            }
          }
        });
      });
      guardObs.observe(target, {
        childList: true, subtree: true,
        attributes: true, attributeFilter: ['hidden']
      });
    }

    function stopGuard() {
      if (guardObs) { guardObs.disconnect(); guardObs = null; }
    }

    function openCartDrawer() {
      var cdc = document.querySelector('cart-drawer-component');
      if (!cdc) return;
      if (typeof cdc.open === 'function') {
        cdc.open();
      } else {
        cdc.removeAttribute('hidden');
        cdc.setAttribute('open','');
        cdc.classList.add('is-open','active');
      }
      document.dispatchEvent(new CustomEvent('cart:open',{bubbles:true}));
    }

    function refreshCartFromServer() {
      var cic = document.querySelector('cart-items-component[data-drawer]');
      var sid = cic
        ? cic.getAttribute('data-section-id')
        : 'sections--19054444937321__header_section';

      fetch('/?sections=' + sid)
        .then(function(r){ return r.json(); })
        .then(function(data){
          var html = data[sid] || data[Object.keys(data)[0]];
          if (!html) return;
          var doc   = new DOMParser().parseFromString(html,'text/html');
          var fresh = doc.querySelector('cart-items-component[data-drawer]');
          var live  = document.querySelector('cart-items-component[data-drawer]');
          if (fresh && live) {
            stopGuard();
            isAdding = false;
            live.innerHTML = fresh.innerHTML;
          }
        })
        .catch(function(){
          stopGuard();
          isAdding = false;
        })
        .finally(function(){
          fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
            setCartDrawerCount(cart.item_count);
            document.dispatchEvent(new CustomEvent('cart:update',{
              bubbles:true,
              detail:{ data:{ itemCount:cart.item_count, source:'product-form-component' } }
            }));
            import('@theme/events').then(function(m){
              document.dispatchEvent(new m.CartUpdateEvent(cart,'manual-trigger',{
                itemCount:cart.item_count, source:'rc-widget', sections:{}
              }));
            }).catch(function(){});
          });
        });
    }

    function addToCartDirect(variantId, sellingPlanId, quantity) {
      if (isAdding) return;
      isAdding = true;

      showStatus('success','Adding to cart...');
      setCartDrawerCount(getCurrentCount() + (quantity||1));

      injectGhost();

      startGuard();

      openCartDrawer();

      var item = { id: variantId, quantity: quantity||1 };
      if (sellingPlanId) item.selling_plan = sellingPlanId;

      fetch('/cart/add.js', {
        method: 'POST',
        headers:{ 'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest' },
        body: JSON.stringify({ items:[item] })
      })
      .then(function(res){
        if (!res.ok) return res.json().then(function(d){ throw new Error(d.description||d.message||'Could not add to cart.'); });
        return res.json();
      })
      .then(function(){
        showStatus('success','Added to cart!');
        refreshCartFromServer();
        setTimeout(function(){ hideStatus(); },3000);
      })
      .catch(function(err){
        stopGuard();
        isAdding = false;
        var wrapper = getCartWrapper();
        if (wrapper && savedWrapperContent !== null) {
          wrapper.innerHTML = savedWrapperContent;
        }
        setCartDrawerCount(Math.max(0, getCurrentCount()-(quantity||1)));
        showStatus('error', err.message||'Error adding to cart. Please try again.');
      });
    }

    function handleAddToCart() {
      var p = PRODUCTS[currentMode];
      addToCartDirect(p.variantId, p.planId, p.qty);
    }

    function activateSubscription90() {
      currentMode = 'sub90';
      subCard.classList.add('rc-card--selected');     oneCard.classList.remove('rc-card--selected');
      subDot.classList.add('rc-radio-dot--selected'); oneDot.classList.remove('rc-radio-dot--selected');
      subCard.querySelector('input').checked = true;
      updateATCPrice('$135'); hideStatus();
    }
    function activateSubscription30() {
      currentMode = 'sub30';
      oneCard.classList.add('rc-card--selected');     subCard.classList.remove('rc-card--selected');
      oneDot.classList.add('rc-radio-dot--selected'); subDot.classList.remove('rc-radio-dot--selected');
      oneCard.querySelector('input').checked = true;
      updateATCPrice('$49'); hideStatus();
    }
    function activateOnetime() {
      currentMode = 'onetime';
      subCard.classList.remove('rc-card--selected');  oneCard.classList.remove('rc-card--selected');
      subDot.classList.remove('rc-radio-dot--selected'); oneDot.classList.remove('rc-radio-dot--selected');
      oneCard.querySelector('input').checked = true;
      updateATCPrice('$69.00'); hideStatus();
    }

    subCard.addEventListener('click', activateSubscription90);
    oneCard.addEventListener('click', activateSubscription30);

    if (oneLink) {
      oneLink.addEventListener('click', function(e){
        e.preventDefault(); e.stopPropagation();
        activateOnetime();
        setTimeout(function(){
          var p = PRODUCTS.onetime;
          addToCartDirect(p.variantId, p.planId, p.qty);
        },50);
      });
    }

    var formId = '{{ product_form_id }}';
    var productForm = document.getElementById(formId);
    if (!productForm) productForm = document.querySelector('form[data-type="add-to-cart-form"]');
    if (productForm) {
      var addBtn = productForm.querySelector('button[name="add"],button[type="submit"],.product-form__submit,.add-to-cart-button');
      if (addBtn) {
        addBtn.addEventListener('click', function(e){
          e.preventDefault(); e.stopPropagation();
          handleAddToCart();
        });
      }
    }

    updateATCPrice('$135');
    setTimeout(function(){ updateATCPrice('$135'); },300);
    setTimeout(function(){ updateATCPrice('$135'); },1000);

    console.log('RC Widget initialized.');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>