{% liquid
  assign sticky_product = product
  assign sticky_current_variant = current_variant | default: sticky_product.selected_or_first_available_variant
  assign sticky_initial_quantity = initial_quantity

  if sticky_initial_quantity == blank
    assign sticky_initial_quantity = sticky_current_variant.quantity_rule.min | default: 1
  endif

  assign sticky_color_scheme = color_scheme | default: settings.popover_color_scheme
  assign sticky_id = 'hs-sticky-atc-' | append: section.id | append: '-' | append: sticky_product.id
  assign image_to_show = sticky_current_variant.featured_image | default: sticky_product.featured_image
%}

{% if sticky_product != blank and sticky_current_variant != blank %}
  <sticky-add-to-cart
    id="{{ sticky_id }}"
    class="sticky-add-to-cart hs-sticky-atc"
    data-below-fold="false"
    data-at-page-bottom="false"
    data-variant-available="{{ sticky_current_variant.available }}"
    data-product-id="{{ sticky_product.id }}"
    data-current-variant-id="{{ sticky_current_variant.id }}"
    data-initial-quantity="{{ sticky_initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar hs-sticky-atc__bar color-{{ sticky_color_scheme }}"
      data-stuck="true"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      <div class="hs-sticky-atc__left">
        {% if image_to_show %}
          <div class="sticky-add-to-cart__image hs-sticky-atc__image">
            {% assign image_alt = image_to_show.alt | default: sticky_product.title | escape %}
            {{
              image_to_show
              | image_url: width: 180
              | image_tag:
                loading: 'lazy',
                alt: image_alt,
                class: 'sticky-add-to-cart__image-img hs-sticky-atc__image-img',
                data-testid: 'sticky-product-image',
                srcset: null,
                sizes: null,
                ref: 'productImage'
            }}
          </div>
        {% endif %}

        <div class="sticky-add-to-cart__info hs-sticky-atc__info">
          <p class="hs-sticky-atc__purchase-label">
            One-time Purchase
          </p>

          <p
            class="sticky-add-to-cart__title hs-sticky-atc__title"
            data-testid="sticky-product-title"
          >
            {{ sticky_product.title | escape }}
          </p>

          <div class="hs-sticky-atc__selectors">
            <div class="hs-sticky-atc__purchase-dropdown" data-sticky-purchase-dropdown>
              <button
                type="button"
                class="hs-sticky-atc__dropdown-toggle"
                aria-label="Purchase option"
                aria-haspopup="listbox"
                aria-expanded="false"
                data-sticky-purchase-toggle
              >
                <span data-sticky-purchase-current-label>90-day Subscription</span>
                <span class="hs-sticky-atc__save" data-sticky-purchase-current-save>(Save 34%)</span>
                <span class="hs-sticky-atc__chevron" aria-hidden="true"></span>
              </button>

              <div
                class="hs-sticky-atc__dropdown-menu"
                role="listbox"
                aria-label="Purchase option"
                data-sticky-purchase-menu
                hidden
              >
                <button
                  type="button"
                  class="hs-sticky-atc__dropdown-option is-selected"
                  role="option"
                  aria-selected="true"
                  data-sticky-plan-option="sub90"
                >
                  <span>90-day Subscription</span>
                  <span class="hs-sticky-atc__save">(Save 34%)</span>
                </button>

                <button
                  type="button"
                  class="hs-sticky-atc__dropdown-option"
                  role="option"
                  aria-selected="false"
                  data-sticky-plan-option="sub30"
                >
                  <span>30-day Subscription</span>
                  <span class="hs-sticky-atc__save">(Save 28%)</span>
                </button>
              </div>

              <select
                class="hs-sticky-atc__native-select"
                aria-hidden="true"
                tabindex="-1"
                data-sticky-selling-plan-select
              >
                <option value="sub90" selected>90-day Subscription (Save 34%)</option>
                <option value="sub30">30-day Subscription (Save 28%)</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="hs-sticky-atc__right">
        <div class="hs-sticky-atc__qty" aria-label="Quantity selector">
          <button
            type="button"
            class="hs-sticky-atc__qty-btn"
            aria-label="Decrease quantity"
            data-sticky-qty-minus
          >
            −
          </button>

          <span class="hs-sticky-atc__qty-number" aria-live="polite">
            <span data-sticky-qty-number>{{ sticky_initial_quantity }}</span>
          </span>

          <button
            type="button"
            class="hs-sticky-atc__qty-btn"
            aria-label="Increase quantity"
            data-sticky-qty-plus
          >
            +
          </button>
        </div>

        {% comment %}
          ORIGINAL STICKY ADD TO CART BUTTON - TEMPORARILY DISABLED

        <button
          type="button"
          class="sticky-add-to-cart__button add-to-cart-button button hs-sticky-atc__button"
          ref="addToCartButton"
          data-sticky-atc-btn
          {% unless sticky_current_variant.available %}
            disabled
          {% endunless %}
        >
          <span class="add-to-cart-text">
            <span class="add-to-cart-text__content">
              <span class="hs-sticky-atc__button-inner">
                <span data-sticky-button-label>
                  {%- if sticky_current_variant.available -%}
                    {{- 'products.product.add_to_cart' | t -}}
                  {%- elsif sticky_current_variant == blank -%}
                    {{- 'products.product.unavailable' | t -}}
                  {%- else -%}
                    {{- 'products.product.sold_out' | t -}}
                  {%- endif -%}
                </span>

                <span class="hs-sticky-atc__button-divider"></span>

                <span
                  class="hs-sticky-atc__button-price"
                  data-sticky-price
                >
                  {{ sticky_current_variant.price | money }}
                </span>
              </span>

              <span
                class="hs-sticky-atc__theme-qty-ref"
                ref="quantityDisplay"
                aria-hidden="true"
                style="display: none;"
              >
                <span ref="quantityNumber" data-sticky-theme-qty-number>{{ sticky_initial_quantity }}</span>
              </span>
            </span>
          </span>

          <span class="add-to-cart__added">
            <span class="svg-wrapper add-to-cart__added-icon">
              {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
            </span>
          </span>
        </button>
        {% endcomment %}

        <button
          type="button"
          class="sticky-add-to-cart__button add-to-cart-button button hs-sticky-atc__button hs-sticky-atc__sold-out-button"
          disabled
          aria-disabled="true"
        >
          <span class="add-to-cart-text">
            <span class="add-to-cart-text__content">
              <span class="hs-sticky-atc__button-inner">
                <span>Sold out</span>
              </span>
            </span>
          </span>
        </button>
      </div>
    </div>
  </sticky-add-to-cart>

  <style>
    #{{ sticky_id }} {
      --hs-atc-purple: #56304f;
      --hs-atc-purple-dark: #3b1738;
      --hs-atc-text: #1f1a1c;
      --hs-atc-border: #d8d8d8;
      --hs-atc-shadow: 0 -10px 35px rgba(0, 0, 0, 0.14);
      --hs-atc-body-font: "DM Sans", sans-serif;
    }

    #{{ sticky_id }} .hs-sticky-atc__bar {
      position: fixed;
      bottom: 0;
      left: 50%;
      z-index: calc(var(--layer-sticky, 1000) - 1);
      width: 100vw;
      min-height: 118px;
      padding: 15px 60px;
      background: #ffffff;
      color: var(--hs-atc-text);
      box-shadow: var(--hs-atc-shadow);
      border-radius: 0;
      font-family: var(--hs-atc-body-font);
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none;
      transform: translateX(-50%) translateY(110%) !important;
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
    }

    #{{ sticky_id }}[data-below-fold='true'] .hs-sticky-atc__bar {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0) !important;
      display: none !important;
    }

    #{{ sticky_id }}[data-at-page-bottom='true'] .hs-sticky-atc__bar {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      transform: translateX(-50%) translateY(110%) !important;
    }

    #{{ sticky_id }} .hs-sticky-atc__bar::before {
      display: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      #{{ sticky_id }} .hs-sticky-atc__bar {
        transition-property: transform, opacity, visibility;
        transition-duration: 0.3s;
        transition-timing-function: var(--ease-out-quad, ease);
      }
    }

    #{{ sticky_id }} .hs-sticky-atc__left {
      display: flex;
      align-items: center;
      gap: 18px;
      min-width: 0;
      flex: 1;
    }

    #{{ sticky_id }} .hs-sticky-atc__image {
      width: 92px;
      height: 72px;
      aspect-ratio: auto;
      flex-shrink: 0;
      border-radius: 0;
      overflow: hidden;
      background: #f3f0ec;
    }

    #{{ sticky_id }} .hs-sticky-atc__image-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #{{ sticky_id }} .hs-sticky-atc__info {
      min-width: 0;
      flex: 1;
      font-family: var(--hs-atc-body-font);
    }

    #{{ sticky_id }} .hs-sticky-atc__purchase-label {
      display: none;
      margin: 0;
      color: rgba(42, 42, 42, 0.62);
      font-family: var(--hs-atc-body-font);
      font-size: 12px;
      font-style: normal;
      font-weight: 400;
      line-height: 1.2;
    }

    #{{ sticky_id }} .hs-sticky-atc__title {
      margin: 0 0 8px;
      color: var(--Old-colors-Scheme-1-Text-Dark, #211B18);
      font-family: "Cormorant Garamond", serif;
      font-size: 18px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      text-transform: uppercase;
      letter-spacing: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #{{ sticky_id }} .hs-sticky-atc__selectors {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 8px;
      flex-wrap: wrap;
      font-family: var(--hs-atc-body-font);
    }

    #{{ sticky_id }} .hs-sticky-atc__select {
      width: 165px;
      max-width: 100%;
      height: 31px;
      padding: 0 34px 0 8px;
      border: 1px solid var(--hs-atc-border);
      border-radius: 2px;
      background-color: #ffffff;
      color: #222222;
      font-family: var(--hs-atc-body-font);
      font-size: 14px;
      line-height: 1;
      font-weight: 400;
      box-shadow: none;
      outline: none;
    }

    #{{ sticky_id }} .hs-sticky-atc__select--purchase {
      width: auto;
    }

    #{{ sticky_id }} .hs-sticky-atc__purchase-dropdown {
      position: relative;
      display: inline-block;
      max-width: 100%;
      font-family: var(--hs-atc-body-font);
    }

    #{{ sticky_id }} .hs-sticky-atc__native-select {
      display: none !important;
    }

    #{{ sticky_id }} .hs-sticky-atc__dropdown-toggle {
      width: 268px;
      max-width: 100%;
      height: 38px;
      padding: 0 12px;
      border: 1px solid var(--hs-atc-border);
      border-radius: 3px;
      background: #ffffff;
      color: #222222;
      font-family: var(--hs-atc-body-font);
      font-size: 13px;
      font-weight: 400;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      white-space: nowrap;
    }

    #{{ sticky_id }} .hs-sticky-atc__save {
      color: #d40000;
      font-weight: 500;
    }

    #{{ sticky_id }} .hs-sticky-atc__chevron {
      width: 7px;
      height: 7px;
      margin-left: auto;
      border-right: 1px solid #222222;
      border-bottom: 1px solid #222222;
      transform: rotate(45deg) translateY(-2px);
      transition: transform 0.2s ease;
      flex-shrink: 0;
    }

    #{{ sticky_id }} .hs-sticky-atc__dropdown-toggle[aria-expanded='true'] .hs-sticky-atc__chevron {
      transform: rotate(225deg) translateY(-2px);
    }

    #{{ sticky_id }} .hs-sticky-atc__dropdown-menu {
      position: absolute;
      bottom: calc(100% + 6px);
      left: 0;
      z-index: 20;
      width: 268px;
      max-width: calc(100vw - 32px);
      padding: 5px;
      border: 1px solid var(--hs-atc-border);
      border-radius: 3px;
      background: #ffffff;
      box-shadow: 0 -8px 20px rgba(0, 0, 0, 0.13);
    }

    #{{ sticky_id }} .hs-sticky-atc__dropdown-menu[hidden] {
      display: none !important;
    }

    #{{ sticky_id }} .hs-sticky-atc__dropdown-option {
      width: 100%;
      min-height: 38px;
      padding: 0 8px;
      border: 0;
      background: transparent;
      color: #222222;
      font-family: var(--hs-atc-body-font);
      font-size: 13px;
      font-weight: 400;
      line-height: 1;
      display: flex;
      align-items: center;
      gap: 4px;
      text-align: left;
      cursor: pointer;
    }

    #{{ sticky_id }} .hs-sticky-atc__dropdown-option:hover,
    #{{ sticky_id }} .hs-sticky-atc__dropdown-option:focus-visible,
    #{{ sticky_id }} .hs-sticky-atc__dropdown-option.is-selected {
      background: #f6f1f4;
      outline: none;
    }

    #{{ sticky_id }} .hs-sticky-atc__right {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      font-family: var(--hs-atc-body-font);
    }

    #{{ sticky_id }} .hs-sticky-atc__qty {
      height: 56px;
      min-width: 122px;
      padding: 0 14px;
      border: 1px solid #d5d5d5;
      border-radius: 999px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      color: #111111;
      font-family: var(--hs-atc-body-font);
    }

    #{{ sticky_id }} .hs-sticky-atc__qty-btn {
      appearance: none;
      border: 0;
      background: transparent;
      color: #111111;
      font-family: var(--hs-atc-body-font);
      font-size: 24px;
      line-height: 1;
      font-weight: 400;
      width: 18px;
      height: 30px;
      padding: 0;
      cursor: pointer;
      display: grid;
      place-items: center;
    }

    #{{ sticky_id }} .hs-sticky-atc__qty-number {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      min-width: 16px;
      height: 30px;
      text-align: center;
      color: #111111 !important;
      font-family: var(--hs-atc-body-font);
      font-size: 14px;
      font-style: normal;
      font-weight: 400;
      line-height: 1;
      visibility: visible !important;
      opacity: 1 !important;
    }

    #{{ sticky_id }} .hs-sticky-atc__theme-qty-ref {
      display: none !important;
    }

    #{{ sticky_id }} .hs-sticky-atc__button {
      min-width: 178px;
      height: 56px;
      border-radius: 999px;
      border: 0;
      background: linear-gradient(90deg, var(--hs-atc-purple), var(--hs-atc-purple-dark));
      color: #ffffff;
      font-family: var(--hs-atc-body-font);
      font-size: 16px;
      font-style: normal;
      font-weight: 500;
      line-height: 1;
      padding: 0 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: none;
      position: relative;
    }

    #{{ sticky_id }} .hs-sticky-atc__button::before,
    #{{ sticky_id }} .hs-sticky-atc__button::after {
      display: none;
    }

    #{{ sticky_id }} .hs-sticky-atc__button .add-to-cart-icon {
      display: none;
    }

    #{{ sticky_id }} .hs-sticky-atc__button[disabled] {
      opacity: 0.55;
      cursor: not-allowed;
    }

    #{{ sticky_id }} .hs-sticky-atc__sold-out-button,
    #{{ sticky_id }} .hs-sticky-atc__sold-out-button:hover,
    #{{ sticky_id }} .hs-sticky-atc__sold-out-button:focus,
    #{{ sticky_id }} .hs-sticky-atc__sold-out-button:disabled {
      background: linear-gradient(90deg, #725270 0% 42.83%, #371834) !important;
      color: #ffffff !important;
      border-color: transparent !important;
      opacity: 0.5 !important;
      cursor: not-allowed !important;
      pointer-events: auto !important;
    }

    #{{ sticky_id }} .hs-sticky-atc__sold-out-button .add-to-cart-text,
    #{{ sticky_id }} .hs-sticky-atc__sold-out-button .add-to-cart-text__content,
    #{{ sticky_id }} .hs-sticky-atc__sold-out-button .hs-sticky-atc__button-inner,
    #{{ sticky_id }} .hs-sticky-atc__sold-out-button .hs-sticky-atc__button-inner span {
      color: #ffffff !important;
    }

    #{{ sticky_id }} .hs-sticky-atc__button-inner {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
    }

    #{{ sticky_id }} .hs-sticky-atc__button-divider::before {
      content: " - ";
    }

    #{{ sticky_id }} .hs-sticky-atc__button *,
    #{{ sticky_id }} .hs-sticky-atc__select *,
    #{{ sticky_id }} .hs-sticky-atc__qty * {
      font-family: var(--hs-atc-body-font);
    }

    @media screen and (max-width: 989px) {
      #{{ sticky_id }} .hs-sticky-atc__bar {
        padding: 18px 24px;
        gap: 18px;
      }

      #{{ sticky_id }} .hs-sticky-atc__right {
        gap: 8px;
      }

      #{{ sticky_id }} .hs-sticky-atc__button {
        min-width: 150px;
        font-size: 16px;
        padding-inline: 22px;
      }
    }

    @media screen and (max-width: 768px) {
      #{{ sticky_id }} .hs-sticky-atc__bar {
        bottom: 0;
        left: 50%;
        width: 100vw;
        max-width: none;
        min-height: auto;
        padding: 16px;
        border-top: 0;
        background: #ffffff;
        box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.18);
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        gap: 12px;
        border-radius: 0;
      }

      #{{ sticky_id }} .hs-sticky-atc__left {
        display: block;
        width: 100%;
        min-width: 0;
        flex: none;
      }

      #{{ sticky_id }} .hs-sticky-atc__image {
        display: none;
      }

      #{{ sticky_id }} .hs-sticky-atc__info {
        width: 100%;
      }

      #{{ sticky_id }} .hs-sticky-atc__purchase-label {
        display: none;
      }

      #{{ sticky_id }} .hs-sticky-atc__title {
        margin: 0 0 8px;
        color: var(--Old-colors-Scheme-1-Text-Dark, #211B18);
        font-family: "Cormorant Garamond", serif;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 1.15;
        text-transform: uppercase;
        letter-spacing: 0;
        white-space: normal;
        overflow: visible;
        text-overflow: initial;
        display: block;
      }

      #{{ sticky_id }} .hs-sticky-atc__selectors {
        gap: 0;
        margin-bottom: 0;
        flex-wrap: nowrap;
      }

      #{{ sticky_id }} .hs-sticky-atc__select,
      #{{ sticky_id }} .hs-sticky-atc__select--purchase {
        width: 200px;
        max-width: 100%;
        height: 38px;
        padding: 0 34px 0 8px;
        border: 1px solid var(--hs-atc-border);
        border-radius: 3px;
        background-color: #ffffff;
        color: #222222;
        font-size: 12px;
        line-height: 1;
      }

      #{{ sticky_id }} .hs-sticky-atc__dropdown-toggle,
      #{{ sticky_id }} .hs-sticky-atc__dropdown-menu {
        width: 254px;
        font-size: 12px;
      }

      #{{ sticky_id }} .hs-sticky-atc__dropdown-option {
        font-size: 12px;
      }

      #{{ sticky_id }} .hs-sticky-atc__right {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      #{{ sticky_id }} .hs-sticky-atc__qty {
        height: 44px;
        min-width: 88px;
        padding: 0 11px;
        gap: 8px;
        border-radius: 999px;
      }

      #{{ sticky_id }} .hs-sticky-atc__qty-btn {
        width: 18px;
        height: 28px;
        font-size: 16px;
      }

      #{{ sticky_id }} .hs-sticky-atc__qty-number {
        min-width: 12px;
        height: 28px;
        font-size: 16px;
      }

      #{{ sticky_id }} .hs-sticky-atc__button {
        height: 44px;
        min-width: 0;
        flex: 1;
        padding: 0 16px;
        border-radius: 999px;
        font-size: 14px;
      }

      #{{ sticky_id }} .hs-sticky-atc__button-inner,
      #{{ sticky_id }} .hs-sticky-atc__button-inner [data-sticky-button-label],
      #{{ sticky_id }} .hs-sticky-atc__button-divider,
      #{{ sticky_id }} .hs-sticky-atc__button-price {
        font-size: 14px;
        line-height: 1;
      }
    }

    @media screen and (max-width: 420px) {
      #{{ sticky_id }} .hs-sticky-atc__select,
      #{{ sticky_id }} .hs-sticky-atc__select--purchase {
        width: 200px;
        height: 38px;
      }

      #{{ sticky_id }} .hs-sticky-atc__dropdown-toggle,
      #{{ sticky_id }} .hs-sticky-atc__dropdown-menu {
        width: 254px;
      }

      #{{ sticky_id }} .hs-sticky-atc__qty {
        min-width: 86px;
        height: 44px;
      }

      #{{ sticky_id }} .hs-sticky-atc__button {
        height: 44px;
        padding: 0 12px;
      }
    }

    @media screen and (max-width: 360px) {
      #{{ sticky_id }} .hs-sticky-atc__select,
      #{{ sticky_id }} .hs-sticky-atc__select--purchase {
        width: 190px;
      }

      #{{ sticky_id }} .hs-sticky-atc__dropdown-toggle,
      #{{ sticky_id }} .hs-sticky-atc__dropdown-menu {
        width: 248px;
      }

      #{{ sticky_id }} .hs-sticky-atc__qty {
        min-width: 82px;
        padding: 0 9px;
      }

      #{{ sticky_id }} .hs-sticky-atc__button {
        padding: 0 12px;
      }
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById({{ sticky_id | json }});
      if (!root || root.dataset.hsStickyReady === 'true') return;
      root.dataset.hsStickyReady = 'true';

      const PRODUCTS = {
        sub90:   { variantId: 43232223789161, planId: 2124218473, qty: 1 },
        sub30:   { variantId: 43232206454889, planId: 2124185705, qty: 1 },
        onetime: { variantId: 43231934775401, planId: null,       qty: 1 }
      };

      const PRICE_MAP = {
        sub90:   '$135.00',
        sub30:   '$49.00',
        onetime: '$69.00'
      };

      const PLAN_DISPLAY = {
        sub90:   { label: '90-day Subscription', save: '(Save 34%)' },
        sub30:   { label: '30-day Subscription', save: '(Save 28%)' },
        onetime: { label: 'One-time Purchase',    save: '' }
      };

      const ITEM_DATA = {
        sub90:   { title: 'HairScripts by Bevy Supplement - 90 Days', variant: '90-day subscription', price: '$135.00', compareAt: '$207.00', save: 'SAVE 34%', href: '/products/hairscripts-by-bevy-supplement-90-days?selling_plan=2124218473&variant=43232223789161' },
        sub30:   { title: 'HairScripts by Bevy Supplement',           variant: '30-day subscription', price: '$49.00',  compareAt: '',        save: '',         href: '/products/hairscripts-by-bevy-supplement?selling_plan=2124185705&variant=43232206454889' },
        onetime: { title: 'HairScripts by Bevy Supplement',           variant: '30-Day Supply',       price: '$69.00',  compareAt: '',        save: '',         href: '/products/hairscripts-by-bevy-supplement?variant=43231934775401' }
      };

      const IMG_SRC = '//bevyscripts.com/cdn/shop/files/2_9ca31d72-534f-49c8-891a-640bc47b1731.png?v=1778765354&width=250';

      const stickyBar          = root.querySelector('.hs-sticky-atc__bar');
      const planSelect         = root.querySelector('[data-sticky-selling-plan-select]');
      const purchaseDropdown   = root.querySelector('[data-sticky-purchase-dropdown]');
      const purchaseToggle     = root.querySelector('[data-sticky-purchase-toggle]');
      const purchaseMenu       = root.querySelector('[data-sticky-purchase-menu]');
      const currentPlanLabel   = root.querySelector('[data-sticky-purchase-current-label]');
      const currentPlanSave    = root.querySelector('[data-sticky-purchase-current-save]');
      const purchaseOptions    = Array.from(root.querySelectorAll('[data-sticky-plan-option]'));
      const qtyMinus           = root.querySelector('[data-sticky-qty-minus]');
      const qtyPlus            = root.querySelector('[data-sticky-qty-plus]');
      const qtyNumber          = root.querySelector('[data-sticky-qty-number]');
      const themeQtyNumber     = root.querySelector('[data-sticky-theme-qty-number]');
      const priceEl            = root.querySelector('[data-sticky-price]');
      const addButton          = root.querySelector('[data-sticky-atc-btn]');
      const buttonLabel        = root.querySelector('[data-sticky-button-label]');

      const addToCartText = {{ 'products.product.add_to_cart' | t | json }};

      let quantity  = parseInt(root.dataset.initialQuantity || '1', 10) || 1;
      let isTicking = false;
      let isAdding  = false;
      let guardObs  = null;

      const updateStickyVisibility = () => {
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
        const currentScroll  = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
        const pageHeight     = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
        const isBelowFold    = currentScroll > viewportHeight;
        const isAtPageBottom = currentScroll + viewportHeight >= pageHeight - 24;

        root.setAttribute('data-below-fold',     isBelowFold    ? 'true' : 'false');
        root.setAttribute('data-at-page-bottom', isAtPageBottom ? 'true' : 'false');

        if (stickyBar) stickyBar.setAttribute('data-stuck', 'true');
      };

      const requestStickyVisibilityUpdate = () => {
        if (isTicking) return;

        isTicking = true;

        window.requestAnimationFrame(() => {
          updateStickyVisibility();
          isTicking = false;
        });
      };

      updateStickyVisibility();
      window.addEventListener('scroll', requestStickyVisibilityUpdate, { passive: true });
      window.addEventListener('resize', requestStickyVisibilityUpdate);
      window.addEventListener('pageshow', updateStickyVisibility);

      const setQuantity = (nextQty) => {
        quantity = Math.max(1, nextQty);

        if (qtyNumber) {
          qtyNumber.textContent = quantity;
        }

        if (themeQtyNumber) {
          themeQtyNumber.textContent = quantity;
        }

        root.dataset.initialQuantity = String(quantity);
      };

      const updatePrice = () => {
        if (!priceEl || !planSelect) return;

        priceEl.textContent = PRICE_MAP[planSelect.value] || PRICE_MAP.onetime;
      };

      const closePurchaseDropdown = () => {
        if (!purchaseToggle || !purchaseMenu) return;

        purchaseToggle.setAttribute('aria-expanded', 'false');
        purchaseMenu.hidden = true;
      };

      const syncPurchaseDropdown = () => {
        if (!planSelect) return;

        const selectedValue = planSelect.value || 'onetime';
        const selectedPlan  = PLAN_DISPLAY[selectedValue] || PLAN_DISPLAY.onetime;

        if (currentPlanLabel) {
          currentPlanLabel.textContent = selectedPlan.label;
        }

        if (currentPlanSave) {
          currentPlanSave.textContent = selectedPlan.save;
          currentPlanSave.hidden = selectedPlan.save === '';
        }

        purchaseOptions.forEach((option) => {
          const isSelected = option.dataset.stickyPlanOption === selectedValue;

          option.classList.toggle('is-selected', isSelected);
          option.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        });
      };

      if (qtyMinus) {
        qtyMinus.addEventListener('click', () => setQuantity(quantity - 1));
      }

      if (qtyPlus) {
        qtyPlus.addEventListener('click', () => setQuantity(quantity + 1));
      }

      if (purchaseToggle && purchaseMenu) {
        purchaseToggle.addEventListener('click', () => {
          const isOpen = purchaseToggle.getAttribute('aria-expanded') === 'true';

          purchaseToggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          purchaseMenu.hidden = isOpen;
        });
      }

      purchaseOptions.forEach((option) => {
        option.addEventListener('click', () => {
          if (!planSelect) return;

          planSelect.value = option.dataset.stickyPlanOption || 'onetime';
          planSelect.dispatchEvent(new Event('change', { bubbles: true }));
          closePurchaseDropdown();
        });
      });

      document.addEventListener('click', (event) => {
        if (purchaseDropdown && !purchaseDropdown.contains(event.target)) {
          closePurchaseDropdown();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closePurchaseDropdown();
        }
      });

      if (planSelect) {
        planSelect.addEventListener('change', () => {
          updatePrice();
          syncPurchaseDropdown();
        });

        updatePrice();
        syncPurchaseDropdown();
      }

      const getCurrentCartCount = () => {
        const el = document.querySelector('.js-cart-drawer-count');

        return el ? (parseInt(el.textContent.trim(), 10) || 0) : 0;
      };

      const setCartCount = (n) => {
        document.querySelectorAll(
          '.js-cart-drawer-count,[data-cart-count],.cart-count-bubble span,.cart-count,#cart-icon-bubble span,.cart-count-bubble'
        ).forEach((el) => {
          el.textContent = n;
        });
      };

      const buildFakeCartHTML = (mode) => {
        const data = ITEM_DATA[mode];

        const compareHTML = data.compareAt
          ? `<s class="compare-at-price">${data.compareAt}</s>${data.save ? `<span class="cart-items__save-badge">${data.save}</span>` : ''}`
          : '';

        return `
          <span class="visually-hidden" ref="cartItemCount" aria-hidden="true">1</span>
          <form action="/cart" class="cart-form" id="cart-form-ghost" method="post">
            <div class="cart-items spacing-style" style="--cart-items-gap:px;">
              <table class="cart-items__table" role="table">
                <caption class="visually-hidden" role="caption">Cart total <span>${data.price} USD</span></caption>

                <thead class="visually-hidden" role="rowgroup">
                  <tr role="row" class="cart-items__table-row">
                    <th id="productImage" scope="col" role="columnheader">Product image</th>
                    <th id="productInformation" scope="col" role="columnheader">Product information</th>
                    <th id="quantity" scope="col" role="columnheader">Quantity</th>
                    <th id="productTotal" scope="col" role="columnheader">Product total</th>
                  </tr>
                </thead>

                <tbody role="rowgroup">
                  <tr role="row" class="cart-items__table-row cart-items__table-row--full-width-variants" data-rc-ghost="1">
                    <td class="cart-items__media" role="cell" headers="productImage">
                      <a href="${data.href}" class="cart-items__media-container" style="--ratio:1;">
                        <img
                          src="${IMG_SRC}"
                          alt=""
                          width="250"
                          height="250"
                          class="cart-items__media-image border-style"
                          style="--border-width:1px;--border-style:none;--border-color:rgba(0,0,0,0.5);--border-radius:0px;"
                        >
                      </a>
                    </td>

                    <td class="cart-items__details cart-primary-typography" role="cell" headers="productInformation">
                      <div class="cart-items__product-info">
                        <p>
                          <a href="${data.href}" class="cart-items__title">${data.title}</a>
                        </p>
                      </div>

                      <div class="cart-items__variants-wrapper">
                        <p>${data.variant}</p>
                      </div>

                      <div class="cart-items__unit-price-wrapper">
                        <div>
                          <span>${data.price}</span>${compareHTML}
                        </div>
                      </div>
                    </td>

                    <td class="cart-items__quantity" role="cell" headers="quantity">
                      <div class="cart-items__quantity-controls">
                        <div class="quantity-selector-wrapper">
                          <div class="quantity-selector cart-primary-typography" style="display:flex;align-items:center;gap:8px;">
                            <button class="button quantity-minus button-unstyled" type="button" disabled>−</button>
                            <input type="number" value="1" min="1" aria-label="Quantity" style="width:36px;text-align:center;" readonly>
                            <button class="button quantity-plus button-unstyled" type="button">+</button>
                          </div>
                        </div>
                      </div>
                    </td>

                    <td class="cart-items__price cart-secondary-typography" role="cell" headers="productTotal">
                      <text-component value="${data.price}">${data.price}</text-component>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </form>`;
      };

      const getCartWrapper = () =>
        document.querySelector('cart-items-component .cart-items__wrapper') ||
        document.querySelector('.cart-items__wrapper');

      const stopGuard = () => {
        if (guardObs) {
          guardObs.disconnect();
          guardObs = null;
        }
      };

      const injectGhost = (mode) => {
        const wrapper = getCartWrapper();

        if (!wrapper) return;

        wrapper.innerHTML = buildFakeCartHTML(mode);

        document.querySelectorAll('.js-cart-drawer-empty').forEach((el) => {
          el.setAttribute('hidden', '');
          el.style.setProperty('display', 'none', 'important');
        });

        document.querySelectorAll('.js-cart-drawer-filled').forEach((el) => {
          el.removeAttribute('hidden');
          el.style.removeProperty('display');
        });

        const finalEl = document.querySelector('.cart-drawer__totals-final');

        if (finalEl) {
          finalEl.textContent = ITEM_DATA[mode].price;
        }

        const guardTarget = document.querySelector('cart-items-component') || document.body;

        stopGuard();

        guardObs = new MutationObserver(() => {
          if (!isAdding) return;

          const w = getCartWrapper();

          if (w && !w.querySelector('[data-rc-ghost]') && !w.querySelector('.cart-form:not(#cart-form-ghost)')) {
            w.innerHTML = buildFakeCartHTML(mode);

            const fe = document.querySelector('.cart-drawer__totals-final');

            if (fe) {
              fe.textContent = ITEM_DATA[mode].price;
            }
          }

          document.querySelectorAll('.js-cart-drawer-empty').forEach((el) => {
            el.setAttribute('hidden', '');
            el.style.setProperty('display', 'none', 'important');
          });

          document.querySelectorAll('.js-cart-drawer-filled').forEach((el) => {
            el.removeAttribute('hidden');
          });
        });

        guardObs.observe(guardTarget, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['hidden']
        });
      };

      const openCartDrawer = () => {
        const cdc = document.querySelector('cart-drawer-component');

        if (!cdc) return;

        if (typeof cdc.open === 'function') {
          cdc.open();
        } else {
          cdc.removeAttribute('hidden');
          cdc.setAttribute('open', '');
          cdc.classList.add('is-open', 'active');
        }

        document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
      };

      const refreshCartFromServer = (mode) => {
        const cic = document.querySelector('cart-items-component[data-drawer]');

        const sid = cic
          ? cic.getAttribute('data-section-id')
          : 'sections--19054444937321__header_section';

        fetch('/?sections=' + sid)
          .then((response) => response.json())
          .then((data) => {
            const html = data[sid] || data[Object.keys(data)[0]];

            if (!html) return;

            const doc   = new DOMParser().parseFromString(html, 'text/html');
            const fresh = doc.querySelector('cart-items-component[data-drawer]');
            const live  = document.querySelector('cart-items-component[data-drawer]');

            if (fresh && live) {
              stopGuard();
              isAdding = false;
              live.innerHTML = fresh.innerHTML;
            }
          })
          .catch(() => {
            stopGuard();
            isAdding = false;
          })
          .finally(() => {
            fetch('/cart.js')
              .then((response) => response.json())
              .then((cart) => {
                setCartCount(cart.item_count);

                document.dispatchEvent(new CustomEvent('cart:update', {
                  bubbles: true,
                  detail: {
                    data: {
                      itemCount: cart.item_count,
                      source: 'product-form-component'
                    }
                  }
                }));

                import('@theme/events')
                  .then(({ CartUpdateEvent }) => {
                    document.dispatchEvent(new CartUpdateEvent(cart, 'manual-trigger', {
                      itemCount: cart.item_count,
                      source: 'hs-sticky-atc',
                      sections: {}
                    }));
                  })
                  .catch(() => {});
              });
          });
      };

      const handleAddToCart = () => {
        if (!planSelect || !addButton || isAdding) return;

        isAdding = true;

        const mode    = planSelect.value || 'onetime';
        const product = PRODUCTS[mode] || PRODUCTS.onetime;
        const item    = {
          id: product.variantId,
          quantity
        };

        if (product.planId) {
          item.selling_plan = product.planId;
        }

        addButton.disabled = true;

        if (buttonLabel) {
          buttonLabel.textContent = 'Adding...';
        }

        setCartCount(getCurrentCartCount() + quantity);
        injectGhost(mode);
        openCartDrawer();

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ items: [item] })
        })
          .then((response) => {
            if (!response.ok) {
              return response.json().then((data) => {
                throw new Error(data.description || data.message || 'Could not add to cart.');
              });
            }

            return response.json();
          })
          .then(() => {
            if (buttonLabel) {
              buttonLabel.textContent = 'Added!';
            }

            refreshCartFromServer(mode);

            setTimeout(() => {
              if (buttonLabel) {
                buttonLabel.textContent = addToCartText;
              }

              addButton.disabled = false;
            }, 2000);
          })
          .catch((error) => {
            stopGuard();
            isAdding = false;
            setCartCount(Math.max(0, getCurrentCartCount() - quantity));

            if (buttonLabel) {
              buttonLabel.textContent = addToCartText;
            }

            addButton.disabled = false;
            alert(error.message || 'Error adding to cart. Please try again.');
          });
      };

      if (addButton) {
        addButton.addEventListener('click', handleAddToCart);
      }

      setQuantity(quantity);
    })();
  </script>
{% endif %}