</svg>
    </span>

    {% render 'cart-bubble', limit: 100 %}
  </cart-icon>
{% endcapture %}

{% capture account_icon %}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="17"
    viewBox="0 0 15 17"
    fill="none"
    slot="signed-out-avatar"
    class="account-button__icon"
  >
    <path
      stroke="currentColor"
      stroke-linejoin="round"
      stroke-width="var(--icon-stroke-width)"
      d="M10.375 3.813a3.063 3.063 0 1 1-6.125 0 3.063 3.063 0 0 1 6.125 0ZM7.313 9.5c-3.667 0-6.24 2.691-6.563 6.125h13.125C13.552 12.191 10.979 9.5 7.312 9.5Z"
    />
  </svg>
{% endcapture %}

<header-actions
  {% if display_style == 'text' %}
    class="header-actions--text"
  {% endif %}
  {{- block.shopify_attributes -}}
>
  {% if shop.customer_accounts_enabled %}
    {% liquid
      assign account_actions_style = ''
      if display_style == 'text' and section
        assign actions_font = section.settings.actions_font | default: 'body'
        assign font_obj = settings.type_heading_font
        case actions_font
          when 'body'
            assign font_obj = settings.type_body_font
          when 'subheading'
            assign font_obj = settings.type_subheading_font
          when 'accent'
            assign font_obj = settings.type_accent_font
        endcase
        assign font_family = font_obj.family | append: ', ' | append: font_obj.fallback_families
        assign font_family_safe = font_family | replace: '"', "'"
        assign account_actions_style = '--header-actions-font-family: ' | append: font_family_safe | append: '; --header-actions-font-weight: ' | append: font_obj.weight | append: ';'
      endif
    %}
    <div
      class="account-button header-actions__action{% if display_style == 'text' %} account-button--text{% endif %} color-{{ settings.popover_color_scheme }}"
    >
      <shopify-account
        menu="{{ customer_account_menu }}"
        {% if account_actions_style != blank %}
          style="{{ account_actions_style }}"
        {% endif %}
      >
        {% if customer %}
          <div class="account-button__fallback"></div>
        {% else %}
          <span
            slot="signed-out-avatar"
            class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}"
          >
            {{ 'content.account_title' | t }}
          </span>

          <span
            slot="signed-out-avatar"
            class="{% if display_style != 'icon' %}desktop:hidden{% endif %}"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18" fill="none">
  <path d="M8.94872 0C4.01442 0 0 4.01443 0 8.94872C0 13.883 4.01442 17.8974 8.94872 17.8974C13.883 17.8974 17.8974 13.883 17.8974 8.94872C17.8974 4.01443 13.883 0 8.94872 0ZM8.94872 1.34231C13.1576 1.34231 16.5551 4.73986 16.5551 8.94872C16.5551 10.9426 15.7864 12.7482 14.5364 14.103C13.4686 12.1036 11.3691 10.7385 8.94872 10.7385C6.52833 10.7385 4.42886 12.1036 3.36101 14.103C2.11102 12.7482 1.34231 10.9426 1.34231 8.94872C1.34231 4.73986 4.73986 1.34231 8.94872 1.34231ZM8.94872 4.47436C7.95989 4.47436 7.15897 5.27527 7.15897 6.2641V7.15897C7.15897 8.14781 7.95989 8.94872 8.94872 8.94872C9.93755 8.94872 10.7385 8.14781 10.7385 7.15897V6.2641C10.7385 5.27527 9.93755 4.47436 8.94872 4.47436ZM8.94872 12.0808C10.9866 12.0808 12.7069 13.303 13.4895 15.045C12.2221 15.9897 10.6552 16.5551 8.94872 16.5551C7.24227 16.5551 5.67529 15.9897 4.40794 15.045C5.1905 13.303 6.91081 12.0808 8.94872 12.0808Z" fill="#FFFFFF"/>
</svg>
          </span>
        {% endif %}
      </shopify-account>
    </div>
  {% endif %}

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    <script
      src="{{ 'cart-drawer.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>

    {% liquid
      assign cart_drawer_empty_footer_show = true
      if section != blank and section.settings.cart_drawer_upsell_enable != false
        assign upsell_pick = section.settings.cart_drawer_upsell_product
        if upsell_pick != blank and section.settings.cart_drawer_upsell_banner_text != blank
          assign cart_drawer_empty_footer_show = false
        endif
      endif
    %}

    {% capture empty_cart_drawer_content %}
      <div class="cart-drawer__empty-wrapper">
        <div class="cart-drawer__header cart-drawer__header--empty">
          <h2 class="cart-drawer__heading" id="cart-drawer-heading-empty">
            YOUR CART
            <span class="cart-drawer__bubble js-cart-drawer-count">0</span>
          </h2>
          <button
            ref="closeButton"
            on:click="cart-drawer-component/close"
            class="button close-button cart-drawer__close-button button-unstyled"
            aria-label="{{ 'actions.close_dialog' | t }}"
          >
            <span class="svg-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                <path d="M13.6639 0.000165713C13.5071 0.00386868 13.3581 0.0694605 13.2495 0.18262L7.13417 6.29794L1.01886 0.18262C0.963357 0.125672 0.896985 0.0804513 0.823677 0.0496407C0.750369 0.0188301 0.671619 0.00305735 0.5921 0.00325816C0.474163 0.00359777 0.358998 0.0390484 0.261287 0.105091C0.163575 0.171134 0.0877425 0.264778 0.043456 0.374084C-0.000830589 0.483391 -0.0115651 0.603409 0.0126208 0.71884C0.0368067 0.834271 0.0948173 0.939885 0.179258 1.02222L6.29457 7.13753L0.186989 13.2451C0.130006 13.2998 0.084512 13.3654 0.0531718 13.4379C0.0218316 13.5104 0.00527519 13.5884 0.00447196 13.6674C0.00366872 13.7464 0.0186349 13.8248 0.048494 13.8979C0.0783532 13.971 0.122505 14.0375 0.178364 14.0933C0.234223 14.1492 0.300666 14.1934 0.373801 14.2232C0.446937 14.2531 0.525296 14.268 0.604288 14.2672C0.683281 14.2664 0.761319 14.2499 0.833832 14.2185C0.906346 14.1872 0.971877 14.1417 1.02659 14.0847L7.13417 7.97713L13.2433 14.0878C13.2985 14.1431 13.3641 14.1869 13.4363 14.2168C13.5084 14.2467 13.5858 14.2621 13.6639 14.2621C13.742 14.2621 13.8194 14.2467 13.8915 14.2168C13.9637 14.1869 14.0293 14.1431 14.0845 14.0879C14.1397 14.0326 14.1835 13.9671 14.2134 13.8949C14.2433 13.8227 14.2587 13.7454 14.2587 13.6673C14.2587 13.5891 14.2433 13.5118 14.2134 13.4396C14.1835 13.3675 14.1397 13.3019 14.0844 13.2467L7.97377 7.13753L14.0891 1.02222C14.1754 0.939349 14.2347 0.832322 14.2592 0.715171C14.2836 0.59802 14.2721 0.476212 14.2262 0.365716C14.1802 0.25522 14.1019 0.161193 14.0016 0.0959616C13.9012 0.0307303 13.7835 -0.0026609 13.6639 0.000165713Z" fill="#211B18"/>
              </svg>
            </span>
          </button>
        </div>

        <div
          class="cart-drawer__content cart-drawer__content--empty"
          aria-label="{{ 'accessibility.cart' | t }}"
        >
          <div class="cart-drawer__empty-body">
            <div class="cart-drawer__empty-image-wrap">
              <img
                src="https://cdn.shopify.com/s/files/1/0663/4382/9609/files/Mask_group_d7bc3765-8cda-4a7d-8efe-3f5d7ac5bcf6.png?v=1778225868"
                alt="Hairscripts product"
                class="cart-drawer__empty-product-img"
                width="200"
                height="200"
              />
            </div>

            <h2
              class="cart-drawer__heading cart-drawer__heading--empty"
              id="cart-drawer-heading-empty-text"
            >
              {{ 'content.your_cart_is_empty' | t }}
            </h2>

            <p class="cart-drawer__empty-subtext">
              Start building your routine for healthier, stronger hair.
            </p>

            <a href="products/hairscripts-by-bevy-supplement" class="cart-drawer__shop-now-btn">
              Shop Now
            </a>
          </div>

          {%- if section != blank -%}
            {% render 'cart-drawer-empty-upsell', section: section %}
          {%- endif -%}

          {% if cart_drawer_empty_footer_show %}
            <div class="cart-drawer__empty-footer">
              SAVE UP TO 30% OFF
            </div>
          {% endif %}
        </div>
      </div>
    {% endcapture %}

    <cart-drawer-component
      class="cart-drawer{% if display_style == 'text' %} cart-drawer--text{% endif %}"
      {{ block.shopify_attributes }}
      {% if settings.auto_open_cart_drawer %}
        auto-open
      {% endif %}
    >

      <button
        class="header-actions__action button-unstyled{% if display_style == 'text' %} header-actions__text-style{% endif %}"
        on:click="/open"
        aria-haspopup="dialog"
        aria-label="{{ 'accessibility.cart' | t }}"
        aria-describedby="cart-bubble-text"
        data-testid="cart-drawer-trigger"
      >
        {{ cart_icon }}
      </button>

      <dialog
        ref="dialog"
        class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}"
        data-testid="cart-drawer-dialog"
        aria-labelledby="{% if cart.item_count == 0 %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
        scroll-lock
        cart-summary-sticky="true"
      >
        <span
          ref="liveRegion"
          class="visually-hidden"
          role="status"
        ></span>

        <div
          class="cart-drawer__inner"
          data-hydration-key="cart-drawer-inner"
        >
          {% capture cart_items_children %}
            <div class="cart-drawer__dual-state">
              <div class="js-cart-drawer-empty" {% if cart.item_count > 0 %}hidden{% endif %}>
                {{ empty_cart_drawer_content }}
              </div>
              <div class="js-cart-drawer-filled" {% if cart.item_count == 0 %}hidden{% endif %}>
              <div class="cart-drawer__header" id="cart-drawer-header">
                <h2 class="cart-drawer__heading" id="cart-drawer-heading">
                  YOUR CART
                  <span class="cart-drawer__bubble js-cart-drawer-count">{{ cart.item_count }}</span>
                </h2>
                <button
                  ref="closeButton"
                  on:click="cart-drawer-component/close"
                  class="button close-button cart-drawer__close-button button-unstyled"
                  aria-label="{{ 'actions.close_dialog' | t }}"
                >
                  <span class="svg-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 23 23" fill="none">
                      <path d="M19.4047 2.85958C19.2149 2.86406 19.0346 2.94346 18.9031 3.08044L11.5004 10.4832L4.09761 3.08044C4.03043 3.0115 3.95008 2.95676 3.86134 2.91947C3.7726 2.88217 3.67727 2.86308 3.58101 2.86332C3.43824 2.86373 3.29883 2.90664 3.18055 2.98659C3.06227 3.06654 2.97047 3.1799 2.91686 3.31221C2.86325 3.44453 2.85026 3.58982 2.87954 3.72955C2.90881 3.86928 2.97904 3.99713 3.08125 4.0968L10.484 11.4995L3.09061 18.8929C3.02163 18.9592 2.96656 19.0385 2.92862 19.1263C2.89069 19.2141 2.87064 19.3085 2.86967 19.4041C2.8687 19.4998 2.88682 19.5946 2.92296 19.6832C2.95911 19.7717 3.01255 19.8521 3.08017 19.9197C3.14779 19.9874 3.22822 20.0408 3.31675 20.077C3.40529 20.1131 3.50014 20.1312 3.59576 20.1302C3.69139 20.1293 3.78585 20.1092 3.87363 20.0713C3.96141 20.0333 4.04074 19.9783 4.10697 19.9093L11.5004 12.5159L18.8956 19.913C18.9625 19.9799 19.0419 20.033 19.1292 20.0692C19.2166 20.1053 19.3102 20.124 19.4048 20.124C19.4993 20.124 19.593 20.1054 19.6803 20.0692C19.7677 20.033 19.8471 19.98 19.9139 19.9131C19.9808 19.8462 20.0338 19.7669 20.07 19.6795C20.1062 19.5921 20.1248 19.4985 20.1248 19.4039C20.1248 19.3094 20.1062 19.2158 20.07 19.1284C20.0338 19.041 19.9807 18.9617 19.9139 18.8948L12.5167 11.4995L19.9195 4.0968C20.024 3.99648 20.0958 3.86692 20.1254 3.72511C20.155 3.58329 20.141 3.43584 20.0854 3.30208C20.0297 3.16833 19.935 3.0545 19.8135 2.97554C19.6921 2.89657 19.5496 2.85615 19.4047 2.85958Z" fill="#211B18"/>
                    </svg>
                  </span>
                </button>
              </div>

              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 65px;"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  <div class="cart-drawer__totals-row">
                    <span class="cart-drawer__totals-label">TOTAL ITEM</span>
                    <div class="cart-drawer__totals-prices">
                      {%- if cart.original_total_price != cart.total_price -%}
                        <span class="cart-drawer__totals-original">{{ cart.original_total_price | money }}</span>
                      {%- endif -%}
                      <span class="cart-drawer__totals-final">{{ cart.total_price | money }}</span>
                    </div>
                  </div>

                  <p class="cart-drawer__totals-note">Taxes, discounts and shipping calculated at checkout.</p>

                  {% render 'cart-summary', section_id: section.id %}

                  <div class="cart-drawer__checkout-actions">
                   
                    <a href="/checkout" class="cart-drawer__checkout-btn">
                      Checkout Securely
                    </a>
                  </div>

                  <p class="cart-drawer__shipping-note">
                    Ships in the <span>
