<script type="module">
  (function () {
    const emptySel = '.js-cart-drawer-empty';
    const filledSel = '.js-cart-drawer-filled';
    function applyCart(cart) {
      if (!cart || typeof cart.item_count !== 'number') return;
      const empty = document.querySelector(emptySel);
      const filled = document.querySelector(filledSel);
      if (!empty || !filled) return;
      if (cart.item_count === 0) {
        empty.removeAttribute('hidden');
        filled.setAttribute('hidden', '');
      } else {
        empty.setAttribute('hidden', '');
        filled.removeAttribute('hidden');
      }
      document.querySelectorAll('.js-cart-drawer-count').forEach((el) => {
        el.textContent = String(cart.item_count);
      });
    }
    async function refresh(e) {
      const d = e && e.detail;
      const c = d && (d.cartData || d.cart || d.resource);
      if (c && typeof c.item_count === 'number') {
        applyCart(c);
        return;
      }
      try {
        const root = window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';
        const res = await fetch(root + 'cart.js');
        applyCart(await res.json());
      } catch (_) {}
    }
    document.addEventListener('cart:update', refresh);
    document.addEventListener('cart:updated', refresh);
    document.addEventListener('cart:change', refresh);
    document.addEventListener('cart:refresh', refresh);
    document.addEventListener('variant:add', refresh);
  })();
</script>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap');

  :root {
    --cd-teal: #2C5F5C;
    --cd-plum: #725270;
    --cd-deep-plum: #371834;
    --cd-teal-light: #3D7E7A;
    --cd-cream: #FFFFFF;
    --cd-summary-bg: #FFF9F4;
    --cd-btn-gradient-solid: linear-gradient(180deg, #725270 0%, #371834 100%);
    --cd-font: "Cormorant Garamond", Georgia, serif;
  }

  .header {
    --account-offset-top: calc(
      var(--header-group-height) + (var(--header-height) * var(--transparent-header-offset-boolean))
    );

    &[data-sticky-state='active'] {
      --account-offset-top: calc(var(--header-height) - 1px);
    }
  }

  .account-button {
    background: transparent;
  }

  .account-button__icon,
  .account-button__text {
    color: var(--color-account-icon);
    transition: color var(--header-content-transition-timing);
    -webkit-font-smoothing: antialiased;
  }

  shopify-account {
    --shopify-account-font-heading: var(--font-heading--family);
    --shopify-account-font-heading-weight: var(--font-heading--weight);
    --shopify-account-font-body: var(--font-body--family);
    --shopify-account-font-body-weight: var(--font-body--weight);
    --shopify-account-radius-base: var(--style-border-radius-popover);
    --shopify-account-radius-button: var(--style-border-radius-buttons-primary);
    --shopify-account-radius-button-small: var(--style-border-radius-buttons-primary);
    --shopify-account-radius-input: var(--style-border-radius-buttons-primary);
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-text: var(--color-foreground);
    --shopify-account-color-accent: var(--color-primary-button-background);
    --shopify-account-color-accent-text: var(--color-primary-button-text);
    --shopify-account-dialog-position-top: var(--account-offset-top);

    &:not(:defined) {
      min-width: 44px;
      height: 44px;
      display: flex;
      justify-content: center;
      align-items: center;
      line-height: normal;
    }
  }

  .account-button__fallback {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--shopify-account-color-accent, #0a142f);
  }
  .cart-drawer__close-button .svg-wrapper svg {
    width: 23px;
    height: 23px;
  }
  .account-button--text shopify-account {
    color: inherit;
  }

  .cart-drawer {
    --cart-drawer-padding: var(--padding-xl) var(--padding-xl);
    --cart-drawer-padding-desktop: var(--padding-xl) var(--padding-2xl);

    @media screen and (min-width: 750px) {
      margin-inline-end: calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .cart-drawer--text {
      display: flex;
      align-items: center;
    }
  }

  .cart-drawer__dialog {
    position: fixed;
    overflow: hidden;
    border-radius: 0;
    width: 100%;
    height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border-left: var(--style-border-drawer);
    box-shadow: var(--shadow-drawer);
    background-color: var(--cd-cream);
    font-family: var(--cd-font);

    @media screen and (min-width: 750px) {
      width: var(--sidebar-width);
      max-width: 95vw;
    }
  }

  .cart-drawer__dialog:modal {
    max-height: 100dvh;
    overflow-y: hidden;
    width: 450px;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__dual-state {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .js-cart-drawer-filled:not([hidden]),
  .js-cart-drawer-empty:not([hidden]) {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .js-cart-drawer-filled[hidden],
  .js-cart-drawer-empty[hidden] {
    display: none !important;
  }

  .cart-drawer__empty-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    height: 100%;
  }

  .cart-drawer__header {
    background-color: var(--cd-cream);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(44, 95, 92, 0.18);
    position: sticky;
    top: 0;
    z-index: 10;
    flex-shrink: 0;

    @media screen and (min-width: 750px) {
      padding: 22px 32px;
    }
  }

  .cart-drawer__header--empty {
    justify-content: space-between;
    border-bottom: 1px solid rgba(44, 95, 92, 0.18);
  }

  .cart-drawer__heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--cd-font);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .cart-drawer__bubble {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: var(--cd-teal);
    color: #fff;
    font-family: "DM SANS";
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
    padding-left: 3px;
  }

  .cart-drawer__close-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
    transition: opacity 0.2s;
    margin-right: -4px;
    top: 12px;

    &:hover {
      opacity: 1;
    }
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--cd-cream);
    flex: 1;
    min-height: 0;
  }

  .cart-drawer__content:not(.cart-drawer__content--empty) {
    overflow: hidden;
  }

  .cart-drawer__content--empty {
    height: 100%;
    justify-content: space-between;
    overflow-x: hidden;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
    -webkit-overflow-scrolling: touch;
  }

  .cart-drawer__empty-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 32px 24px 24px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .cart-drawer__empty-body {
      flex: 0 1 auto;
    }

    .cart-drawer__content--empty .cart-drawer-empty-upsell {
      flex-shrink: 0;
      margin-top: auto;
    }
  }

  .cart-drawer__empty-image-wrap {
    width: 130px;
    height: 130px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 22px;

    @media screen and (min-width: 750px) {
      width: 160px;
      height: 160px;
      margin-bottom: 26px;
    }
  }

  .cart-drawer__empty-product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__heading--empty {
    font-family: var(--cd-font);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0px;
    text-transform: uppercase;
    color: #1a1a1a;
    margin-bottom: 10px;
    justify-content: center;
  }

  .cart-drawer__empty-subtext {
    font-family: "DM Sans", sans-serif;
    font-size: 15px;
    color: #555;
    line-height: 1.55;
    margin: 0 0 28px;
    max-width: 260px;
  }

  .cart-drawer__shop-now-btn {
    display: inline-block;
    padding: 14px 44px;
    background: linear-gradient(90deg, #725270 0%, #4d2449 69%, #481d44 84%, #371834 100%);
    color: #fff;
    font-family: "DM Sans", sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-radius: 40px;
    transition: opacity 0.2s;
    text-align: center;
    min-width: 180px;

    &:hover {
      opacity: 0.88;
    }
  }

  .cart-drawer__empty-footer {
    background-color: var(--cd-teal);
    color: #fff;
    text-align: center;
    padding: 16px;
    font-family: var(--cd-font);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    width: 100%;
    flex-shrink: 0;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding: 20px 24px;
    overflow-y: auto;
    flex: 1;
    min-height: 0;

    @media screen and (min-width: 750px) {
      padding: 24px 32px;
    }
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: 1px solid rgba(44, 95, 92, 0.15);
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: 20px;

    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--cart-drawer-summary-padding) 24px 24px;
    padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    background-color: var(--cd-summary-bg);
    border-top: 1px solid rgba(44, 95, 92, 0.15);

    @media screen and (min-width: 750px) {
      padding: var(--cart-drawer-summary-padding) 32px 32px;
      padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px));
    }
  }

  .cart-drawer__totals-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .cart-drawer__totals-label {
    font-family: var(--cd-font);
    font-size: 20px !important;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .cart-drawer__totals-prices {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cart-drawer__totals-original {
    font-family: var(--cd-font);
    font-size: 15px;
    color: #999;
    text-decoration: line-through;
  }

  .cart-drawer__totals-final {
    font-family: "DM SANS";
    font-size: 20px;
    font-weight: 400;
    color: #1a1a1a;
  }

  .cart-drawer__totals-note {
    font-family: "DM SANS";
    font-size: 12px;
    color: #777;
    margin: 0 0 8px;
    line-height: 1.5;
  }

  .cart-drawer__checkout-actions {
    display: flex;
    gap: 10px;
    margin-top: 4px;

    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  .cart-drawer__continue-btn {
    flex: 1;
    padding: 13px 16px;
    background: transparent;
    color: #1a1a1a;
    font-family: "DM SANS";
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.04em;
    border: 1.5px solid #1a1a1a;
    border-radius: 40px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
    text-align: center;

    &:hover {
      background: linear-gradient(90deg, #725270 0%, #4d2449 69%, #481d44 84%, #371834 100%);
      color: #fff;
    }
  }

  .cart-drawer__checkout-btn {
    flex: 1.4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    background: linear-gradient(90deg, #725270 0%, #4d2449 69%, #481d44 84%, #371834 100%);
    color: #fff;
    font-family: "DM SANS";
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.04em;
    border-radius: 40px;
    text-decoration: none;
    transition: opacity 0.2s;
    white-space: nowrap;
    text-align: center;

    &:hover {
      opacity: 0.88;
    }
  }

  .cart-drawer__shipping-note {
    font-family: "DM SANS";
    font-size: 12px;
    color: #666;
    text-align: center;
    margin: 4px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .cart-drawer__payment-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
    min-height: 24px;
  }

  .cart-bubble.cart-bubble--animating .cart-bubble__background {
    animation: grow var(--animation-speed) var(--animation-easing);
  }

  .cart-bubble--animating .cart-bubble__text {
    --start-y: -1em;
    --start-opacity: 1;
    transform: translate(0, var(--start-y, -1em));
    opacity: var(--start-opacity, 1);
    animation: move-and-fade var(--animation-speed) var(--animation-easing);
  }

  .cart-drawer__inner:has(.cart-drawer__empty-wrapper) {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    margin-top: 0;
  }

  .cart-drawer--empty .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    margin-top: 0;
  }

  .cart-drawer:not(:has(.cart-form)) .cart-drawer__content {
    justify-content: center;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  header-actions {
    display: flex;

    @media screen and (max-width: 749px) {
      justify-self: flex-end;
    }
  }

  @media screen and (min-width: 750px) {
    .header-actions--text {
      gap: var(--gap-xl);
    }

    .header-actions__text-style {
      font-size: var(--header-actions-font-size);
      font-family: var(--header-actions-font-family);
      font-weight: var(--header-actions-font-weight);
      text-transform: var(--header-actions-text-case);
    }
  }

  #header-component[data-menu-style='drawer'] header-actions {
    justify-self: flex-end;
  }

  .header__column--right header-actions {
    margin-inline-start: calc(var(--gap-md) * -1);
  }

  .header-actions__cart-icon {
    --cart-bubble-size: 20px;
    --cart-bubble-top: 4.5px;
    --cart-bubble-right: 2.5px;

    position: relative;
  }

  .header-actions__cart-icon .cart-bubble {
    position: absolute;
    width: var(--cart-bubble-size, 20px);
    top: var(--cart-bubble-top);
    right: var(--cart-bubble-right);
  }

  @media screen and (min-width: 750px) {
    .header-actions__cart-icon--text.header-actions__cart-icon .cart-bubble {
      position: relative;
      top: 0;
    }
  }

  .header-actions__cart-icon.header-actions__cart-icon--has-cart svg {
    mask: radial-gradient(
      calc(var(--cart-bubble-size) + 2px) at calc(100% - var(--cart-bubble-right)) var(--cart-bubble-top),
      transparent 45.45%,
      #fff 45.45%,
      #fff 100%
    );
  }

  cart-icon:has(.cart-bubble__text-count:empty) {
    --cart-bubble-size: 10px;
    --cart-bubble-top: 9px;
    --cart-bubble-right: 9px;

    .svg-wrapper {
      --cart-bubble-top: 4px;
      --cart-bubble-right: 4px;
    }
  }

  @media screen and (min-width: 750px) {
    cart-icon.header-actions__cart-icon--text:has(.cart-bubble__text-count:empty) {
      --cart-bubble-right: 2.5px;
    }
  }

  .header-actions__text {
    display: flex;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .header-actions__cart-icon--text {
      display: flex;
      align-items: center;
      gap: var(--gap-xs);
    }

    .header__column--right .header-actions--text {
      margin-inline-start: 0;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .cart-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  ::view-transition-old(cart-drawer-content) {
    transform-origin: 50% 33%;
    animation: cart-contents-old var(--spring-d280-b0-duration) var(--spring-d280-b0-easing) forwards;
  }

  ::view-transition-new(cart-drawer-content) {
    transform-origin: top center;
    animation: cart-contents-new var(--spring-d280-b0-duration) var(--spring-d280-b0-easing) forwards;
  }

  @keyframes cart-contents-old {
    to {
      scale: 0.92;
      opacity: 0;
    }
  }

  @keyframes cart-contents-new {
    from {
      scale: 1.05;
      translate: 0 128px;
      filter: blur(1px);
      opacity: 0;
    }
  }
{% endstylesheet %}
