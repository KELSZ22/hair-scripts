{%- doc -%}
  Promotional upsell below the empty-cart message in the drawer. Content comes from header (or header-product) section settings.
  Requires a product from the resource picker, or a valid product handle in “Product handle (fallback)”.
  @param {object} section - Header section (or header-product) with cart_drawer_upsell_* settings
{%- enddoc -%}

{%- liquid
  assign upsell_product = section.settings.cart_drawer_upsell_product
  assign handle_fallback = section.settings.cart_drawer_upsell_product_handle | default: '' | strip
  if upsell_product == blank and handle_fallback != blank
    assign upsell_product = all_products[handle_fallback]
  endif

  assign show_upsell = false
  if section != blank and section.settings.cart_drawer_upsell_enable != false and upsell_product != blank
    assign show_upsell = true
  endif
-%}

{%- if show_upsell -%}
  {%- liquid
    assign variant = upsell_product.selected_or_first_available_variant

    assign heading = section.settings.cart_drawer_upsell_heading
    if heading == blank
      assign heading = upsell_product.title
    endif

    assign price_override = section.settings.cart_drawer_upsell_price
    assign compare_override = section.settings.cart_drawer_upsell_compare_price

    assign banner_bg = section.settings.cart_drawer_upsell_banner_color
    if banner_bg == blank or banner_bg == 'rgba(0,0,0,0)'
      assign banner_bg = '#237b84'
    endif

    assign upsell_image = section.settings.cart_drawer_upsell_image
    if upsell_image == blank
      assign upsell_image = upsell_product.featured_image
    endif

    if variant.available
      assign can_add_to_cart = true
    else
      assign can_add_to_cart = false
    endif

    assign btn_label = section.settings.cart_drawer_upsell_button_label
    if btn_label == blank
      assign btn_label = 'actions.add_to_cart' | t
    endif

    assign product_form_id = 'CartDrawerUpsell-Form-' | append: section.id

    assign img_alt = upsell_image.alt | default: heading
  -%}

  <div class="cart-drawer-empty-upsell">
    {%- if section.settings.cart_drawer_upsell_banner_text != blank -%}
      <div
        class="cart-drawer-empty-upsell__banner"
        style="--cart-drawer-upsell-banner-bg: {{ banner_bg }};"
      >
        {{ section.settings.cart_drawer_upsell_banner_text | escape }}
      </div>
    {%- endif -%}

    <div class="cart-drawer-empty-upsell__body">
      <div class="cart-drawer-empty-upsell__layout">
        <div class="cart-drawer-empty-upsell__media">
          {%- if upsell_image != blank -%}
            {{
              upsell_image
              | image_url: width: 260
              | image_tag:
                loading: 'lazy',
                class: 'cart-drawer-empty-upsell__img',
                widths: '90, 120, 180, 260',
                sizes: '(min-width: 400px) 120px, 28vw',
                alt: img_alt
            }}
          {%- endif -%}
        </div>

        <div class="cart-drawer-empty-upsell__main">
          <div class="cart-drawer-empty-upsell__header">
            <div class="cart-drawer-empty-upsell__copy">
              <p class="cart-drawer-empty-upsell__title">{{ heading | escape }}</p>
              {%- if section.settings.cart_drawer_upsell_billing_note != blank -%}
                <p class="cart-drawer-empty-upsell__billing">
                  {{ section.settings.cart_drawer_upsell_billing_note | escape }}
                </p>
              {%- endif -%}
            </div>

            <div class="cart-drawer-empty-upsell__prices">
              {%- if price_override != blank -%}
                <span class="cart-drawer-empty-upsell__price">{{ price_override | escape }}</span>
              {%- else -%}
                <span class="cart-drawer-empty-upsell__price">{{ variant.price | money }}</span>
              {%- endif -%}

              {%- if compare_override != blank -%}
                <span class="cart-drawer-empty-upsell__compare">{{ compare_override | escape }}</span>
              {%- elsif variant.compare_at_price > variant.price -%}
                <span class="cart-drawer-empty-upsell__compare">{{ variant.compare_at_price | money }}</span>
              {%- endif -%}

              {%- if section.settings.cart_drawer_upsell_unit_note != blank -%}
                <span class="cart-drawer-empty-upsell__unit">
                  {{ section.settings.cart_drawer_upsell_unit_note | escape }}
                </span>
              {%- endif -%}
            </div>
          </div>

      <ul class="cart-drawer-empty-upsell__benefits" role="list">
        {%- for i in (1..5) -%}
        {%- assign icon_key = 'cart_drawer_upsell_line_' | append: i | append: '_icon' -%}
        {%- assign text_key = 'cart_drawer_upsell_line_' | append: i | append: '_text' -%}
          {%- assign benefit_icon = section.settings[icon_key] -%}
          {%- assign benefit_text = section.settings[text_key] -%}
          {%- if benefit_text != blank -%}
            <li class="cart-drawer-empty-upsell__benefit">
              <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
                {%- case benefit_icon -%}
                  {%- when 'truck' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="M10 17h4M6 17H4V6h12v4m0 0h3l2 3v4h-3M8 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm10 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
                    </svg>
                  {%- when 'return' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/>
                    </svg>
                  {%- when 'heart' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21.4l8.8-9a5.5 5.5 0 0 0 0-7.8z"/>
                    </svg>
                  {%- when 'check_circle' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>
                    </svg>
                  {%- when 'cancel' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/>
                    </svg>
                  {%- else -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <circle cx="12" cy="7" r="1"/><path d="M12 11v7"/>
                    </svg>
                {%- endcase -%}
              </span>
              <span class="cart-drawer-empty-upsell__benefit-text">{{ benefit_text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ upsell_product.id }}"
            data-product-url="{{ upsell_product.url }}"
            on:submit="/handleSubmit"
            data-quantity-default="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
            data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
            class="cart-drawer-empty-upsell__form-wrap"
          >
            <div
              class="visually-hidden"
              aria-live="assertive"
              role="status"
              aria-atomic="true"
              ref="liveRegion"
            ></div>
            {%- form 'product',
              upsell_product,
              id: product_form_id,
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              <input
                type="hidden"
                name="id"
                ref="variantId"
                value="{{ variant.id }}"
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
              <input
                type="hidden"
                name="quantity"
                value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
              >
              {% render 'add-to-cart-button',
                product: upsell_product,
                can_add_to_cart: can_add_to_cart,
                add_to_cart_text: btn_label,
                class: 'button cart-drawer-empty-upsell__submit',
                data_testid: 'cart-drawer-upsell-add',
                show_variant_price: false,
                show_shipping_blurb: false
              %}
            {%- endform -%}
          </product-form-component>
        </div>
      </div>
    </div>
  </div>
{%- elsif request.design_mode and section != blank and section.settings.cart_drawer_upsell_enable != false -%}
  <div
    class="cart-drawer-empty-upsell cart-drawer-empty-upsell--theme-editor-note"
    role="status"
  >
    <p class="cart-drawer-empty-upsell--theme-editor-note__text">
      {{ 'content.cart_drawer_upsell_theme_editor_hint' | t }}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-drawer-empty-upsell--theme-editor-note {
    flex-shrink: 0;
    margin: 0 var(--padding-lg, 1rem);
    padding: var(--padding-md, 0.75rem) var(--padding-lg, 1rem);
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: var(--style-border-radius-buttons, 10px);
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .cart-drawer-empty-upsell--theme-editor-note__text {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.85);
  }

  .cart-drawer-empty-upsell {
    flex-shrink: 0;
    width: 100%;
    text-align: left;
    background-color: var(--cd-cream, #fdf8f4);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06);
  }

  /* Banner sits flush at top of drawer — no rounding above promo strip */
  .cart-drawer-empty-upsell:has(.cart-drawer-empty-upsell__banner) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .cart-drawer-empty-upsell__banner {
    background-color: var(--cart-drawer-upsell-banner-bg, var(--cd-teal, #237b84));
    color: #fff;
    text-align: center;
    padding: var(--padding-md, 0.875rem) var(--padding-lg, 1rem);
    font-family: var(--cd-font, var(--font-heading--family));
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart-drawer-empty-upsell__body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .cart-drawer-empty-upsell__layout {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-lg, 1.25rem);
  }

  .cart-drawer-empty-upsell__media {
    flex: 0 0 27%;
    min-width: 4.5rem;
    max-width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .cart-drawer-empty-upsell__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart-drawer-empty-upsell__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-md, 0.75rem);
  }

  .cart-drawer-empty-upsell__copy {
    min-width: 0;
    flex: 1;
  }

  .cart-drawer-empty-upsell__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-drawer-empty-upsell__title {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.25;
  }

  .cart-drawer-empty-upsell__billing {
    margin: 0.25rem 0 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8125rem;
    color: #666;
    line-height: 1.4;
  }

  .cart-drawer-empty-upsell__prices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 0.125rem;
    text-align: right;
    min-width: 5rem;
  }

  .cart-drawer-empty-upsell__price {
    font-family: var(--font-body--family, sans-serif);
    font-size: var(--font-size--body-md, 1rem);
    font-weight: 700;
    color: #1a1a1a;
  }

  .cart-drawer-empty-upsell__compare {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8125rem;
    color: #888;
    text-decoration: line-through;
  }

  .cart-drawer-empty-upsell__unit {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.6875rem;
    color: #777;
    margin-top: 0.125rem;
  }

  .cart-drawer-empty-upsell__benefits {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-sm, 0.5rem) var(--gap-md, 0.75rem);
  }

  @media screen and (max-width: 400px) {
    .cart-drawer-empty-upsell__benefits {
      grid-template-columns: 1fr;
    }
  }

  .cart-drawer-empty-upsell__benefit {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    margin: 0;
  }

  .cart-drawer-empty-upsell__benefit-icon {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    color: #1a1a1a;
    margin-top: 0.1rem;
  }

  .cart-drawer-empty-upsell__benefit-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cart-drawer-empty-upsell__benefit-text {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.75rem;
    line-height: 1.35;
    color: #1a1a1a;
  }

  .cart-drawer-empty-upsell__form-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    margin-top: 0.125rem;
  }

  .cart-drawer-empty-upsell__form-wrap .custom-add-to-cart-wrapper {
    width: auto;
    max-width: 100%;
  }

  .cart-drawer-empty-upsell__form-wrap .custom-add-to-cart-shipping-text {
    display: none;
  }

  .cart-drawer-empty-upsell__form-wrap form {
    width: auto;
  }

  .cart-drawer-empty-upsell__submit {
    width: auto;
    max-width: 100%;
    border-radius: 999px;
    padding: 0.75rem 2.5rem;
    background: linear-gradient(90deg, #6b4162 0%, #3d1a34 100%);
    color: #fff;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    border: none;
    box-shadow: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .cart-drawer-empty-upsell__submit:hover:not(:disabled) {
    opacity: 0.9;
  }

  .cart-drawer-empty-upsell__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
{% endstylesheet %}
