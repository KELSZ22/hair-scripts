{%- doc -%}
  Promotional upsell below the empty-cart message in the drawer.
  Similar logic to product-page Recharge widget:
  - Uses hardcoded selling plan ID
  - Adds hidden selling_plan input
  - JS keeps selling_plan synced before add-to-cart
{%- enddoc -%}

{%- liquid
  assign upsell_product = section.settings.cart_drawer_upsell_product
  assign handle_fallback = section.settings.cart_drawer_upsell_product_handle | default: '' | strip

  if upsell_product == blank and handle_fallback != blank
    assign upsell_product = all_products[handle_fallback]
  endif

  assign show_upsell = false

  if section != blank and section.settings.cart_drawer_upsell_enable != false and upsell_product != blank
    assign show_upsell = true
  endif
-%}

{%- if show_upsell -%}
  {%- liquid
    assign variant = upsell_product.selected_or_first_available_variant

    assign heading = '90-Day Subscription'

    assign subscription_selling_plan_id = '2117107817'
    assign subscription_price_text = '$45/month'
    assign subscription_button_price_text = '$45.00'
    assign subscription_billing_note = 'Billed $135 every 12 weeks'
    assign subscription_unit_note = 'Save 34%'

    assign banner_bg = section.settings.cart_drawer_upsell_banner_color

    if banner_bg == blank or banner_bg == 'rgba(0,0,0,0)'
      assign banner_bg = '#237b84'
    endif

    assign upsell_image = section.settings.cart_drawer_upsell_image

    if upsell_image == blank
      assign upsell_image = upsell_product.featured_image
    endif

    if variant.available
      assign can_add_to_cart = true
    else
      assign can_add_to_cart = false
    endif

    assign btn_label = section.settings.cart_drawer_upsell_button_label

    if btn_label == blank
      assign btn_label = 'Add to Cart'
    endif

    assign product_form_id = 'CartDrawerUpsell-Form-' | append: section.id
    assign img_alt = upsell_image.alt | default: heading
  -%}

  <div
    class="cart-drawer-empty-upsell"
    data-cart-add-url="{{ routes.cart_add_url | append: '.js' }}"
    data-selling-plan-id="{{ subscription_selling_plan_id }}"
    data-variant-id="{{ variant.id }}"
  >
    {%- if section.settings.cart_drawer_upsell_banner_text != blank -%}
      <div
        class="cart-drawer-empty-upsell__banner"
        style="--cart-drawer-upsell-banner-bg: {{ banner_bg }};"
      >
        SAVE UP TO 34% OFF
      </div>
    {%- endif -%}

    <div class="cart-drawer-empty-upsell__body">
      <div class="cart-drawer-empty-upsell__layout">
        <div class="cart-drawer-empty-upsell__media">
          {%- if upsell_image != blank -%}
            {{
              upsell_image
              | image_url: width: 260
              | image_tag:
                loading: 'lazy',
                class: 'cart-drawer-empty-upsell__img',
                widths: '90, 120, 180, 260',
                sizes: '(min-width: 400px) 120px, 28vw',
                alt: img_alt
            }}
          {%- endif -%}
        </div>

        <div class="cart-drawer-empty-upsell__main">
          <div class="cart-drawer-empty-upsell__header">
            <div class="cart-drawer-empty-upsell__copy">
              <p class="cart-drawer-empty-upsell__title">
                {{ upsell_product.title | escape }}
              </p>

              <p class="cart-drawer-empty-upsell__billing">
                {{ heading | escape }}
              </p>

              <p class="cart-drawer-empty-upsell__billing">
                {{ subscription_billing_note | escape }}
              </p>
            </div>

            <div class="cart-drawer-empty-upsell__prices">
              <span class="cart-drawer-empty-upsell__price">
                {{ subscription_price_text }}
              </span>

              <span class="cart-drawer-empty-upsell__unit">
                {{ subscription_unit_note }}
              </span>
            </div>
          </div>
        </div>
      </div>

      <ul class="cart-drawer-empty-upsell__benefits" role="list">
        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M10 17h4M6 17H4V6h12v4m0 0h3l2 3v4h-3M8 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm10 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">FREE SHIPPING to USA</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <circle cx="12" cy="12" r="9"/>
              <path d="m8 12 2.5 2.5L16 9"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">Maximum Savings</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M9 14 4 9l5-5"/>
              <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">90-day money-back guarantee</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <circle cx="12" cy="12" r="9"/>
              <path d="m15 9-6 6M9 9l6 6"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">Cancel subscription anytime</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21.4l8.8-9a5.5 5.5 0 0 0 0-7.8z"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">Share with family and friends</span>
        </li>
      </ul>

      <div
        class="cart-drawer-empty-upsell__form-wrap"
        data-cart-drawer-upsell-product-id="{{ upsell_product.id }}"
      >
        {%- form 'product',
          upsell_product,
          id: product_form_id,
          class: 'shopify-product-form cart-drawer-empty-upsell__form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            value="{{ variant.id }}"
            {% unless variant.available %}
              disabled
            {% endunless %}
          >

          <input
            type="hidden"
            name="quantity"
            value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
          >

          <input
            type="hidden"
            name="selling_plan"
            value="{{ subscription_selling_plan_id }}"
            {% unless variant.available %}
              disabled
            {% endunless %}
          >

          <button
            type="submit"
            name="add"
            class="button cart-drawer-empty-upsell__submit"
            data-testid="cart-drawer-upsell-add"
            {% unless can_add_to_cart %}
              disabled
            {% endunless %}
          >
            Subscribe
          </button>
        {%- endform -%}
      </div>

      <div class="cart-drawer-empty-upsell__status" hidden></div>

     <script>
  (function() {
    if (window.__cartDrawerEmptyUpsellAjaxBoundV6 === true) return;
    window.__cartDrawerEmptyUpsellAjaxBoundV6 = true;

    var DRAWER_SELECTORS = [
      'cart-drawer-component',
      'cart-drawer',
      '#CartDrawer',
      '#cart-drawer',
      '.cart-drawer',
      '[data-cart-drawer]'
    ];

    var BUBBLE_SELECTORS = [
      '#cart-icon-bubble',
      '[data-cart-icon-bubble]',
      '.cart-count-bubble',
      '.header__cart-count',
      '[data-cart-count]'
    ];

    function findFirst(root, selectors) {
      for (var i = 0; i < selectors.length; i++) {
        var el = root.querySelector(selectors[i]);

        if (el) {
          return {
            el: el,
            selector: selectors[i]
          };
        }
      }

      return {
        el: null,
        selector: ''
      };
    }

    function getCartDrawer() {
      return findFirst(document, DRAWER_SELECTORS).el;
    }

    function getWrapperFromForm(form) {
      return form ? form.closest('.cart-drawer-empty-upsell') : null;
    }

    function getFormFromTarget(target) {
      if (!target || !target.closest) return null;

      var button = target.closest('.cart-drawer-empty-upsell__submit');

      if (button) {
        return button.closest('.cart-drawer-empty-upsell__form');
      }

      if (target.matches && target.matches('.cart-drawer-empty-upsell__form')) {
        return target;
      }

      return null;
    }

    function showStatus(wrapper, type, message) {
      var statusEl = wrapper ? wrapper.querySelector('.cart-drawer-empty-upsell__status') : null;
      if (!statusEl) return;

      statusEl.hidden = false;
      statusEl.classList.remove('is-error', 'is-success');

      if (type === 'error') statusEl.classList.add('is-error');
      if (type === 'success') statusEl.classList.add('is-success');

      statusEl.textContent = message;
    }

    function getSellingPlanInput(form) {
      return form.querySelector('input[name="selling_plan"]');
    }

    function ensureSellingPlanInput(form) {
      var sellingPlanInput = getSellingPlanInput(form);

      if (!sellingPlanInput) {
        sellingPlanInput = document.createElement('input');
        sellingPlanInput.type = 'hidden';
        sellingPlanInput.name = 'selling_plan';
        form.appendChild(sellingPlanInput);
      }

      return sellingPlanInput;
    }

    function syncSellingPlanInput(form, wrapper) {
      var sellingPlanInput = ensureSellingPlanInput(form);
      var sellingPlanId = wrapper ? wrapper.dataset.sellingPlanId : '';

      if (sellingPlanId) {
        sellingPlanInput.disabled = false;
        sellingPlanInput.value = sellingPlanId;
      } else {
        sellingPlanInput.value = '';
        sellingPlanInput.disabled = true;
      }
    }

    function setLoading(button, isLoading) {
      if (!button) return;

      if (isLoading) {
        button.disabled = true;
        button.classList.add('is-loading');

        if (!button.dataset.originalText) {
          button.dataset.originalText = button.textContent.trim();
        }

        button.textContent = 'Adding...';
      } else {
        button.disabled = false;
        button.classList.remove('is-loading');

        if (button.dataset.originalText) {
          button.textContent = button.dataset.originalText;
        }
      }
    }

    function buildFormData(form, wrapper) {
      syncSellingPlanInput(form, wrapper);

      var formData = new FormData();

      var idInput = form.querySelector('input[name="id"]');
      var quantityInput = form.querySelector('input[name="quantity"]');
      var sellingPlanInput = getSellingPlanInput(form);

      if (!idInput || !idInput.value) {
        throw new Error('Missing variant ID.');
      }

      formData.set('id', idInput.value);
      formData.set('quantity', quantityInput && quantityInput.value ? quantityInput.value : '1');

      if (sellingPlanInput && sellingPlanInput.value) {
        formData.set('selling_plan', sellingPlanInput.value);
      }

      console.log('Upsell AJAX add data:');

      for (var pair of formData.entries()) {
        console.log(pair[0] + ':', pair[1]);
      }

      return formData;
    }

    function fetchCart() {
      return fetch('/cart.js', {
        method: 'GET',
        credentials: 'same-origin',
        headers: {
          Accept: 'application/json'
        }
      }).then(function(response) {
        if (!response.ok) {
          throw new Error('Unable to fetch cart JSON.');
        }

        return response.json();
      });
    }

    function fetchFreshPageHTML() {
      var url = window.location.pathname;

      if (window.location.search) {
        url += window.location.search + '&_cart_refresh=' + Date.now();
      } else {
        url += '?_cart_refresh=' + Date.now();
      }

      return fetch(url, {
        method: 'GET',
        credentials: 'same-origin',
        headers: {
          Accept: 'text/html'
        }
      }).then(function(response) {
        if (!response.ok) {
          throw new Error('Unable to fetch updated page HTML.');
        }

        return response.text();
      });
    }

    function parseHTML(html) {
      return new DOMParser().parseFromString(html, 'text/html');
    }

    function replaceCartDrawerFromHTML(html) {
      var doc = parseHTML(html);

      var currentMatch = findFirst(document, DRAWER_SELECTORS);
      var freshMatch = findFirst(doc, DRAWER_SELECTORS);

      if (!currentMatch.el || !freshMatch.el) {
        throw new Error('Could not find cart drawer HTML to refresh.');
      }

      var freshDrawer = freshMatch.el;

      currentMatch.el.replaceWith(freshDrawer);

      freshDrawer.setAttribute('open', '');
      freshDrawer.removeAttribute('hidden');
      freshDrawer.classList.add('active', 'is-open', 'drawer--is-open', 'animate');

      console.log('Cart drawer replaced using selector:', currentMatch.selector);

      return freshDrawer;
    }

    function replaceCartBubbleFromHTML(html) {
      var doc = parseHTML(html);

      BUBBLE_SELECTORS.forEach(function(selector) {
        var currentEls = document.querySelectorAll(selector);
        var freshEls = doc.querySelectorAll(selector);

        currentEls.forEach(function(currentEl, index) {
          var freshEl = freshEls[index] || freshEls[0];

          if (currentEl && freshEl) {
            currentEl.innerHTML = freshEl.innerHTML;
          }
        });
      });
    }

    function updateCartCount(cart) {
      if (!cart || typeof cart.item_count === 'undefined') return;

      var countEls = document.querySelectorAll(
        '[data-cart-count], .cart-count-bubble span, #cart-icon-bubble span, .header__cart-count'
      );

      countEls.forEach(function(el) {
        el.textContent = cart.item_count;
      });
    }

    function openSideCartOnly() {
      var cartDrawer = getCartDrawer();

      if (!cartDrawer) {
        console.warn('Cart drawer element not found after refresh.');
        return;
      }

      if (typeof cartDrawer.open === 'function') {
        cartDrawer.open();
      }

      if (typeof cartDrawer.show === 'function') {
        cartDrawer.show();
      }

      cartDrawer.setAttribute('open', '');
      cartDrawer.removeAttribute('hidden');
      cartDrawer.classList.add('active', 'is-open', 'drawer--is-open', 'animate');

      document.body.classList.add('overflow-hidden', 'cart-drawer-open');
      document.documentElement.classList.add('cart-drawer-open');
    }

    function publishCartEvents(cart, addedData) {
      var detail = {
        source: 'cart-drawer-empty-upsell',
        cart: cart,
        item: addedData
      };

      document.dispatchEvent(new CustomEvent('cart:refresh', {
        bubbles: true,
        detail: detail
      }));

      document.dispatchEvent(new CustomEvent('cart:updated', {
        bubbles: true,
        detail: detail
      }));

      document.dispatchEvent(new CustomEvent('cart:update', {
        bubbles: true,
        detail: detail
      }));

      window.dispatchEvent(new CustomEvent('cart:updated', {
        detail: detail
      }));
    }

    function verifyCartItem(cart, wrapper) {
      if (!cart || !Array.isArray(cart.items) || !wrapper) return;

      var expectedSellingPlanId = Number(wrapper.dataset.sellingPlanId);

      var subscriptionItem = cart.items.find(function(item) {
        var itemSellingPlanId =
          item.selling_plan_allocation &&
          item.selling_plan_allocation.selling_plan &&
          item.selling_plan_allocation.selling_plan.id;

        return Number(itemSellingPlanId) === expectedSellingPlanId;
      });

      if (!subscriptionItem) {
        console.error('Selling plan was sent, but no matching selling_plan_allocation was found in cart.');
        return;
      }

      console.log('Subscription item found in cart:', {
        product_title: subscriptionItem.product_title,
        variant_id: subscriptionItem.variant_id,
        final_price: subscriptionItem.final_price,
        original_price: subscriptionItem.original_price,
        line_price: subscriptionItem.line_price,
        final_line_price: subscriptionItem.final_line_price,
        selling_plan_allocation: subscriptionItem.selling_plan_allocation
      });
    }

    function refreshOnlySideCart(cart, addedData, wrapper) {
      return fetchFreshPageHTML()
        .then(function(html) {
          replaceCartDrawerFromHTML(html);
          replaceCartBubbleFromHTML(html);
          updateCartCount(cart);
          publishCartEvents(cart, addedData);
          openSideCartOnly();
          verifyCartItem(cart, wrapper);
        });
    }

    function addToCart(form) {
      var wrapper = getWrapperFromForm(form);
      var button = form ? form.querySelector('[type="submit"], button[name="add"]') : null;

      if (!form || !wrapper || !button) return;
      if (form.dataset.cartDrawerUpsellAdding === 'true') return;

      var formData;

      try {
        syncSellingPlanInput(form, wrapper);
        formData = buildFormData(form, wrapper);
      } catch (error) {
        console.error('Upsell error:', error);
        showStatus(wrapper, 'error', error.message);
        return;
      }

      form.dataset.cartDrawerUpsellAdding = 'true';
      setLoading(button, true);
      showStatus(wrapper, 'success', 'Adding subscription to cart...');

      fetch(wrapper.dataset.cartAddUrl || '/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          Accept: 'application/json'
        },
        body: formData
      })
        .then(function(response) {
          return response.json().then(function(data) {
            if (!response.ok) {
              console.error('Add to cart error:', data);
              throw new Error(data.description || data.message || 'Unable to add item to cart.');
            }

            return data;
          });
        })
        .then(function(addedData) {
          return fetchCart().then(function(cart) {
            console.log('Added item:', addedData);
            console.log('Cart after add:', cart);

            return refreshOnlySideCart(cart, addedData, wrapper);
          });
        })
        .catch(function(error) {
          console.error('Upsell AJAX error:', error);
          showStatus(wrapper, 'error', error.message || 'Unable to add item to cart.');
        })
        .finally(function() {
          form.dataset.cartDrawerUpsellAdding = 'false';
          setLoading(button, false);
        });
    }

    function prepareAllForms() {
      var forms = document.querySelectorAll('.cart-drawer-empty-upsell__form');

      forms.forEach(function(form) {
        var wrapper = getWrapperFromForm(form);
        if (!wrapper) return;

        form.setAttribute('data-ajax-cart-upsell', 'true');
        form.setAttribute('action', wrapper.dataset.cartAddUrl || '/cart/add.js');

        ensureSellingPlanInput(form);
        syncSellingPlanInput(form, wrapper);
      });
    }

    document.addEventListener('click', function(event) {
      var button = event.target.closest('.cart-drawer-empty-upsell__submit');
      if (!button) return;

      var form = button.closest('.cart-drawer-empty-upsell__form');
      if (!form) return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      addToCart(form);
    }, true);

    document.addEventListener('submit', function(event) {
      var form = getFormFromTarget(event.target);
      if (!form) return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      addToCart(form);
    }, true);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', prepareAllForms);
    } else {
      prepareAllForms();
    }

    document.addEventListener('shopify:section:load', prepareAllForms);
    document.addEventListener('cart:updated', prepareAllForms);
    document.addEventListener('cart:update', prepareAllForms);
  })();
</script>
    </div>
  </div>
{%- elsif request.design_mode and section != blank and section.settings.cart_drawer_upsell_enable != false -%}
  <div
    class="cart-drawer-empty-upsell cart-drawer-empty-upsell--theme-editor-note"
    role="status"
  >
    <p class="cart-drawer-empty-upsell--theme-editor-note__text">
      {{ 'content.cart_drawer_upsell_theme_editor_hint' | t }}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-drawer-empty-upsell--theme-editor-note {
    flex-shrink: 0;
    margin: 0 var(--padding-lg, 1rem);
    padding: var(--padding-md, 0.75rem) var(--padding-lg, 1rem);
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: var(--style-border-radius-buttons, 10px);
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .cart-drawer-empty-upsell--theme-editor-note__text {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.85);
  }

  .cart-drawer-empty-upsell {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 100%;
    text-align: left;
    background-color: var(--cd-cream, #fdf8f4);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06);
    container-type: inline-size;
    container-name: drawer-upsell;
  }

  .cart-drawer-empty-upsell:has(.cart-drawer-empty-upsell__banner) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .cart-drawer-empty-upsell__banner {
    background-color: var(--cart-drawer-upsell-banner-bg, var(--cd-teal, #237b84));
    color: #fff;
    text-align: center;
    padding: var(--padding-md, 0.875rem) var(--padding-lg, 1rem);
    font-family: var(--cd-font, var(--font-heading--family));
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cart-drawer-empty-upsell__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart-drawer-empty-upsell__layout {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-lg, 1.25rem);
  }

  .cart-drawer-empty-upsell__media {
    flex: 0 0 27%;
    min-width: 4.5rem;
    max-width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .cart-drawer-empty-upsell__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart-drawer-empty-upsell__header {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    min-width: 0;
  }

  .cart-drawer-empty-upsell__copy {
    min-width: 0;
  }

  .cart-drawer-empty-upsell__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-drawer-empty-upsell__title {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
