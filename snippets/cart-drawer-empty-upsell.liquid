{%- doc -%}
  Promotional upsell below the empty-cart message in the drawer.
{%- enddoc -%}

{%- liquid
  assign upsell_product = section.settings.cart_drawer_upsell_product
  assign handle_fallback = section.settings.cart_drawer_upsell_product_handle | default: '' | strip

  if upsell_product == blank and handle_fallback != blank
    assign upsell_product = all_products[handle_fallback]
  endif

  assign show_upsell = false

  if section != blank and section.settings.cart_drawer_upsell_enable != false and upsell_product != blank
    assign show_upsell = true
  endif
-%}

{%- if show_upsell -%}
  {%- liquid
    assign variant = upsell_product.selected_or_first_available_variant

    assign heading = '90-Day Subscription'

    assign subscription_selling_plan_id = '2124218473'
    assign subscription_price_text = '$45/month'
    assign subscription_button_price_text = '$45.00'
    assign subscription_billing_note = 'Billed $135 every 12 weeks'
    assign subscription_unit_note = 'Save 34%'

    assign banner_bg = section.settings.cart_drawer_upsell_banner_color

    if banner_bg == blank or banner_bg == 'rgba(0,0,0,0)'
      assign banner_bg = '#237b84'
    endif

    assign upsell_image = section.settings.cart_drawer_upsell_image

    if upsell_image == blank
      assign upsell_image = upsell_product.featured_image
    endif

    if variant.available
      assign can_add_to_cart = true
    else
      assign can_add_to_cart = false
    endif

    assign btn_label = section.settings.cart_drawer_upsell_button_label

    if btn_label == blank
      assign btn_label = 'Add to Cart'
    endif

    assign product_form_id = 'CartDrawerUpsell-Form-' | append: section.id
    assign img_alt = upsell_image.alt | default: heading
  -%}

  <div
    class="cart-drawer-empty-upsell"
    data-cart-add-url="{{ routes.cart_add_url | append: '.js' }}"
    data-selling-plan-id="{{ subscription_selling_plan_id }}"
    data-variant-id="43232223789161"
  >
    {%- if section.settings.cart_drawer_upsell_banner_text != blank -%}
      <div
        class="cart-drawer-empty-upsell__banner"
        style="--cart-drawer-upsell-banner-bg: {{ banner_bg }};"
      >
        SAVE UP TO 34% OFF
      </div>
    {%- endif -%}

    <div class="cart-drawer-empty-upsell__body">
      <div class="cart-drawer-empty-upsell__layout">
        <div class="cart-drawer-empty-upsell__media">
          {%- if upsell_image != blank -%}
            {{
              upsell_image
              | image_url: width: 260
              | image_tag:
                loading: 'lazy',
                class: 'cart-drawer-empty-upsell__img',
                widths: '90, 120, 180, 260',
                sizes: '(min-width: 400px) 120px, 28vw',
                alt: img_alt
            }}
          {%- endif -%}
        </div>

        <div class="cart-drawer-empty-upsell__main">
          <div class="cart-drawer-empty-upsell__header">
            <div class="cart-drawer-empty-upsell__copy">
              <p class="cart-drawer-empty-upsell__title">
                {{ upsell_product.title | escape }}
              </p>

              <p class="cart-drawer-empty-upsell__billing">
                {{ heading | escape }}
              </p>

              <p class="cart-drawer-empty-upsell__billing">
                {{ subscription_billing_note | escape }}
              </p>
            </div>

            <div class="cart-drawer-empty-upsell__prices">
              <span class="cart-drawer-empty-upsell__price"></span>
              <span class="cart-drawer-empty-upsell__unit">
                {{ subscription_unit_note }}
              </span>
            </div>
          </div>
        </div>
      </div>

      <ul class="cart-drawer-empty-upsell__benefits" role="list">
        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M10 17h4M6 17H4V6h12v4m0 0h3l2 3v4h-3M8 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm10 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">FREE SHIPPING to USA</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <circle cx="12" cy="12" r="9"/>
              <path d="m8 12 2.5 2.5L16 9"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">Maximum Savings</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M9 14 4 9l5-5"/>
              <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">90-day money-back guarantee</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <circle cx="12" cy="12" r="9"/>
              <path d="m15 9-6 6M9 9l6 6"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">Cancel subscription anytime</span>
        </li>

        <li class="cart-drawer-empty-upsell__benefit">
          <span class="cart-drawer-empty-upsell__benefit-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21.4l8.8-9a5.5 5.5 0 0 0 0-7.8z"/>
            </svg>
          </span>
          <span class="cart-drawer-empty-upsell__benefit-text">Share with family and friends</span>
        </li>
      </ul>

      <div
        class="cart-drawer-empty-upsell__form-wrap"
        data-cart-drawer-upsell-product-id="{{ upsell_product.id }}"
      >
        {% comment %}
          ORIGINAL SUBSCRIBE BUTTON - TEMPORARILY DISABLED

        <button
          type="button"
          class="button cart-drawer-empty-upsell__submit"
          data-testid="cart-drawer-upsell-add"
          {% unless can_add_to_cart %}disabled{% endunless %}
        >
          Subscribe
        </button>
        {% endcomment %}

        <button
          type="button"
          class="button cart-drawer-empty-upsell__submit cart-drawer-empty-upsell__sold-out-button"
          disabled
          aria-disabled="true"
        >
          Sold out
        </button>
      </div>

      <div class="cart-drawer-empty-upsell__status" hidden></div>
    </div>
  </div>

  <script>
  (function() {
    if (window.__cartDrawerEmptyUpsellAjaxBoundV8 === true) return;
    window.__cartDrawerEmptyUpsellAjaxBoundV8 = true;

    var UPSELL_VARIANT_ID = 43232223789161;
    var UPSELL_PLAN_ID    = 2124218473;
    var UPSELL_QTY        = 1;
    var IMG_SRC           = '//bevyscripts.com/cdn/shop/files/2_9ca31d72-534f-49c8-891a-640bc47b1731.png?v=1778765354&width=250';
    var ITEM_HREF         = '/products/hairscripts-by-bevy-supplement-90-days?selling_plan=2124218473&variant=43232223789161';
    var ITEM_TITLE        = 'HairScripts by Bevy Supplement - 90 Days';
    var ITEM_VARIANT      = '90-day subscription';
    var ITEM_PRICE        = '$135.00';
    var ITEM_COMPARE      = '$207.00';
    var ITEM_SAVE         = 'SAVE 34%';

    var isAdding  = false;
    var guardObs  = null;

    function getCartWrapper() {
      return document.querySelector('cart-items-component .cart-items__wrapper')
          || document.querySelector('.cart-items__wrapper');
    }

    function buildFakeCartHTML() {
      return [
        '<span class="visually-hidden" ref="cartItemCount" aria-hidden="true">1</span>',
        '<form action="/cart" class="cart-form" id="cart-form-ghost" method="post">',
          '<div class="cart-items spacing-style" style="--cart-items-gap:px;">',
            '<table class="cart-items__table" role="table">',
              '<caption class="visually-hidden" role="caption">Cart total <span>' + ITEM_PRICE + ' USD</span></caption>',
              '<thead class="visually-hidden" role="rowgroup">',
                '<tr role="row" class="cart-items__table-row">',
                  '<th id="productImage" scope="col" role="columnheader">Product image</th>',
                  '<th id="productInformation" scope="col" role="columnheader">Product information</th>',
                  '<th id="quantity" scope="col" role="columnheader">Quantity</th>',
                  '<th id="productTotal" scope="col" role="columnheader">Product total</th>',
                '</tr>',
              '</thead>',
              '<tbody role="rowgroup">',
                '<tr role="row" class="cart-items__table-row cart-items__table-row--full-width-variants" data-rc-ghost="1">',
                  '<td class="cart-items__media" role="cell" headers="productImage">',
                    '<a href="' + ITEM_HREF + '" class="cart-items__media-container" style="--ratio:1;">',
                      '<img src="' + IMG_SRC + '" alt="" width="250" height="250" class="cart-items__media-image border-style" style="--border-width:1px;--border-style:none;--border-color:rgba(0,0,0,0.5);--border-radius:0px;">',
                    '</a>',
                  '</td>',
                  '<td class="cart-items__details cart-primary-typography" role="cell" headers="productInformation">',
                    '<div class="cart-items__product-info">',
                      '<p><a href="' + ITEM_HREF + '" class="cart-items__title">' + ITEM_TITLE + '</a></p>',
                    '</div>',
                    '<div class="cart-items__variants-wrapper"><p>' + ITEM_VARIANT + '</p></div>',
                    '<div class="cart-items__unit-price-wrapper">',
                      '<div>',
                        '<span>' + ITEM_PRICE + '</span>',
                        '<s class="compare-at-price">' + ITEM_COMPARE + '</s>',
                        '<span class="cart-items__save-badge">' + ITEM_SAVE + '</span>',
                      '</div>',
                    '</div>',
                  '</td>',
                  '<td class="cart-items__quantity" role="cell" headers="quantity">',
                    '<div class="cart-items__quantity-controls">',
                      '<div class="quantity-selector-wrapper">',
                        '<div class="quantity-selector cart-primary-typography" style="display:flex;align-items:center;gap:8px;">',
                          '<button class="button quantity-minus button-unstyled" type="button" disabled>−</button>',
                          '<input type="number" value="1" min="1" aria-label="Quantity" style="width:36px;text-align:center;" readonly>',
                          '<button class="button quantity-plus button-unstyled" type="button">+</button>',
                        '</div>',
                      '</div>',
                    '</div>',
                  '</td>',
                  '<td class="cart-items__price cart-secondary-typography" role="cell" headers="productTotal">',
                    '<text-component value="' + ITEM_PRICE + '">' + ITEM_PRICE + '</text-component>',
                  '</td>',
                '</tr>',
              '</tbody>',
            '</table>',
          '</div>',
        '</form>'
      ].join('');
    }

    function enforceFilledState() {
      document.querySelectorAll('.js-cart-drawer-empty').forEach(function(el) {
        el.setAttribute('hidden', '');
        el.style.setProperty('display', 'none', 'important');
      });

      document.querySelectorAll('.js-cart-drawer-filled').forEach(function(el) {
        el.removeAttribute('hidden');
        el.style.removeProperty('display');
      });

      var finalEl = document.querySelector('.cart-drawer__totals-final');

      if (finalEl) finalEl.textContent = ITEM_PRICE;
    }

    function injectGhost() {
      var wrapper = getCartWrapper();

      if (!wrapper) return;

      wrapper.innerHTML = buildFakeCartHTML();
      enforceFilledState();
    }

    function stopGuard() {
      if (guardObs) {
        guardObs.disconnect();
        guardObs = null;
      }
    }

    function startGuard() {
      stopGuard();

      var target = document.querySelector('cart-items-component') || document.body;

      guardObs = new MutationObserver(function() {
        if (!isAdding) return;

        enforceFilledState();

        var wrapper = getCartWrapper();

        if (wrapper && !wrapper.querySelector('[data-rc-ghost]') && !wrapper.querySelector('.cart-form:not(#cart-form-ghost)')) {
          wrapper.innerHTML = buildFakeCartHTML();
        }
      });

      guardObs.observe(target, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['hidden']
      });
    }

    function setCartCount(n) {
      document.querySelectorAll(
        '.js-cart-drawer-count,[data-cart-count],.cart-count-bubble span,.cart-count,#cart-icon-bubble span,.cart-count-bubble'
      ).forEach(function(el) {
        el.textContent = n;
      });
    }

    function getCurrentCartCount() {
      var el = document.querySelector('.js-cart-drawer-count');

      return el ? (parseInt(el.textContent.trim(), 10) || 0) : 0;
    }

    function openCartDrawerElement() {
      var cdc = document.querySelector('cart-drawer-component');

      if (!cdc) return;

      if (typeof cdc.open === 'function') {
        cdc.open();
      } else {
        cdc.removeAttribute('hidden');
        cdc.setAttribute('open', '');
        cdc.classList.add('is-open', 'active');
      }

      document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
    }

    function refreshCartFromServer() {
      var cic = document.querySelector('cart-items-component[data-drawer]');

      var sid = cic
        ? cic.getAttribute('data-section-id')
        : 'sections--19054444937321__header_section';

      fetch('/?sections=' + sid)
        .then(function(r) {
          return r.json();
        })
        .then(function(data) {
          var html = data[sid] || data[Object.keys(data)[0]];

          if (!html) return;

          var doc   = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.querySelector('cart-items-component[data-drawer]');
          var live  = document.querySelector('cart-items-component[data-drawer]');

          if (fresh && live) {
            stopGuard();
            isAdding = false;
            live.innerHTML = fresh.innerHTML;
          }
        })
        .catch(function() {
          stopGuard();
          isAdding = false;
        })
        .finally(function() {
          fetch('/cart.js')
            .then(function(r) {
              return r.json();
            })
            .then(function(cart) {
              setCartCount(cart.item_count);

              document.dispatchEvent(new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  data: {
                    itemCount: cart.item_count,
                    source: 'product-form-component'
                  }
                }
              }));

              import('@theme/events')
                .then(function(m) {
                  document.dispatchEvent(new m.CartUpdateEvent(cart, 'manual-trigger', {
                    itemCount: cart.item_count,
                    source: 'rc-upsell-widget',
                    sections: {}
                  }));
                })
                .catch(function() {});
            });
        });
    }

    function showStatus(wrapper, type, message) {
      var statusEl = wrapper ? wrapper.querySelector('.cart-drawer-empty-upsell__status') : null;

      if (!statusEl) return;

      statusEl.hidden = false;
      statusEl.classList.remove('is-error', 'is-success');
      statusEl.classList.add(type === 'error' ? 'is-error' : 'is-success');
      statusEl.textContent = message;
    }

    function setLoading(button, loading) {
      if (!button) return;

      if (loading) {
        button.disabled = true;
        button.classList.add('is-loading');

        if (!button.dataset.originalText) {
          button.dataset.originalText = button.textContent.trim();
        }

        button.textContent = 'Adding...';
      } else {
        button.disabled = false;
        button.classList.remove('is-loading');

        if (button.dataset.originalText) {
          button.textContent = button.dataset.originalText;
        }
      }
    }

    function addToCartAjax(button, wrapper) {
      if (isAdding) return;

      isAdding = true;

      setLoading(button, true);
      showStatus(wrapper, 'success', 'Adding subscription to cart...');

      setCartCount(getCurrentCartCount() + UPSELL_QTY);

      injectGhost();
      startGuard();
      openCartDrawerElement();

      fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          items: [{
            id: UPSELL_VARIANT_ID,
            quantity: UPSELL_QTY,
            selling_plan: UPSELL_PLAN_ID
          }]
        })
      })
      .then(function(res) {
        if (!res.ok) {
          return res.json().then(function(d) {
            throw new Error(d.description || d.message || 'Could not add to cart.');
          });
        }

        return res.json();
      })
      .then(function() {
        showStatus(wrapper, 'success', 'Added to cart!');
        refreshCartFromServer();

        setTimeout(function() {
          var statusEl = wrapper ? wrapper.querySelector('.cart-drawer-empty-upsell__status') : null;

          if (statusEl) statusEl.hidden = true;
        }, 3000);
      })
      .catch(function(err) {
        stopGuard();
        isAdding = false;
        setCartCount(Math.max(0, getCurrentCartCount() - UPSELL_QTY));
        showStatus(wrapper, 'error', err.message || 'Error adding to cart. Please try again.');
      })
      .finally(function() {
        button.dataset.adding = 'false';
        setLoading(button, false);
      });
    }

    document.addEventListener('click', function(event) {
      var button = event.target.closest('.cart-drawer-empty-upsell__submit');

      if (!button) return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      var wrapper = button.closest('.cart-drawer-empty-upsell');

      addToCartAjax(button, wrapper);
    }, true);

  })();
  </script>

{%- elsif request.design_mode and section != blank and section.settings.cart_drawer_upsell_enable != false -%}
  <div
    class="cart-drawer-empty-upsell cart-drawer-empty-upsell--theme-editor-note"
    role="status"
  >
    <p class="cart-drawer-empty-upsell--theme-editor-note__text">
      {{ 'content.cart_drawer_upsell_theme_editor_hint' | t }}
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-drawer-empty-upsell--theme-editor-note {
    flex-shrink: 0;
    margin: 0 var(--padding-lg, 1rem);
    padding: var(--padding-md, 0.75rem) var(--padding-lg, 1rem);
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: var(--style-border-radius-buttons, 10px);
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .cart-drawer-empty-upsell--theme-editor-note__text {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.85);
  }

  .cart-drawer-empty-upsell {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 100%;
    text-align: left;
    background-color: var(--cd-cream, #fdf8f4);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.06);
    container-type: inline-size;
    container-name: drawer-upsell;
  }

  .cart-drawer-empty-upsell:has(.cart-drawer-empty-upsell__banner) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .cart-drawer-empty-upsell__banner {
    background-color: var(--cart-drawer-upsell-banner-bg, var(--cd-teal, #237b84));
    color: #fff;
    text-align: center;
    padding: var(--padding-md, 0.875rem) var(--padding-lg, 1rem);
    font-family: var(--cd-font, var(--font-heading--family));
    font-size: clamp(0.875rem, 2.5vw, 1.125rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: none;
  }

  .cart-drawer-empty-upsell__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: none;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart-drawer-empty-upsell__layout {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-lg, 1.25rem);
  }

  .cart-drawer-empty-upsell__media {
    flex: 0 0 27%;
    min-width: 4.5rem;
    max-width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .cart-drawer-empty-upsell__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart-drawer-empty-upsell__header {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    min-width: 0;
  }

  .cart-drawer-empty-upsell__copy {
    min-width: 0;
  }

  .cart-drawer-empty-upsell__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-drawer-empty-upsell__title {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.25;
  }

  .cart-drawer-empty-upsell__billing {
    margin: 0.25rem 0 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8125rem;
    color: #666;
    line-height: 1.4;
  }

  .cart-drawer-empty-upsell__prices {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0;
    min-width: 0;
  }

  .cart-drawer-empty-upsell__price {
    font-family: var(--font-body--family, sans-serif);
    font-size: var(--font-size--body-md, 1rem);
    font-weight: 700;
    color: #1a1a1a;
  }

  .cart-drawer-empty-upsell__unit {
    flex-basis: 100%;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.75rem;
    color: #c0392b;
    font-weight: 600;
  }

  .cart-drawer-empty-upsell__benefits {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    display: grid;
    width: 100%;
    box-sizing: border-box;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap-sm, 0.5rem) var(--gap-md, 0.75rem);
  }

  .cart-drawer-empty-upsell__benefit {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    margin: 0;
    min-width: 0;
  }

  .cart-drawer-empty-upsell__benefit-icon {
    flex-shrink: 0;
    color: #1a1a1a;
  }

  .cart-drawer-empty-upsell__benefit-icon svg {
    display: block;
    width: 12px;
    height: 12px;
  }

  .cart-drawer-empty-upsell__benefit-text {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.75rem;
    line-height: 1.35;
    color: #1a1a1a;
  }

  .cart-drawer-empty-upsell__form-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .cart-drawer-empty-upsell__submit {
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.75rem 2.5rem;
    background: linear-gradient(90deg, #6b4162 0%, #3d1a34 100%);
    color: #fff;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    border: none;
    box-shadow: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .cart-drawer-empty-upsell__submit:hover:not(:disabled) {
    opacity: 0.9;
  }

  .cart-drawer-empty-upsell__submit:disabled,
  .cart-drawer-empty-upsell__submit.is-loading {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cart-drawer-empty-upsell__sold-out-button,
  .cart-drawer-empty-upsell__sold-out-button:hover,
  .cart-drawer-empty-upsell__sold-out-button:focus,
  .cart-drawer-empty-upsell__sold-out-button:disabled {
    background: linear-gradient(90deg, #725270 0% 42.83%, #371834) !important;
    color: #ffffff !important;
    opacity: 0.5 !important;
    cursor: not-allowed !important;
    pointer-events: auto !important;
  }

  .cart-drawer-empty-upsell__status {
    padding: 10px 14px;
    border-radius: 8px;
    font-family: var(--font-body--family, sans-serif);
    font-size: 13px;
    line-height: 1.4;
  }

  .cart-drawer-empty-upsell__status.is-error {
    background: #fff0f0;
    color: #c0392b;
    border: 1px solid #f5c6c6;
  }

  .cart-drawer-empty-upsell__status.is-success {
    background: #f0faf6;
    color: #27ae60;
    border: 1px solid #b2dfcc;
  }

  @container drawer-upsell (max-width: 31.25rem) {
    .cart-drawer-empty-upsell__body {
      padding: 1rem 1rem 1.25rem;
      background-color: #fff9f4;
    }

    .cart-drawer-empty-upsell__benefits {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
