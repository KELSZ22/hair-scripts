{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {object} [block] - The block

  @example
  {% render 'button', block: block %}
{%- enddoc -%}

{% assign block_settings = block.settings %}

<div class="button-container">
  <a
    {% if block_settings.link == blank %}
      role="link"
      aria-disabled="true"
    {% else %}
      href="{{ block_settings.link }}"
    {% endif %}
    class="
      size-style
      {{ block_settings.style_class }}
      {{ block_settings.style_class }}--{{ block.id }}
    "
    style="{% render 'size-style', settings: block_settings %}"
    {%- if block_settings.open_in_new_tab -%}
      target="_blank"
      rel="noopener noreferrer"
    {%- endif -%}
    {{ block.shopify_attributes }}
  >
    {{ block_settings.label }}
  </a>

  <a
    {% if block_settings.link2 == blank %}
      role="link"
      aria-disabled="true"
    {% else %}
      href="{{ block_settings.link2 }}"
    {% endif %}
    class="
      size-style
      {{ block_settings.style_class2 }}
      {{ block_settings.style_class2 }}--{{ block.id }}
    "
    style="{% render 'size-style', settings: block_settings %}"
    {%- if block_settings.open_in_new_tab -%}
      target="_blank"
      rel="noopener noreferrer"
    {%- endif -%}
    {{ block.shopify_attributes }}
  >
    {{ block_settings.label2 }}
  </a>
</div>

{% stylesheet %}
a.size-style.button {
    color: #fff;
    border-radius: 54px;
    background: #237B84;
}
a.size-style.button-secondary {
    color: #fff;
    border-radius: 54px;
    background: transparent;
    border-radius: 54px;
    border: 1px solid #FFF9F4;
}
a.size-style {
    font-family: Fustat;
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
    padding: 15px 21px;
}
  .button-container {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .link {
    text-decoration: none;
    text-decoration-color: currentcolor;
  }

  .link:hover {
    color: var(--color-primary-hover);
    text-decoration-color: transparent;
  }
{% endstylesheet %}