<section
  id="hs-growth-timeline-{{ section.id }}"
  class="hs-growth-timeline color-{{ section.settings.color_scheme }}"
>
  <div class="hs-growth-timeline__inner">
    <div class="hs-growth-timeline__media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image_alt | escape }}"
          class="hs-growth-timeline__image"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% endif %}

      <div class="hs-growth-timeline__media-note">
        {% if section.settings.note_quote != blank %}
          <p class="hs-growth-timeline__quote">
            {{ section.settings.note_quote | newline_to_br }}
          </p>
        {% endif %}

        <div class="hs-growth-timeline__bevy">
          {% if section.settings.note_avatar != blank %}
            <div class="hs-growth-timeline__bevy-avatar">
              <img
                src="{{ section.settings.note_avatar | image_url: width: 120 }}"
                alt="{{ section.settings.note_avatar_alt | escape }}"
                class="hs-growth-timeline__bevy-image"
                loading="lazy"
                width="{{ section.settings.note_avatar.width }}"
                height="{{ section.settings.note_avatar.height }}"
              >
            </div>
          {% endif %}

          {% if section.settings.note_label != blank %}
            <p class="hs-growth-timeline__bevy-text">
              {{ section.settings.note_label }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="hs-growth-timeline__content">
      {% if section.settings.heading != blank %}
        <h2 class="hs-growth-timeline__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hs-growth-timeline__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="hs-growth-timeline__items">
        {% for block in section.blocks %}
          <div class="hs-growth-timeline__item" {{ block.shopify_attributes }}>
            {% if block.settings.period != blank %}
              <div class="hs-growth-timeline__period">
                {{ block.settings.period }}
              </div>
            {% endif %}

            <div class="hs-growth-timeline__item-row">
              {% if block.settings.title != blank %}
                <h3 class="hs-growth-timeline__item-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              <div class="hs-growth-timeline__tags">
                {% if block.settings.tag_1 != blank %}
                  <span class="hs-growth-timeline__tag">
                    {{ block.settings.tag_1 }}
                  </span>
                {% endif %}

                {% if block.settings.tag_2 != blank %}
                  <span class="hs-growth-timeline__tag">
                    {{ block.settings.tag_2 }}
                  </span>
                {% endif %}

                {% if block.settings.tag_3 != blank %}
                  <span class="hs-growth-timeline__tag">
                    {{ block.settings.tag_3 }}
                  </span>
                {% endif %}
              </div>
            </div>

            {% if block.settings.description != blank %}
              <div class="hs-growth-timeline__item-text">
                {{ block.settings.description }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  #hs-growth-timeline-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    box-sizing: border-box;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__media,
  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__content {
    width: 100%;
    min-width: 0;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__media {
    position: relative;
    overflow: hidden;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.72) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__media-note {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 34px;
    z-index: 2;
    color: #ffffff;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__quote {
    margin: 0 0 16px;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    color: #ffffff;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__bevy {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__bevy-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.8);
    flex: 0 0 auto;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__bevy-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__bevy-text {
    margin: 0;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    color: #ffffff;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__content {
    position: relative;
    padding: 60px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__heading {
    margin: 0;
    font-family: "Cormorant Garamond", Cormorant, Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__text {
    margin-top: 18px;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    color: {{ section.settings.text_color }};
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__text p {
    margin: 0;
    line-height: normal;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__items {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 42px;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item {
    position: relative;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__period {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    min-width: 140px;
    margin: 0 0 16px;
    padding: 10px 14px;
    border-radius: 4px;
    background: linear-gradient(91deg, rgba(255, 255, 255, 0.00) -122.65%, rgba(35, 123, 132, 0.48) 108.91%);
    color: {{ section.settings.period_text_color }};
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    box-sizing: border-box;
    text-align: center;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item-title {
    margin: 0;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    color: {{ section.settings.title_color }};
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 10px;
    border: 1px solid {{ section.settings.tag_border_color }};
    border-radius: 999px;
    color: {{ section.settings.tag_text_color }};
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    white-space: nowrap;
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item-text {
    margin-top: 10px;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    color: {{ section.settings.muted_text_color }};
  }

  #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item-text p {
    margin: 0;
    line-height: normal;
  }

  @media screen and (max-width: 768px) {
    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__inner {
      display: flex;
      flex-direction: column;
      height: auto;
      padding: 60px 15px;
      box-sizing: border-box;
      gap: 42px;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__media,
    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__content {
      width: 100%;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__media {
      height: 390px;
      border-radius: 6px;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__image {
      height: 100%;
      object-fit: cover;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__media-note {
      left: 15px;
      right: 15px;
      bottom: 24px;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__quote {
      font-size: 14px;
      margin-bottom: 12px;
      line-height: normal;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__bevy-avatar {
      width: 34px;
      height: 34px;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__bevy-text {
      font-size: 14px;
      line-height: normal;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__content {
      padding: 0;
      text-align: center;
      align-items: center;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__heading {
      width: 100%;
      font-size: 26px;
      line-height: normal;
      text-align: center;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__text {
      width: 100%;
      font-size: 14px;
      margin-top: 14px;
      line-height: normal;
      text-align: center;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__items {
      width: 100%;
      gap: 22px;
      margin-top: 34px;
      text-align: center;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__period {
      width: 125px;
      min-width: 125px;
      padding: 9px 12px;
      font-size: 14px;
      margin-bottom: 14px;
      line-height: normal;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item-row {
      justify-content: center;
      align-items: center;
      gap: 10px;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item-title {
      width: 100%;
      font-size: 16px;
      line-height: normal;
      text-align: center;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__tags {
      justify-content: center;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__tag {
      font-size: 12px;
      padding: 5px 9px;
      line-height: normal;
    }

    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__item-text {
      font-size: 12px;
      line-height: normal;
      text-align: center;
    }
  }

  @media screen and (max-width: 450px) {
    #hs-growth-timeline-{{ section.id }} .hs-growth-timeline__heading {
      font-size: 20px;
      line-height: normal;
      text-align: center;
    }
  }
</style>

{% schema %}
