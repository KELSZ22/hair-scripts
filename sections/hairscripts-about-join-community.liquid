<section class="about-join-community" id="about-join-community-{{ section.id }}">

  <div class="about-join-community__image-wrap">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag:
          class: 'about-join-community__image',
          alt: section.settings.image.alt | default: 'Join the community',
          loading: 'lazy'
      }}
    {%- else -%}
      <div class="about-join-community__image-placeholder"></div>
    {%- endif -%}
  </div>

  <div class="about-join-community__content">
    <div class="about-join-community__text">
      <h2 class="about-join-community__heading">{{ section.settings.heading }}</h2>
      <p class="about-join-community__description">{{ section.settings.description }}</p>
    </div>

    {%- form 'customer', id: 'about-community-form-{{ section.id }}' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="about-join-community__form">
        <div class="about-join-community__input-wrap">
          <label for="email-{{ section.id }}" class="visually-hidden">{{ section.settings.email_placeholder }}</label>
          <input
            type="email"
            id="email-{{ section.id }}"
            name="contact[email]"
            class="about-join-community__input"
            placeholder="{{ section.settings.email_placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            required
          >
        </div>
        <button type="submit" class="about-join-community__btn">
          {{ section.settings.button_label }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="about-join-community__success">{{ section.settings.success_message }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="about-join-community__disclaimer">{{ section.settings.disclaimer }}</p>
  </div>

</section>

<style>
  #about-join-community-{{ section.id }} {
    width: 100%;
    display: flex;
    align-items: stretch;
    min-height: 551px;
    background-color: #FAF7F2;
  }

  #about-join-community-{{ section.id }} .about-join-community__image-wrap {
    flex: 0 0 50.63%;
    width: 50.63%;
    overflow: hidden;
    position: relative;
  }

  #about-join-community-{{ section.id }} .about-join-community__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #about-join-community-{{ section.id }} .about-join-community__image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 551px;
    background-color: #D9D9D9;
  }

  #about-join-community-{{ section.id }} .about-join-community__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 26px;
    align-items: center;
    justify-content: center;
    padding: 60px 82px;
    background-color: #FAF7F2;
  }

  #about-join-community-{{ section.id }} .about-join-community__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
    width: 100%;
  }

  #about-join-community-{{ section.id }} .about-join-community__heading {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    text-transform: uppercase;
    color: #211B18;
    margin: 0;
  }

  #about-join-community-{{ section.id }} .about-join-community__description {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.5;
    color: #6B6B6B;
    margin: 0;
  }

  #about-join-community-{{ section.id }} .about-join-community__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 365px;
    max-width: 100%;
  }

  #about-join-community-{{ section.id }} .about-join-community__input-wrap {
    width: 100%;
  }

  #about-join-community-{{ section.id }} .about-join-community__input {
    width: 100%;
    height: 50px;
    border: 1px solid #CDCDCD;
    border-radius: 60px;
    padding: 10px 19px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: #211B18;
    background-color: transparent;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s;
  }

  #about-join-community-{{ section.id }} .about-join-community__input::placeholder {
    color: #211B18;
  }

  #about-join-community-{{ section.id }} .about-join-community__input:focus {
    border-color: #3D7E7A;
  }

  #about-join-community-{{ section.id }} .about-join-community__btn {
    width: 100%;
    height: 50px;
    background: linear-gradient(90deg, rgb(114, 82, 112) 0%, rgb(114, 82, 112) 42.831%, rgb(55, 24, 52) 100%);
    border: none;
    border-radius: 68px;
    padding: 15px 30px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 1;
    color: #FAF7F2;
    cursor: pointer;
    transition: opacity 0.2s;
    box-sizing: border-box;
  }

  #about-join-community-{{ section.id }} .about-join-community__btn:hover {
    opacity: 0.9;
  }

  #about-join-community-{{ section.id }} .about-join-community__success {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: #3D7E7A;
    text-align: center;
    margin: 0;
  }

  #about-join-community-{{ section.id }} .about-join-community__disclaimer {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1;
    color: #9F9F9F;
    text-align: center;
    margin: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 990px) {
    #about-join-community-{{ section.id }} {
      flex-direction: column-reverse;
    }

    #about-join-community-{{ section.id }} .about-join-community__image-wrap {
      width: 100%;
      height: 400px;
    }

    #about-join-community-{{ section.id }} .about-join-community__content {
      padding: 50px 40px;
    }
  }

  @media screen and (max-width: 749px) {
    #about-join-community-{{ section.id }} .about-join-community__image-wrap {
      height: 300px;
    }

    #about-join-community-{{ section.id }} .about-join-community__content {
      padding: 40px 20px;
    }

    #about-join-community-{{ section.id }} .about-join-community__heading {
      font-size: 26px;
    }

    #about-join-community-{{ section.id }} .about-join-community__description {
      font-size: 16px;
    }

    #about-join-community-{{ section.id }} .about-join-community__form {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "About - Join Community",
  "tag": "section",
  "class": "about-join-community-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE COMMUNITY"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Science-backed education. Early access. Direct from Bevy. Get exclusive offers, hair science straight from a pharmaceutical specialist, and first access when HairScripts™ ships."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email address here"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you for subscribing!"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "No spam. Science only. Unsubscribe any time."
    }
  ],
  "presets": [
    {
      "name": "About - Join Community"
    }
  ]
}
{% endschema %}
