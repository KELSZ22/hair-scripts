<section class="about-quote" id="about-quote-{{ section.id }}">
  <div class="about-quote__inner">

    <div class="about-quote__text-block">
      <blockquote class="about-quote__quote">
        {{ section.settings.quote }}
      </blockquote>
      <p class="about-quote__body">{{ section.settings.body_text }}</p>
    </div>

    <div class="about-quote__attribution">
      <div class="about-quote__portrait-wrap">
        {%- if section.settings.portrait != blank -%}
          {{
            section.settings.portrait
            | image_url: width: 400
            | image_tag:
              class: 'about-quote__portrait',
              alt: section.settings.portrait.alt | default: section.settings.attribution_name,
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="about-quote__portrait-placeholder"></div>
        {%- endif -%}
      </div>

      <div class="about-quote__attribution-text">
        <p class="about-quote__attribution-name">{{ section.settings.attribution_name }}</p>
        <p class="about-quote__attribution-title desktop">{{ section.settings.attribution_title }}</p>
        <p class="about-quote__attribution-title mobile">{{ section.settings.attribution_title_mobile }}</p>
      </div>
    </div>

  </div>
</section>

<style>
  #about-quote-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
    background: linear-gradient(125.46deg, rgb(99, 206, 199) 35.03%, rgb(61, 126, 122) 83.49%);
    padding: 57px 0;
  }

  #about-quote-{{ section.id }} .about-quote__inner {
    max-width: 1069px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: center;
  }

  #about-quote-{{ section.id }} .about-quote__text-block {
    display: flex;
    flex-direction: column;
    gap: 26px;
    text-align: center;
    width: 100%;
  }

  #about-quote-{{ section.id }} .about-quote__quote {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-style: normal;
    font-size: 32px;
    line-height: 1.3;
    text-transform: uppercase;
    color: #FAF7F2;
    margin: 0;
  }

  #about-quote-{{ section.id }} .about-quote__body {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.6;
    color: #FAF7F2;
    margin: 0;
  }

  #about-quote-{{ section.id }} .about-quote__attribution {
    display: flex;
    flex-direction: column;
    gap: 17px;
    align-items: center;
    width: 430px;
  }

  #about-quote-{{ section.id }} .about-quote__portrait-wrap {
    width: 199px;
    height: 199px;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    border: none;
  }

  #about-quote-{{ section.id }} .about-quote__portrait-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(180deg, #7A4932 0%, #FFB796 100%);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  #about-quote-{{ section.id }} .about-quote__portrait {
    width: calc(100% - 34px);
    height: calc(100% - 34px);
    border-radius: 50%;
    object-fit: cover;
    display: block;
    box-sizing: border-box;
  }

  #about-quote-{{ section.id }} .about-quote__portrait-placeholder {
    width: calc(100% - 34px);
    height: calc(100% - 34px);
    border-radius: 50%;
    border: 8px solid #FF9A73;
    background-color: rgba(255, 255, 255, 0.2);
    box-sizing: border-box;
  }

  #about-quote-{{ section.id }} .about-quote__attribution-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-align: center;
  }

  #about-quote-{{ section.id }} .about-quote__attribution-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-style: normal;
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  #about-quote-{{ section.id }} .about-quote__attribution-title.desktop {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    display: block;
  }

  #about-quote-{{ section.id }} .about-quote__attribution-title.mobile {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    display: none;
  }

  @media screen and (max-width: 990px) {
    #about-quote-{{ section.id }} .about-quote__attribution {
      width: 100%;
      max-width: 430px;
    }

    #about-quote-{{ section.id }} .about-quote__quote {
      font-size: 26px;
    }
  }

  @media screen and (max-width: 749px) {
    #about-quote-{{ section.id }} {
      padding: 50px 0;
    }

    #about-quote-{{ section.id }} .about-quote__inner {
      padding: 0 20px;
    }

    #about-quote-{{ section.id }} .about-quote__quote {
      font-size: 22px;
    }

    #about-quote-{{ section.id }} .about-quote__body {
      font-size: 16px;
    }

    #about-quote-{{ section.id }} .about-quote__attribution-title.desktop {
      display: none !important;
    }

    #about-quote-{{ section.id }} .about-quote__attribution-title.mobile {
      display: block !important;
    }
  }
</style>

{% schema %}
{
  "name": "About - Quote Banner",
  "tag": "section",
  "class": "about-quote-section",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "\"You don't have to have all the answers yet. Your follicles just need to be supported while you find them.\""
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "HairScripts™ was built for the woman who has tried things that didn't work — not because she wasn't consistent enough, but because the formula wasn't built for her biology. You don't have to wait until you've identified your root cause to start supporting your follicles across all nine pathways. That's the whole point of this formula."
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Portrait Photo"
    },
    {
      "type": "text",
      "id": "attribution_name",
      "label": "Name",
      "default": "Bevy"
    },
    {
      "type": "text",
      "id": "attribution_title",
      "label": "Title",
      "default": "Founder, HairScripts™ · Pharmaceutical Dermatology Expert · One of You"
    },
    {
      "type": "text",
      "id": "attribution_title_mobile",
      "label": "Title Mobile",
      "default": "Founder, HairScripts™ · Pharmaceutical Dermatology Expert · One of You"
    }
  ],
  "presets": [
    {
      "name": "About - Quote Banner"
    }
  ]
}
{% endschema %}