        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ split image",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "category": "category_1",
            "question": "Is this for all hair types and textures?"
          }
        },
        {
          "type": "faq_item",
          "settings": {
