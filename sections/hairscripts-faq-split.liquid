    },
    {
      "type": "text",
      "id": "category_2",
      "label": "Category 2 label",
      "default": "Category B"
    },
    {
      "type": "text",
      "id": "category_3",
      "label": "Category 3 label",
      "default": "Category C"
    },
    {
      "type": "text",
      "id": "category_4",
