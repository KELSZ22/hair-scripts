<div class="professional-proof-section" id="section-{{ section.id }}">
  <div class="professional-proof-outer">
    <div class="professional-proof-wrapper">

      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="professional-proof-header">
          {% if section.settings.heading != blank %}
            <h2 class="professional-proof-heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <p class="professional-proof-subheading">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="professional-proof-slider">
          <div class="professional-proof-track-wrap">
            <div class="professional-proof-grid">
              {% for block in section.blocks %}
                <div class="professional-proof-card" {{ block.shopify_attributes }}>
                  <div class="professional-proof-card-inner">
                    <div class="professional-proof-image-wrap">
                      {% if block.settings.image != blank %}
                        {{
                          block.settings.image
                          | image_url: width: 900
                          | image_tag:
                            class: 'professional-proof-image',
                            loading: 'lazy',
                            widths: '300, 500, 700, 900',
                            sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 100vw',
                            alt: block.settings.name
                        }}
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'professional-proof-image professional-proof-placeholder' }}
                      {% endif %}
                    </div>

                    {% if block.settings.quote != blank %}
                      <div class="professional-proof-quote-bar">
                        <p class="professional-proof-quote">“{{ block.settings.quote }}”</p>
                      </div>
                    {% endif %}
                  </div>

                  <div class="professional-proof-meta">
                    {% if block.settings.name != blank %}
                      <h3 class="professional-proof-name">{{ block.settings.name }}</h3>
                    {% endif %}

                    {% if block.settings.role != blank %}
                      <p class="professional-proof-role">{{ block.settings.role }} <svg xmlns="http://www.w3.org/2000/svg" width="11" height="8" viewBox="0 0 11 8" fill="none">
  <path d="M3.81705 7.63417C3.61434 7.63417 3.42467 7.53383 3.31046 7.36578C2.35642 5.95858 1.37261 4.97028 0.303134 4.3454C0.0114966 4.17491 -0.0868034 3.80006 0.0836921 3.50842C0.25378 3.21679 0.628625 3.11767 0.92067 3.28898C1.95221 3.89183 2.90135 4.76838 3.80482 5.95613C5.54281 3.50557 7.5912 1.53549 9.9035 0.0928026C10.1911 -0.0858506 10.5675 0.00102873 10.7462 0.288179C10.9248 0.574921 10.838 0.952214 10.5508 1.13087C8.13002 2.64085 6.09468 4.67823 4.32732 7.35926C4.21474 7.53016 4.02467 7.63335 3.82032 7.63458C3.8195 7.63417 3.81828 7.63417 3.81705 7.63417Z" fill="#63144F"/>
</svg></p>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  #section-{{ section.id }} {
    background: #fff;
  }

  #section-{{ section.id }} .professional-proof-outer {
    width: 100%;
  }

  #section-{{ section.id }} .professional-proof-wrapper {
    padding: 60px 40px;
  }

  #section-{{ section.id }} .professional-proof-header {
    max-width: 760px;
    margin: 0 auto 42px;
    text-align: center;
  }

  #section-{{ section.id }} .professional-proof-heading {
    color: var(--Scheme-1-Text-Dark, #211B18);
    text-align: center;
    font-family: "Tenor Sans";
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: -1.6px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  #section-{{ section.id }} .professional-proof-subheading {
    margin: 0;
    color: var(--Scheme-1-Text-Dark, #211B18);
    text-align: center;
    font-family: Fustat;
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
  }

  #section-{{ section.id }} .professional-proof-slider {
    position: relative;
  }

  #section-{{ section.id }} .professional-proof-track-wrap {
    overflow: visible;
  }

  #section-{{ section.id }} .professional-proof-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
  }

  #section-{{ section.id }} .professional-proof-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    align-self: stretch;
  }

  #section-{{ section.id }} .professional-proof-card-inner {
    overflow: hidden;
    border-radius: 12px;
    background: #CFE7E6;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    height: 100%;
  }

  #section-{{ section.id }} .professional-proof-image-wrap {
    overflow: hidden;
    height: 300px;
    flex: 0 0 300px;
  }

  #section-{{ section.id }} .professional-proof-image,
  #section-{{ section.id }} .professional-proof-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #section-{{ section.id }} .professional-proof-quote-bar {
    height: 92px;
    min-height: 92px;
    padding: 12px 14px;
    background: #ABC2A9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #section-{{ section.id }} .professional-proof-quote {
    margin: 0;
    color: #fff;
    text-align: center;
    font-family: "Tenor Sans";
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: -1px;
    text-transform: uppercase;
  }

  #section-{{ section.id }} .professional-proof-meta {
    padding: 10px 8px 0;
    text-align: center;
    min-height: 88px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  #section-{{ section.id }} .professional-proof-name {
    margin: 0 0 6px;
    color: var(--Scheme-1-Text-Dark, #211B18);
    text-align: center;
    font-family: Fustat;
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: normal;
  }

  #section-{{ section.id }} .professional-proof-role {
    margin: 0;
    color: var(--Scheme-1-Text-Dark, #211B18);
    text-align: center;
    font-family: Fustat;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  @media screen and (max-width: 1024px) {
    #section-{{ section.id }} .professional-proof-wrapper {
      padding: 40px 24px;
    }

    #section-{{ section.id }} .professional-proof-heading {
      font-size: 28px;
    }

    #section-{{ section.id }} .professional-proof-subheading {
      font-size: 16px;
    }

    #section-{{ section.id }} .professional-proof-slider {
      position: relative;
    }

    #section-{{ section.id }} .professional-proof-track-wrap {
      overflow: hidden;
    }

    #section-{{ section.id }} .professional-proof-grid {
      display: flex;
      grid-template-columns: none;
      gap: 0;
      transition: transform 0.4s ease;
      will-change: transform;
      align-items: stretch;
    }

    #section-{{ section.id }} .professional-proof-card {
      flex: 0 0 33.3333%;
      max-width: 33.3333%;
      padding: 0 9px;
      box-sizing: border-box;
    }
  }

  @media screen and (max-width: 989px) {
    #section-{{ section.id }} .professional-proof-slider {
      position: relative;
      padding: 0;
    }

    #section-{{ section.id }} .professional-proof-heading {
      font-size: 20px;
      letter-spacing: normal;
    }

    #section-{{ section.id }} .professional-proof-subheading {
      font-size: 14px;
    }

    #section-{{ section.id }} .professional-proof-quote {
      font-size: 14px;
    }

    #section-{{ section.id }} h3.professional-proof-name {
      font-size: 14px;
    }

    #section-{{ section.id }} .professional-proof-role {
      font-size: 12px;
    }
  }

  @media screen and (max-width: 767px) {
    #section-{{ section.id }} .professional-proof-card {
      flex: 0 0 50%;
      max-width: 50%;
      padding: 0 8px;
    }

    #section-{{ section.id }} .professional-proof-image-wrap {
      height: 320px;
      flex: 0 0 320px;
    }

    #section-{{ section.id }} .professional-proof-image,
    #section-{{ section.id }} .professional-proof-placeholder {
      height: 100%;
    }

    #section-{{ section.id }} .professional-proof-quote-bar {
      height: 84px;
      min-height: 84px;
    }

    #section-{{ section.id }} .professional-proof-meta {
      min-height: 82px;
    }
  }

  @media screen and (max-width: 500px) {
    #section-{{ section.id }} .professional-proof-slider {
      position: relative;
      padding: 0;
    }

    #section-{{ section.id }} .professional-proof-card {
      flex: 0 0 84%;
      max-width: 84%;
      padding: 0 10px 0 0;
      box-sizing: border-box;
    }

    #section-{{ section.id }} .professional-proof-image-wrap {
      height: 320px;
      flex: 0 0 320px;
    }

    #section-{{ section.id }} .professional-proof-image,
    #section-{{ section.id }} .professional-proof-placeholder {
      height: 100%;
    }

    #section-{{ section.id }} .professional-proof-quote-bar {
      height: 84px;
      min-height: 84px;
    }

    #section-{{ section.id }} .professional-proof-meta {
      min-height: 82px;
    }
  }
</style>

<script>
  (function() {
    const section = document.getElementById('section-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('.professional-proof-grid');
    if (!track) return;

    let currentIndex = 0;
    let startX = 0;
    let endX = 0;
    let slidesPerView = 5;
    let totalRealSlides = 0;
    let isCarousel = false;
    let loopActive = false;
    let isAnimating = false;
    let pendingSnap = null;

    function getRealSlides() {
      return Array.from(track.querySelectorAll('.professional-proof-card:not(.is-clone)'));
    }

    function getSlidesPerView() {
      if (window.innerWidth <= 500) return 1;
      if (window.innerWidth <= 767) return 2;
      if (window.innerWidth <= 1024) return 3;
      return 5;
    }

    function clearClones() {
      track.querySelectorAll('.professional-proof-card.is-clone').forEach((slide) => slide.remove());
    }

    function setTransition(enabled) {
      track.style.transition = enabled ? 'transform 0.4s ease' : 'none';
    }

    function getStepSize() {
      const firstSlide = track.querySelector('.professional-proof-card');
      if (!firstSlide) return 0;
      return firstSlide.getBoundingClientRect().width;
    }

    function setTranslate(offsetIndex, animate = true) {
      const stepSize = getStepSize();
      setTransition(animate);
      track.style.transform = 'translateX(-' + (offsetIndex * stepSize) + 'px)';
    }

    function buildClones() {
      clearClones();

      const realSlides = getRealSlides();
      totalRealSlides = realSlides.length;
      slidesPerView = getSlidesPerView();
      isCarousel = window.innerWidth <= 1024;
      loopActive = isCarousel && totalRealSlides > slidesPerView;

      if (!isCarousel) {
        currentIndex = 0;
        setTranslate(0, false);
        return;
      }

      if (!loopActive) {
        currentIndex = 0;
        setTranslate(0, false);
        return;
      }

      const beforeFragment = document.createDocumentFragment();
      const afterFragment = document.createDocumentFragment();

      realSlides.slice(-slidesPerView).forEach((slide) => {
        const clone = slide.cloneNode(true);
        clone.classList.add('is-clone');
        beforeFragment.appendChild(clone);
      });

      realSlides.slice(0, slidesPerView).forEach((slide) => {
        const clone = slide.cloneNode(true);
        clone.classList.add('is-clone');
        afterFragment.appendChild(clone);
      });

      track.prepend(beforeFragment);
      track.appendChild(afterFragment);

      if (currentIndex >= totalRealSlides) {
        currentIndex = 0;
      }

      requestAnimationFrame(() => {
        setTranslate(currentIndex + slidesPerView, false);
      });
    }

    function goToNext() {
      if (!isCarousel || !loopActive || isAnimating) return;

      isAnimating = true;

      if (currentIndex === totalRealSlides - 1) {
        currentIndex = 0;
        pendingSnap = slidesPerView;
        setTranslate(totalRealSlides + slidesPerView, true);
      } else {
        currentIndex++;
        setTranslate(currentIndex + slidesPerView, true);
      }
    }

    function goToPrev() {
      if (!isCarousel || !loopActive || isAnimating) return;

      isAnimating = true;

      if (currentIndex === 0) {
        currentIndex = totalRealSlides - 1;
        pendingSnap = totalRealSlides - 1 + slidesPerView;
        setTranslate(slidesPerView - 1, true);
      } else {
        currentIndex--;
        setTranslate(currentIndex + slidesPerView, true);
      }
    }

    track.addEventListener('transitionend', function(e) {
      if (e.propertyName !== 'transform') return;

      if (pendingSnap !== null) {
        setTranslate(pendingSnap, false);
        pendingSnap = null;
        track.offsetHeight;
      }

      isAnimating = false;
    });

    track.addEventListener('touchstart', function(e) {
      if (!isCarousel || !loopActive) return;
      startX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', function(e) {
      if (!isCarousel || !loopActive || isAnimating) return;

      endX = e.changedTouches[0].clientX;

      if (startX - endX > 50) {
        goToNext();
      } else if (endX - startX > 50) {
        goToPrev();
      }
    }, { passive: true });

    function rebuildSlider() {
      isAnimating = false;
      pendingSnap = null;
      track.style.transform = 'translateX(0)';
      buildClones();
    }

    let resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(rebuildSlider, 150);
    });

    document.addEventListener('shopify:section:load', rebuildSlider);

    rebuildSlider();
  })();
</script>

