          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Growth & Evolution",
            "text": "Helps nourish follicles and support a healthier growth cycle."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Inflammation Control",
            "text": "Helps calm visible and invisible irritation that can stress the scalp."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Circulation Boost",
            "text": "Supports nutrient delivery to the scalp and follicle environment."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Stress Regulation",
            "text": "Supports balance when life stress shows up in your hair."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Energy Support",
            "text": "Provides nutritional support to help the body do the heavy lifting."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Nutrient Absorption",
            "text": "Supports the body’s ability to take in and use the essentials."
