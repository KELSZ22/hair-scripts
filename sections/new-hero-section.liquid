{% liquid
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign proof_blocks = section.blocks | where: 'type', 'proof'
%}

<section id="section-{{ section.id }}" class="hs-science-hero">
  <div class="hs-science-hero__bg"></div>
  <div class="hs-science-hero__overlay"></div>

  <div class="hs-science-hero__container">
    <div class="hs-science-hero__grid">

      <div class="hs-science-hero__content">
        {% if section.settings.heading != blank %}
          <h1 class="hs-science-hero__heading">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hs-science-hero__description">{{ section.settings.description }}</div>
        {% endif %}

        <div class="hs-science-hero__buttons">
          {% if section.settings.button_label != blank %}
            <a
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
              class="hs-science-hero__button hs-science-hero__button--primary"
            >
              {{ section.settings.button_label }}
            </a>
          {% endif %}

          {% if section.settings.button_label_2 != blank %}
            <a
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
              class="hs-science-hero__button hs-science-hero__button--secondary"
            >
              {{ section.settings.button_label_2 }}
            </a>
          {% endif %}
        </div>

        <div class="hs-science-hero__bottom desktop">
          {% if section.settings.creator_text != blank %}
            <div class="hs-science-hero__creator">
              <div class="hs-science-hero__creator-image">
                {% if section.settings.creator_image != blank %}
                  {{
                    section.settings.creator_image
                    | image_url: width: 80
                    | image_tag:
                      class: 'hs-science-hero__creator-img',
                      loading: 'lazy',
                      alt: section.settings.creator_text
                  }}
                {% else %}
                  <span class="hs-science-hero__creator-fallback">✓</span>
                {% endif %}
              </div>
              <span class="hs-science-hero__creator-text">{{ section.settings.creator_text }}</span>
            </div>
          {% endif %}

          {% if proof_blocks.size > 0 %}
            <div class="hs-science-hero__proofs">
              {% for block in proof_blocks %}
                {% if block.settings.text != blank %}
                  <div class="hs-science-hero__proof-item" {{ block.shopify_attributes }}>
                    <span class="hs-science-hero__proof-icon">✓</span>
                    <span class="hs-science-hero__proof-text">{{ block.settings.text }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="hs-science-hero__visual">
         <div class="hs-science-hero__bottom mobile">
          {% if section.settings.creator_text != blank %}
            <div class="hs-science-hero__creator">
              <div class="hs-science-hero__creator-image">
                {% if section.settings.creator_image != blank %}
                  {{
                    section.settings.creator_image
                    | image_url: width: 80
                    | image_tag:
                      class: 'hs-science-hero__creator-img',
                      loading: 'lazy',
                      alt: section.settings.creator_text
                  }}
                {% else %}
                  <span class="hs-science-hero__creator-fallback">✓</span>
                {% endif %}
              </div>
              <span class="hs-science-hero__creator-text">{{ section.settings.creator_text }}</span>
            </div>
          {% endif %}

          {% if proof_blocks.size > 0 %}
            <div class="hs-science-hero__proofs">
              {% for block in proof_blocks %}
                {% if block.settings.text != blank %}
                  <div class="hs-science-hero__proof-item" {{ block.shopify_attributes }}>
                    <span class="hs-science-hero__proof-icon">✓</span>
                    <span class="hs-science-hero__proof-text">{{ block.settings.text }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <div class="hs-science-hero__product-wrap">
          {% if section.settings.product_image != blank %}
            {{
              section.settings.product_image
              | image_url: width: 1200
              | image_tag:
                class: 'hs-science-hero__product-image',
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 34vw, 70vw',
                alt: section.settings.heading
            }}
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
    #section-{{ section.id }} .hs-science-hero__visual{
        display: none;
    }
  #section-{{ section.id }} {
    position: relative;
    overflow: hidden;
    height: 100vh;
    color: #FFFFFF;
    background: #8E603F;
    margin-top: -64px;
  }

  #section-{{ section.id }} .hs-science-hero__bg,
  #section-{{ section.id }} .hs-science-hero__overlay {
    position: absolute;
    inset: 0;
  }

  #section-{{ section.id }} .hs-science-hero__bg {
    background-color: #8E603F;
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    {% endif %}
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
  }

  #section-{{ section.id }} .hs-science-hero__overlay {
    background: linear-gradient(90deg, rgba(39, 22, 13, 0.62) 0%, rgba(39, 22, 13, 0.34) 35%, rgba(39, 22, 13, 0.08) 70%, rgba(39, 22, 13, 0.00) 100%);
    pointer-events: none;
  }

  #section-{{ section.id }} .hs-science-hero__container {
    position: relative;
    z-index: 2;
    margin: 0 auto;
    padding: 60px 40px;
    height: 100%;
  }

  #section-{{ section.id }} .hs-science-hero__grid {
    display: flex;
    gap: 32px;
    align-items: center;
    height: 100%;
  }

  #section-{{ section.id }} .hs-science-hero__content {
    width: 50%;
  }

  #section-{{ section.id }} .hs-science-hero__heading {
    margin: 0 0 14px;
    color: var(--New-Colors-BG-light, #FAF7F2);
    font-family: "Cormorant Garamond";
    font-size: 43px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: uppercase;
  }

  #section-{{ section.id }} .hs-science-hero__description {
    width: 80%;
    margin: 0 0 22px;
    color: var(--New-Colors-BG-light, #FAF7F2);
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  #section-{{ section.id }} .hs-science-hero__description p {
    margin: 0;
  }

  #section-{{ section.id }} .hs-science-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 26px;
  }

  #section-{{ section.id }} .hs-science-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 15px 25px;
    border-radius: 999px;
    text-decoration: none;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: 1;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #section-{{ section.id }} .hs-science-hero__button:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  #section-{{ section.id }} .hs-science-hero__button--primary {
    background: #C4A882;
    color: #FFFFFF;
  }

  #section-{{ section.id }} .hs-science-hero__button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
  }

  #section-{{ section.id }} .hs-science-hero__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #section-{{ section.id }} .hs-science-hero__creator {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #section-{{ section.id }} .hs-science-hero__creator-image {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 24px;
  }

  #section-{{ section.id }} .hs-science-hero__creator-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #section-{{ section.id }} .hs-science-hero__creator-fallback {
    font-size: 11px;
    font-weight: 700;
    color: #FFFFFF;
  }

  #section-{{ section.id }} .hs-science-hero__creator-text {
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: 1.3;
  }

  #section-{{ section.id }} .hs-science-hero__proofs {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #section-{{ section.id }} .hs-science-hero__proof-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  #section-{{ section.id }} .hs-science-hero__proof-icon {
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
    flex: 0 0 auto;
  }

  #section-{{ section.id }} .hs-science-hero__proof-text {
    color: rgba(255, 255, 255, 0.88);
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.4;
  }

  #section-{{ section.id }} .hs-science-hero__badges {
    position: absolute;
    top: 34px;
    left: 40px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #section-{{ section.id }} .hs-science-hero__badge {
    min-width: 180px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 18px;
    background: rgba(122, 81, 52, 0.72);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(3px);
  }

  #section-{{ section.id }} .hs-science-hero__badge-icon-wrap {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border-radius: 999px;
    overflow: hidden;
    background: linear-gradient(180deg, #C9A15A 0%, #946B25 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #section-{{ section.id }} .hs-science-hero__badge-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #section-{{ section.id }} .hs-science-hero__badge-fallback {
    font-size: 10px;
    color: #FFFFFF;
  }

  #section-{{ section.id }} .hs-science-hero__badge-title {
    color: #FFFFFF;
    font-family: Fustat, sans-serif;
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
  }

  #section-{{ section.id }} .hs-science-hero__badge-subtitle {
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.82);
    font-family: Fustat, sans-serif;
    font-size: 9px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.2;
  }

  #section-{{ section.id }} .hs-science-hero__product-wrap {
    position: relative;
    z-index: 2;
    max-width: 500px;
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  #section-{{ section.id }} .hs-science-hero__product-image {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.18));
  }

  @media screen and (max-width: 1024px) {
    #section-{{ section.id }} {
        height: 1200px;
    }
    #section-{{ section.id }} .hs-science-hero__grid {
        flex-direction: column;
        padding-top: 100px;
}
#section-{{ section.id }} .hs-science-hero__content {
    width: 100%;
}
    #section-{{ section.id }} .hs-science-hero__bg {
      {% if section.settings.background_image_1024 != blank %}
        background-image: url('{{ section.settings.background_image_1024 | image_url: width: 1800 }}');
      {% endif %}
    }

    #section-{{ section.id }} .hs-science-hero__grid {
      grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    }
    #section-{{ section.id }} h1.hs-science-hero__heading {
        text-align: center;
    }
    #section-{{ section.id }} .hs-science-hero__badges {
      left: 0;
    }

    #section-{{ section.id }} .hs-science-hero__product-image {
      max-width: 360px;
    }
    #section-{{ section.id }} .hs-science-hero__visual{
        display: block;
        width: 100%;
    }
    #section-{{ section.id }} .hs-science-hero__bottom.desktop {
    display: none;
}
#section-{{ section.id }} .hs-science-hero__grid {
        justify-content: space-between;
}
#section-{{ section.id }} .hs-science-hero__description {
    text-align: center;
    max-width: 100%;
    width: 100%;
}
#section-{{ section.id }} .hs-science-hero__buttons {
    justify-content: center;
    flex-direction: column;
    width: 350px;
    margin: 0 auto;
}
  } 

  @media screen and (max-width: 989px) {

    #section-{{ section.id }} {
    height: 900px;
}

    #section-{{ section.id }} .hs-science-hero__heading {
    font-size: 43px;
}
    #section-{{ section.id }} {
      min-height: auto;
    }

    #section-{{ section.id }} .hs-science-hero__container {
      padding: 36px 20px;
    }

    #section-{{ section.id }} .hs-science-hero__grid {
      grid-template-columns: 1fr;
      gap: 20px;
      min-height: auto;
    }

    #section-{{ section.id }} .hs-science-hero__content {
      max-width: 100%;
    }

    #section-{{ section.id }} .hs-science-hero__visual {
      min-height: auto;
      justify-content: center;
      padding-top: 10px;
    }

    #section-{{ section.id }} .hs-science-hero__badges {
      position: relative;
      top: auto;
      left: auto;
      margin-bottom: 16px;
      align-self: flex-start;
    }

    #section-{{ section.id }} .hs-science-hero__visual {
      flex-direction: column;
      align-items: flex-start;
    }

    #section-{{ section.id }} .hs-science-hero__product-wrap {
      justify-content: center;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }} .hs-science-hero__description{
      font-size: 14px;
    }
    #section-{{ section.id }} .hs-science-hero__heading {
      font-size: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    #section-{{ section.id }} {
    margin-top: -60px;
  }
    #section-{{ section.id }} .hs-science-hero__overlay {
      background: linear-gradient(180deg, rgba(39, 22, 13, 0.34) 0%, rgba(39, 22, 13, 0.46) 55%, rgba(39, 22, 13, 0.70) 100%);
    }

    #section-{{ section.id }} .hs-science-hero__container {
      padding: 28px 16px;
    }

    #section-{{ section.id }} .hs-science-hero__buttons {
      gap: 8px;
    }

    #section-{{ section.id }} .hs-science-hero__button {
      min-height: 38px;
      padding: 10px 16px;
      font-size: 14px;
    }

    #section-{{ section.id }} .hs-science-hero__badge {
      min-width: 160px;
      padding: 9px 12px;
    }

    #section-{{ section.id }} .hs-science-hero__product-image {
      max-width: 280px;
    }
  }

  @media screen and (max-width: 450px) {
    #section-{{ section.id }} .hs-science-hero__buttons {
      width: 100%;
}
    #section-{{ section.id }} .hs-science-hero__heading {
      font-size: 20px;
}
    #section-{{ section.id }} .hs-science-hero__bg {
      {% if section.settings.background_image_450 != blank %}
        background-image: url('{{ section.settings.background_image_450 | image_url: width: 900 }}');
      {% endif %}
      background-position: center;
    }

    #section-{{ section.id }} .hs-science-hero__badges {
      width: 100%;
    }

    #section-{{ section.id }} .hs-science-hero__badge {
      width: 100%;
      max-width: 220px;
    }
    #section-{{ section.id }} {
    height: 800px;
}
  }
</style>

{% schema %}
{
  "name": "Hair science hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image_1024",
      "label": "Background image 1024px"
    },
    {
      "type": "image_picker",
      "id": "background_image_450",
      "label": "Background image 450px"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "image_picker",
      "id": "creator_image",
      "label": "Creator image"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "SCIENCE DESIGNED FOR VISIBLY FULLER, HEALTHIER HAIR"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "HairScripts was built to address what most hair vitamins ignore. The root biological causes of shedding, thinning edges, and reduced density that affect women through stress, hormones, and postpartum recovery."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop The Formula"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Find My Hair Plan - Free Quiz"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "creator_text",
      "label": "Creator text",
      "default": "Created by Bevy."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "PHARMA-LED FORMULA"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Hair science support"
        }
      ]
    },
    {
      "type": "proof",
      "name": "Proof item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "10+ years pharmaceutical professional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hair science hero",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "title": "PHARMA-LED FORMULA",
            "subtitle": "Hair science support"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "SCALP HEALTH SUPPORT",
            "subtitle": "Targeted root support"
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "DENSITY SUPPORT",
            "subtitle": "Fuller hair appearance"
          }
        },
        {
          "type": "proof",
          "settings": {
            "text": "10+ years pharmaceutical professional"
          }
        },
        {
          "type": "proof",
          "settings": {
            "text": "Science-informed formulation"
          }
        },
        {
          "type": "proof",
          "settings": {
            "text": "Clinical data interpreter"
          }
        }
      ]
    }
  ]
}
{% endschema %}