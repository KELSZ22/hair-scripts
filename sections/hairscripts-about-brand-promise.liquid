<section class="about-brand-promise" id="about-brand-promise-{{ section.id }}">
  <div class="about-brand-promise__inner">

    <div class="about-brand-promise__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-brand-promise__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-brand-promise__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="about-brand-promise__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="about-brand-promise__grid">
      {%- assign pillar_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          {%- assign pillar_count = pillar_count | plus: 1 -%}

          <div class="about-brand-promise__pillar" {{ block.shopify_attributes }}>
            <div class="about-brand-promise__pillar-icon">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 100
                  | image_tag:
                    width: 50,
                    height: 50,
                    alt: block.settings.title,
                    loading: 'lazy'
                }}
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#2C5F5C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"></polyline></svg>
              {%- endif -%}
            </div>
            <div class="about-brand-promise__pillar-content">
              <h3 class="about-brand-promise__pillar-title">{{ block.settings.title }}</h3>
              <p class="about-brand-promise__pillar-text">{{ block.settings.text }}</p>
            </div>
          </div>

          {%- unless forloop.last -%}
            {%- assign col_pos = pillar_count | modulo: 3 -%}
            <div class="about-brand-promise__divider{% if col_pos == 0 %} about-brand-promise__divider--row-end{% endif %}" aria-hidden="true"></div>
          {%- endunless -%}

        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank -%}
      <a
        href="{{ section.settings.button_url | default: '#' }}"
        class="about-brand-promise__cta"
        target="_blank"
      >
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}

  </div>
</section>

<style>
  #about-brand-promise-{{ section.id }} {
    background-color: #DBEEEC;
    width: 100%;
    padding: 70px 0;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    gap: 38px;
    align-items: center;
  }

  /* ── Header ── */
  #about-brand-promise-{{ section.id }} .about-brand-promise__header {
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1;
    color: #211B18;
    margin: 0;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__heading {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: 43px;
    line-height: 1;
    text-transform: uppercase;
    color: #211B18;
    margin: 0;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__subheading {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1;
    color: #211B18;
    margin: 0;
  }

  /* ── Grid ── */
  #about-brand-promise-{{ section.id }} .about-brand-promise__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 64px 51px;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
  }

  /* ── Pillars ── */
  #about-brand-promise-{{ section.id }} .about-brand-promise__pillar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: center;
    width: 342px;
    text-align: center;
    flex-shrink: 0;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__pillar-icon {
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__pillar-icon img {
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__pillar-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    width: 100%;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__pillar-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
    color: #211B18;
    margin: 0;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__pillar-text {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.6;
    color: #211B18;
    margin: 0;
  }

  /* ── Vertical dividers (desktop) ──
     Width is 0 so the flex item takes no horizontal space.
     The gap (51px each side) provides the visual spacing.
     ::after draws the 1px visible line. */
  #about-brand-promise-{{ section.id }} .about-brand-promise__divider {
    width: 0;
    height: 196px;
    align-self: center;
    flex-shrink: 0;
    position: relative;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__divider::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 100%;
    background-color: #A9CFCD;
  }

  /* Row-end divider: hidden on desktop — sits between row 1 and row 2.
     Shown on mobile as a horizontal line like all other dividers. */
  #about-brand-promise-{{ section.id }} .about-brand-promise__divider--row-end {
    display: none;
  }

  /* ── CTA button ── */
  #about-brand-promise-{{ section.id }} .about-brand-promise__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    min-width: 220px;
    padding: 15px 30px;
    border-radius: 68px;
    background: linear-gradient(90deg, #725270 0%, #725270 42.831%, #371834 100%);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 1;
    color: #FAF7F2;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  #about-brand-promise-{{ section.id }} .about-brand-promise__cta:hover {
    opacity: 0.88;
  }

  /* ── Tablet ≤ 1200px ── */
  @media screen and (max-width: 1200px) {
    #about-brand-promise-{{ section.id }} .about-brand-promise__grid {
      gap: 50px 30px;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__pillar {
      width: calc(50% - 15px);
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__divider {
      display: none;
    }
  }

  /* ── Mobile ≤ 749px ── */
  @media screen and (max-width: 749px) {
    #about-brand-promise-{{ section.id }} {
      padding: 50px 0;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__inner {
      padding: 0 16px;
      gap: 50px;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__header {
      gap: 6px;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__heading {
      font-size: 20px;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__subheading {
      display: none;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__grid {
      flex-direction: column;
      gap: 0;
      align-items: stretch;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__pillar {
      width: 100%;
      gap: 15px;
      padding: 16px 0;
    }

    /* All dividers become horizontal lines on mobile, including row-end ones */
    #about-brand-promise-{{ section.id }} .about-brand-promise__divider,
    #about-brand-promise-{{ section.id }} .about-brand-promise__divider--row-end {
      display: block;
      width: 100%;
      height: 1px;
      background-color: #A9CFCD;
      position: static;
      align-self: auto;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__divider::after,
    #about-brand-promise-{{ section.id }} .about-brand-promise__divider--row-end::after {
      display: none;
    }

    #about-brand-promise-{{ section.id }} .about-brand-promise__cta {
      width: 100%;
      min-width: unset;
    }
  }
</style>

{% schema %}
{
  "name": "About - Brand Promise",
  "tag": "section",
  "class": "about-brand-promise-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "WHAT WE STAND ON"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Brand Promise"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (hidden on mobile)",
      "default": "The principles this formula was built on — and the ones HairScripts™ is accountable to."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Start My Protocol"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Promise Pillar",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Science, Not Trends"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every ingredient was selected for its documented mechanism at the follicle level. Not its marketing appeal. Not because it photographs well on a label."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Brand Promise",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Science, Not Trends",
            "text": "Every ingredient was selected for its documented mechanism at the follicle level. Not its marketing appeal. Not because it photographs well on a label."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "All Nine Pathways",
            "text": "Nine root causes of hormonal hair loss. All addressed simultaneously. Because your body doesn't work one pathway at a time — and your formula shouldn't either."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Full Transparency",
            "text": "Every ingredient. Every dose. Visible and defensible. No proprietary blends hiding underdosed actives. You deserve to know exactly what you're putting in your body and why."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Built for Consistency",
            "text": "Real follicle recovery takes 90 days minimum. That's how hair grows — not a disclaimer. HairScripts™ compounds over time. It's not built to spike. It's built to last."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Drug-Free. Pharma-Informed.",
            "text": "Pharmaceutical formulation logic. Zero drugs. Zero prescription side effects. The clinical thinking — accessible, daily, and designed for your body."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Confidence Is the Outcome",
            "text": "This isn't about vanity metrics. It's about giving women back the version of themselves that doesn't have to think about this every morning."
          }
        }
      ]
    }
  ]
}
{% endschema %}
