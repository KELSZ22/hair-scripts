          "id": "title",
          "label": "Title",
          "default": "Anagen — Active Growth"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Lasts 2–7 years. Nutritional deficiencies and hormonal disruption shorten this phase — a primary driver of thinning.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HairScripts Hair Cycle",
      "blocks": [
        {
          "type": "cycle_card",
          "settings": {
            "kicker": "85% of all hairs",
