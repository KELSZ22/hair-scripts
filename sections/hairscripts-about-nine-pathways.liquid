<section class="about-nine-pathways" id="about-nine-pathways-{{ section.id }}">

  <div class="about-nine-pathways__image-wrap">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag:
          class: 'about-nine-pathways__image',
          alt: section.settings.image.alt | default: 'HairScripts formula',
          loading: 'lazy'
      }}
    {%- else -%}
      <div class="about-nine-pathways__image-placeholder"></div>
    {%- endif -%}
  </div>

  <div class="about-nine-pathways__content">
    <div class="about-nine-pathways__text">
      <p class="about-nine-pathways__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="about-nine-pathways__heading">{{ section.settings.heading }}</h2>
      <p class="about-nine-pathways__description">{{ section.settings.description }}</p>
    </div>

    <div class="about-nine-pathways__pathways">
      <div class="about-nine-pathways__col">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pathway' and forloop.index <= 5 -%}
            <div class="about-nine-pathways__pathway-item" {{ block.shopify_attributes }}>
              <span class="about-nine-pathways__pathway-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M8.08686 3.97263L9.12366 6.52755C9.5571 7.59603 10.4045 8.44347 11.473 8.87691L14.0279 9.91371C14.5003 10.1056 14.5003 10.7745 14.0279 10.966L11.473 12.0028C10.4045 12.4362 9.5571 13.2837 9.12366 14.3521L8.08686 16.9071C7.89498 17.3794 7.2261 17.3794 7.03458 16.9071L5.99778 14.3521C5.56434 13.2837 4.7169 12.4362 3.64842 12.0028L1.0935 10.966C0.621178 10.7741 0.621178 10.1052 1.0935 9.91371L3.64842 8.87691C4.7169 8.44347 5.56434 7.59603 5.99778 6.52755L7.03458 3.97263C7.2261 3.50031 7.89498 3.50031 8.08686 3.97263ZM14.3807 0.972389L14.6839 1.84647C14.9229 2.53587 15.4647 3.07767 16.1541 3.31671L17.0282 3.61983C17.3507 3.73179 17.3507 4.18791 17.0282 4.29987L16.1541 4.60299C15.4647 4.84203 14.9229 5.38383 14.6839 6.07323L14.3807 6.94731C14.2688 7.26987 13.8127 7.26987 13.7007 6.94731L13.3976 6.07323C13.1585 5.38383 12.6167 4.84203 11.9273 4.60299L11.0533 4.29987C10.7307 4.18791 10.7307 3.73179 11.0533 3.61983L11.9273 3.31671C12.6167 3.07767 13.1585 2.53587 13.3976 1.84647L13.7007 0.972389C13.8123 0.649829 14.2688 0.649829 14.3807 0.972389Z" fill="#3D7E7A"/>
                </svg>
              </span>
              <span class="about-nine-pathways__pathway-label">{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="about-nine-pathways__col">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pathway' and forloop.index > 5 -%}
            <div class="about-nine-pathways__pathway-item" {{ block.shopify_attributes }}>
              <span class="about-nine-pathways__pathway-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M8.08686 3.97263L9.12366 6.52755C9.5571 7.59603 10.4045 8.44347 11.473 8.87691L14.0279 9.91371C14.5003 10.1056 14.5003 10.7745 14.0279 10.966L11.473 12.0028C10.4045 12.4362 9.5571 13.2837 9.12366 14.3521L8.08686 16.9071C7.89498 17.3794 7.2261 17.3794 7.03458 16.9071L5.99778 14.3521C5.56434 13.2837 4.7169 12.4362 3.64842 12.0028L1.0935 10.966C0.621178 10.7741 0.621178 10.1052 1.0935 9.91371L3.64842 8.87691C4.7169 8.44347 5.56434 7.59603 5.99778 6.52755L7.03458 3.97263C7.2261 3.50031 7.89498 3.50031 8.08686 3.97263ZM14.3807 0.972389L14.6839 1.84647C14.9229 2.53587 15.4647 3.07767 16.1541 3.31671L17.0282 3.61983C17.3507 3.73179 17.3507 4.18791 17.0282 4.29987L16.1541 4.60299C15.4647 4.84203 14.9229 5.38383 14.6839 6.07323L14.3807 6.94731C14.2688 7.26987 13.8127 7.26987 13.7007 6.94731L13.3976 6.07323C13.1585 5.38383 12.6167 4.84203 11.9273 4.60299L11.0533 4.29987C10.7307 4.18791 10.7307 3.73179 11.0533 3.61983L11.9273 3.31671C12.6167 3.07767 13.1585 2.53587 13.3976 1.84647L13.7007 0.972389C13.8123 0.649829 14.2688 0.649829 14.3807 0.972389Z" fill="#3D7E7A"/>
                </svg>              
              </span>
              <span class="about-nine-pathways__pathway-label">{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

</section>

<style>
  #about-nine-pathways-{{ section.id }} {
    background-color: #FAF7F2;
    width: 100%;
    display: flex;
    align-items: stretch;
    min-height: 551px;
  }

  @media screen and (min-width: 750px){
    #about-nine-pathways-{{ section.id }} {
      flex-direction: row-reverse !important;
    }
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__image-wrap {
    flex: 0 0 48.75%;
    width: 48.75%;
    overflow: hidden;
    position: relative;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 551px;
    background-color: #D9D9D9;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__content {
    flex: 1;
    background-color: #FAF7F2;
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: center;
    justify-content: center;
    padding: 60px 66px;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
    width: 100%;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1;
    color: #211B18;
    margin: 0;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__heading {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    text-transform: uppercase;
    color: #211B18;
    margin: 0;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__description {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.5;
    color: #6B6B6B;
    margin: 0;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__pathways {
    display: flex;
    gap: 34px;
    align-items: flex-start;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__col {
    display: flex;
    flex-direction: column;
    gap: 13px;
    width: 235px;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__pathway-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__pathway-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #about-nine-pathways-{{ section.id }} .about-nine-pathways__pathway-label {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1;
    color: #211B18;
    white-space: nowrap;
  }

  @media screen and (max-width: 1100px) {
    #about-nine-pathways-{{ section.id }} .about-nine-pathways__content {
      padding: 50px 40px;
    }

    #about-nine-pathways-{{ section.id }} .about-nine-pathways__pathway-label {
      white-space: normal;
      font-size: 16px;
    }
  }

  @media screen and (max-width: 990px) {
    #about-nine-pathways-{{ section.id }} {
      flex-direction: column-reverse;
    }

    #about-nine-pathways-{{ section.id }} .about-nine-pathways__image-wrap {
      width: 100%;
      height: 400px;
    }

    #about-nine-pathways-{{ section.id }} .about-nine-pathways__content {
      padding: 50px 30px;
    }
  }

  @media screen and (max-width: 749px) {
    #about-nine-pathways-{{ section.id }} .about-nine-pathways__image-wrap {
      height: 300px;
    }

    #about-nine-pathways-{{ section.id }} .about-nine-pathways__heading {
      font-size: 28px;
    }

    #about-nine-pathways-{{ section.id }} .about-nine-pathways__pathways {
      {% comment %} flex-direction: column; {% endcomment %}
      gap: 13px;
    }

    #about-nine-pathways-{{ section.id }} .about-nine-pathways__col {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "About - Nine Pathways",
  "tag": "section",
  "class": "about-nine-pathways-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE FORMULA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nine Pathways. One Formula."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "HairScripts™ supports every biological driver of hormonal hair loss — simultaneously. So you're covered at every level, from day one."
    }
  ],
  "blocks": [
    {
      "type": "pathway",
      "name": "Pathway Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Pathway Label",
          "default": "Androgen / DHT activity"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Nine Pathways",
      "blocks": [
        { "type": "pathway", "settings": { "label": "Androgen / DHT activity" } },
        { "type": "pathway", "settings": { "label": "Stress & cortisol signaling" } },
        { "type": "pathway", "settings": { "label": "Scalp inflammation" } },
        { "type": "pathway", "settings": { "label": "Scalp microcirculation" } },
        { "type": "pathway", "settings": { "label": "Nutrient depletion" } },
        { "type": "pathway", "settings": { "label": "Thyroid–follicle function" } },
        { "type": "pathway", "settings": { "label": "Insulin resistance" } },
        { "type": "pathway", "settings": { "label": "Oxidative follicle damage" } },
        { "type": "pathway", "settings": { "label": "Structural strand integrity" } }
      ]
    }
  ]
}
{% endschema %}
