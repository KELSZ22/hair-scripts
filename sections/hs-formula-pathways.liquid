<section id="hs-formula-{{ section.id }}" class="hs-formula">
  <div class="hs-formula__inner">
    <div class="hs-formula__content">
      {% if section.settings.eyebrow != blank %}
        <p class="hs-formula__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hs-formula__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hs-formula__text">
          {{ section.settings.text }}
        </div>
      {% endif %}
<div class="hs-formula__list">

  {% for block in section.blocks %}
    {% if block.settings.item_text != blank %}

      <div class="hs-formula__item" {{ block.shopify_attributes }}>
        <span class="hs-formula__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
            <path d="M7.3476 3.24216L8.3844 5.79708C8.81784 6.86556 9.66528 7.713 10.7338 8.14644L13.2887 9.18324C13.761 9.37512 13.761 10.044 13.2887 10.2355L10.7338 11.2723C9.66528 11.7058 8.81784 12.5532 8.3844 13.6217L7.3476 16.1766C7.15572 16.6489 6.48684 16.6489 6.29532 16.1766L5.25852 13.6217C4.82508 12.5532 3.97764 11.7058 2.90916 11.2723L0.35424 10.2355C-0.11808 10.0436 -0.11808 9.37476 0.35424 9.18324L2.90916 8.14644C3.97764 7.713 4.82508 6.86556 5.25852 5.79708L6.29532 3.24216C6.48684 2.76984 7.15572 2.76984 7.3476 3.24216ZM13.6415 0.24192L13.9446 1.116C14.1836 1.8054 14.7254 2.3472 15.4148 2.58624L16.2889 2.88936C16.6115 3.00132 16.6115 3.45744 16.2889 3.5694L15.4148 3.87252C14.7254 4.11156 14.1836 4.65336 13.9446 5.34276L13.6415 6.21684C13.5295 6.5394 13.0734 6.5394 12.9614 6.21684L12.6583 5.34276C12.4193 4.65336 11.8775 4.11156 11.1881 3.87252L10.314 3.5694C9.99144 3.45744 9.99144 3.00132 10.314 2.88936L11.1881 2.58624C11.8775 2.3472 12.4193 1.8054 12.6583 1.116L12.9614 0.24192C13.073 -0.08064 13.5295 -0.08064 13.6415 0.24192Z" fill="#3D7E7A"/>
          </svg>
        </span>

        <span class="hs-formula__item-text">
          {{ block.settings.item_text }}
        </span>
      </div>

    {% endif %}
  {% endfor %}

</div>
      {% if section.settings.button_label != blank %}
        <a
          class="hs-formula__button"
          href="{{ section.settings.button_link | default: '#' }}"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <div class="hs-formula__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'hs-formula__image',
            loading: 'lazy',
            widths: '375, 550, 750, 1000, 1200, 1600',
            sizes: '(max-width: 768px) 100vw, 50vw'
        }}
      {% else %}
        <div class="hs-formula__placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #hs-formula-{{ section.id }} {
    background-color: #FAF7F2;

    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    {% endif %}
  }

  #hs-formula-{{ section.id }} .hs-formula__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
  }

  #hs-formula-{{ section.id }} .hs-formula__content {
    padding: 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #hs-formula-{{ section.id }} .hs-formula__eyebrow {
    color: {{ section.settings.eyebrow_color }};
    text-align: center;

    /* NewTypography/HEADING/H6 Regular */
    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;

    margin: 0 0 20px;
  }

  #hs-formula-{{ section.id }} .hs-formula__heading {
    color: {{ section.settings.heading_color }};
    font-family: "Cormorant Garamond", serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 16px;
  }

  #hs-formula-{{ section.id }} .hs-formula__text {
    color: {{ section.settings.text_color }};
    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
    text-align: center;
    max-width: 620px;
    margin: 0 auto 38px;
  }

  #hs-formula-{{ section.id }} .hs-formula__text p {
    margin: 0;
  }

  #hs-formula-{{ section.id }} .hs-formula__list {
   display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-flow: column;
  grid-template-rows: repeat(5, auto);
  column-gap: 40px;
  row-gap: 15px;
  max-width: 565px;
  margin: 0 auto 40px;
  width: 100%;
  }

  #hs-formula-{{ section.id }} .hs-formula__item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #hs-formula-{{ section.id }} .hs-formula__item-text {
    color: {{ section.settings.item_text_color }};

    /* NewTypography/HEADING/H6 Regular */
    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  #hs-formula-{{ section.id }} .hs-formula__icon {
    display: inline-flex;
    flex: 0 0 auto;
  }

  #hs-formula-{{ section.id }} .hs-formula__icon svg {
    display: block;
  }

  #hs-formula-{{ section.id }} .hs-formula__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 545px;
    min-height: 51px;
    margin: 0 auto;
    padding: 14px 28px;
    border-radius: 999px;
    background: linear-gradient(90deg, #725270 0%, #725270 42.83%, #371834 100%), linear-gradient(90deg, #8D6B2C 0%, #C9AB64 24.52%, #D4C875 50%, #C9AB64 75%, #8D6B2C 100%);
    color: var(--New-Colors-BG-light, #FAF7F2);

    /* NewTypography/HEADING/H6 Medium */
    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;

    text-decoration: none;
  }

  #hs-formula-{{ section.id }} .hs-formula__media {
    min-height: 548px;
  }

  #hs-formula-{{ section.id }} .hs-formula__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #hs-formula-{{ section.id }} .hs-formula__placeholder {
    width: 100%;
    height: 100%;
    min-height: 548px;
    background: #EAE5DD;
  }

  #hs-formula-{{ section.id }} .hs-formula__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media screen and (max-width: 768px) {
    #hs-formula-{{ section.id }} .hs-formula__inner {
      grid-template-columns: 1fr;
    }

    #hs-formula-{{ section.id }} .hs-formula__content {
      padding: 60px 15px 23px;
    }

    #hs-formula-{{ section.id }} .hs-formula__eyebrow {
      font-size: 14px;
      margin-bottom: 8px;
    }

    #hs-formula-{{ section.id }} .hs-formula__heading {
      font-size: 24px;
      margin-bottom: 16px;
    }

    #hs-formula-{{ section.id }} .hs-formula__text {
      font-size: 14px;
      max-width: 360px;
      margin: 0 auto 18px;
    }

    #hs-formula-{{ section.id }} .hs-formula__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 10px;
      row-gap: 11px;
      max-width: 370px;
      margin: 0 auto 28px;
      width: 100%;
    }

    #hs-formula-{{ section.id }} .hs-formula__item {
      gap: 5px;
      align-items: center;
    }

    #hs-formula-{{ section.id }} .hs-formula__icon svg {
      width: 11px;
      height: 11px;
    }

    #hs-formula-{{ section.id }} .hs-formula__item-text {
      font-size: 14px;
      white-space: nowrap;
    }

    #hs-formula-{{ section.id }} .hs-formula__button {
      max-width: 332px;
      min-height: 51px;
      font-size: 14px;
      padding: 14px 24px;
    }

    #hs-formula-{{ section.id }} .hs-formula__media {
      min-height: 0;
    }

    #hs-formula-{{ section.id }} .hs-formula__image {
      width: 100%;
      height: auto;
    }

    #hs-formula-{{ section.id }} .hs-formula__placeholder {
      min-height: 320px;
    }
  }

  @media screen and (max-width: 400px) {
    #hs-formula-{{ section.id }} .hs-formula__list {
      grid-template-columns: 1fr;
      max-width: 100%;
      row-gap: 11px;
    }

    #hs-formula-{{ section.id }} .hs-formula__item-text {
      white-space: normal;
    }
  }
</style>

