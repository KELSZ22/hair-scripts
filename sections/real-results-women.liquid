<section
  id="real-results-women-{{ section.id }}"
  class="real-results-women-section"
  style="
    --rrw-section-bg: {{ section.settings.section_bg }};
    --rrw-card-bg: {{ section.settings.card_bg }};
    --rrw-heading-color: #211B18;
    --rrw-text-color: #211B18;
    --rrw-muted-color: #211B18;
    --rrw-border-color: {{ section.settings.border_color }};
    --rrw-stat-eyebrow-color: #211B18;
    --rrw-stat-number-color: #211B18;
    --rrw-stat-label-color: #211B18;
  "
>
  <div class="real-results-women__wrap">
    <div class="real-results-women__card">
      <div class="real-results-women__media">
        <div class="real-results-women__image-col">
          <div class="real-results-women__image-wrap">
            {% if section.settings.before_image != blank %}
              <img
                src="{{ section.settings.before_image | image_url: width: 900 }}"
                alt="{{ section.settings.before_image.alt | default: section.settings.before_label | escape }}"
                loading="lazy"
                width="{{ section.settings.before_image.width }}"
                height="{{ section.settings.before_image.height }}"
                class="real-results-women__image"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'real-results-women__image real-results-women__placeholder' }}
            {% endif %}
          </div>

          {% if section.settings.before_label != blank %}
            <div class="real-results-women__caption">{{ section.settings.before_label }}</div>
          {% endif %}
        </div>

        <div class="real-results-women__image-col">
          <div class="real-results-women__image-wrap">
            {% if section.settings.after_image != blank %}
              <img
                src="{{ section.settings.after_image | image_url: width: 900 }}"
                alt="{{ section.settings.after_image.alt | default: section.settings.after_label | escape }}"
                loading="lazy"
                width="{{ section.settings.after_image.width }}"
                height="{{ section.settings.after_image.height }}"
                class="real-results-women__image"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'real-results-women__image real-results-women__placeholder' }}
            {% endif %}
          </div>

          {% if section.settings.after_label != blank %}
            <div class="real-results-women__caption">{{ section.settings.after_label }}</div>
          {% endif %}
        </div>
      </div>

      <div class="real-results-women__content">
        {% if section.settings.eyebrow != blank %}
          <div class="real-results-women__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="real-results-women__title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="real-results-women__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="real-results-women__stats">
            {% for block in section.blocks %}
              <div
                class="real-results-women__stat{% if forloop.last %} real-results-women__stat--last{% endif %}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.eyebrow != blank %}
                  <div class="real-results-women__stat-eyebrow">{{ block.settings.eyebrow }}</div>
                {% endif %}

                {% if block.settings.number != blank %}
                  <div class="real-results-women__stat-number">{{ block.settings.number }}</div>
                {% endif %}

                {% if block.settings.label != blank %}
                  <div class="real-results-women__stat-label">{{ block.settings.label }}</div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <style>
    #real-results-women-{{ section.id }} {
      background: var(--rrw-section-bg);
      padding: 60px 40px;
      box-sizing: border-box;
      color: #211B18;
    }

    #real-results-women-{{ section.id }} .real-results-women__wrap {
      width: 100%;
      max-width: 1440px;
      margin: 0 auto;
      box-sizing: border-box;
    }

    #real-results-women-{{ section.id }} .real-results-women__card {
      border: 0;
      display: flex;
      gap: 30px;
      align-items: center;
      box-sizing: border-box;
    }

    #real-results-women-{{ section.id }} .real-results-women__media {
      flex: 0 1 calc(40% - 15px);
      max-width: calc(40% - 15px);
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      align-items: start;
      box-sizing: border-box;
    }

    #real-results-women-{{ section.id }} .real-results-women__content {
      flex: 0 1 calc(60% - 15px);
      max-width: calc(60% - 15px);
      min-width: 0;
      padding: 6px 0 4px;
      box-sizing: border-box;
    }

    #real-results-women-{{ section.id }} .real-results-women__image-col {
      min-width: 0;
      width: 100%;
    }

    #real-results-women-{{ section.id }} .real-results-women__image-wrap {
      position: relative;
      overflow: hidden;
      background: #f3eee8;
      width: 100%;
      aspect-ratio: 0.72 / 1;
    }

    #real-results-women-{{ section.id }} .real-results-women__image,
    #real-results-women-{{ section.id }} .real-results-women__image-wrap svg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #real-results-women-{{ section.id }} .real-results-women__caption {
      margin-top: 8px;
      text-align: left;
      color: #211B18;
      font-family: "Cormorant Garamond";
      font-size: 18px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    #real-results-women-{{ section.id }} .real-results-women__eyebrow {
      margin: 0 0 10px;
      color: #211B18;
      font-family: "DM Sans";
      font-size: 14px;
      font-style: normal;
      font-weight: 700;
      line-height: normal;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #real-results-women-{{ section.id }} .real-results-women__title {
      margin: 0 0 18px;
      color: #211B18;
      font-family: "Cormorant Garamond";
      font-size: 32px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    #real-results-women-{{ section.id }} .real-results-women__description {
      margin: 0 0 18px;
      color: #211B18;
      font-family: "DM Sans";
      font-size: 18px;
      font-style: normal;
      font-weight: 400;
      line-height: 1.45;
    }

    #real-results-women-{{ section.id }} .real-results-women__description p {
      margin: 0;
      color: #211B18;
    }

    #real-results-women-{{ section.id }} .real-results-women__stats {
      display: grid;
      grid-template-columns: repeat(5, 150px);
      gap: 8px;
      justify-content: start;
      align-items: start;
      width: 100%;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat {
      position: relative;
      width: 150px;
      height: 150px;
      min-height: 0;
      border: 0;
      background: transparent !important;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 12px 8px;
      text-align: center;
      box-sizing: border-box;
      color: #211B18;
      overflow: hidden;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      padding: 2px;
      pointer-events: none;
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat:nth-child(1)::before {
      background: linear-gradient(90deg, #FFFFFF 0%, #237B84 100%);
    }

    #real-results-women-{{ section.id }} .real-results-women__stat:nth-child(2)::before {
      background: linear-gradient(135deg, #FFFFFF 0%, #237B84 100%);
    }

    #real-results-women-{{ section.id }} .real-results-women__stat:nth-child(3)::before {
      background: linear-gradient(180deg, #FFFFFF 0%, #237B84 100%);
    }

    #real-results-women-{{ section.id }} .real-results-women__stat:nth-child(4)::before {
      background: linear-gradient(225deg, #FFFFFF 0%, #237B84 100%);
    }

    #real-results-women-{{ section.id }} .real-results-women__stat:nth-child(5)::before {
      background: linear-gradient(270deg, #FFFFFF 0%, #237B84 100%);
    }

    #real-results-women-{{ section.id }} .real-results-women__stat > * {
      position: relative;
      z-index: 1;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow,
    #real-results-women-{{ section.id }} .real-results-women__stat-label {
      text-align: center;
      font-family: "DM Sans";
      font-size: 8.938px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      color: #211B18;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow {
      margin: 0 0 8px;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat-label {
      margin: 0;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat:not(.real-results-women__stat--last) .real-results-women__stat-number {
      text-align: center;
      font-family: "DM Sans";
      font-size: 35.75px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      letter-spacing: -1.787px;
      text-transform: uppercase;
      color: #211B18;
      margin: 0 0 8px;
    }

    #real-results-women-{{ section.id }} .real-results-women__stat--last .real-results-women__stat-number {
      font-family: "Cormorant Garamond";
      font-size: 20px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      text-transform: uppercase;
      color: #211B18;
      margin: 0 0 8px;
    }

    #real-results-women-{{ section.id }} .real-results-women__placeholder {
      color: rgba(0, 0, 0, 0.18);
      background: rgba(0, 0, 0, 0.04);
    }

    @media screen and (max-width: 1366px) {
      #real-results-women-{{ section.id }} .real-results-women__stats {
        grid-template-columns: repeat(5, 135px);
      }

      #real-results-women-{{ section.id }} .real-results-women__stat {
        width: 135px;
        height: 135px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat:not(.real-results-women__stat--last) .real-results-women__stat-number {
        font-size: 28px;
        letter-spacing: -1.2px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow,
      #real-results-women-{{ section.id }} .real-results-women__stat-label {
        font-size: 8.938px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat--last .real-results-women__stat-number {
        font-size: 18px;
      }
    }

    @media screen and (max-width: 1200px) {
      #real-results-women-{{ section.id }} .real-results-women__card {
        gap: 24px;
      }

      #real-results-women-{{ section.id }} .real-results-women__media {
        flex: 0 1 calc(38% - 12px);
        max-width: calc(38% - 12px);
      }

      #real-results-women-{{ section.id }} .real-results-women__content {
        flex: 0 1 calc(62% - 12px);
        max-width: calc(62% - 12px);
      }

      #real-results-women-{{ section.id }} .real-results-women__stats {
        grid-template-columns: repeat(5, 120px);
      }

      #real-results-women-{{ section.id }} .real-results-women__stat {
        width: 120px;
        height: 120px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat:not(.real-results-women__stat--last) .real-results-women__stat-number {
        font-size: 24px;
        letter-spacing: -0.9px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat--last .real-results-women__stat-number {
        font-size: 16px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow,
      #real-results-women-{{ section.id }} .real-results-women__stat-label {
        font-size: 8.938px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow {
        margin-bottom: 5px;
      }
    }

    @media screen and (max-width: 1024px) {
      #real-results-women-{{ section.id }} .real-results-women__card {
        flex-direction: column;
        align-items: stretch;
        padding: 0;
        gap: 26px;
      }

      #real-results-women-{{ section.id }} .real-results-women__media,
      #real-results-women-{{ section.id }} .real-results-women__content {
        flex: none;
        max-width: none;
        width: 100%;
      }

      #real-results-women-{{ section.id }} .real-results-women__media {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4px;
      }

      #real-results-women-{{ section.id }} .real-results-women__image-col,
      #real-results-women-{{ section.id }} .real-results-women__image-wrap {
        width: 100%;
      }


      #real-results-women-{{ section.id }} .real-results-women__content {
        padding: 0;
      }

      #real-results-women-{{ section.id }} .real-results-women__caption {
        font-size: 16px;
        margin-top: 6px;
      }

      #real-results-women-{{ section.id }} .real-results-women__title {
        font-size: 26px;
        margin-bottom: 10px;
      }

      #real-results-women-{{ section.id }} .real-results-women__description {
        font-size: 14px;
        line-height: 1.35;
        margin-bottom: 18px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stats {
        grid-template-columns: repeat(5, 120px);
        gap: 8px;
        overflow-x: visible;
        padding-bottom: 0;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat {
        width: 120px;
        height: 120px;
        padding: 10px 8px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow,
      #real-results-women-{{ section.id }} .real-results-women__stat-label {
        font-size: 8.938px;
        line-height: normal;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow {
        margin-bottom: 5px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat:not(.real-results-women__stat--last) .real-results-women__stat-number {
        font-size: 34px;
        letter-spacing: -0.8px;
        margin-bottom: 5px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat--last .real-results-women__stat-number {
        font-size: 20px;
        letter-spacing: 0;
      }
    }

    @media screen and (max-width: 768px) {
      #real-results-women-{{ section.id }} {
        padding: 60px 15px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat--last {
        grid-column: 1 / -1;
        height: 95px;
        aspect-ratio: auto;
      }
    }

    @media screen and (max-width: 480px) {
      #real-results-women-{{ section.id }} .real-results-women__media {
        gap: 4px;
      }
    }

    @media screen and (max-width: 450px) {
      #real-results-women-{{ section.id }} .real-results-women__title {
        font-size: 20px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat-eyebrow,
      #real-results-women-{{ section.id }} .real-results-women__stat-label {
        font-size: 8.938px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat:not(.real-results-women__stat--last) .real-results-women__stat-number {
        font-size: 34px;
      }

      #real-results-women-{{ section.id }} .real-results-women__stat--last .real-results-women__stat-number {
        font-size: 20px;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Real results women",
  "settings": [
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "REAL RESULTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results, From Real Women"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua, ut enim ad minim veniam.</p>"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f8f4ee"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#211B18"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#211B18"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Small label color",
      "default": "#211B18"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d8cfc5"
    },
    {
      "type": "color",
      "id": "stat_eyebrow_color",
      "label": "Stat eyebrow color",
      "default": "#211B18"
    },
    {
      "type": "color",
      "id": "stat_number_color",
      "label": "Stat number color",
      "default": "#211B18"
    },
    {
      "type": "color",
      "id": "stat_label_color",
      "label": "Stat label color",
      "default": "#211B18"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "UP TO"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Heading / number",
          "default": "34%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "Less shedding in 8 weeks"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Real results women",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "eyebrow": "UP TO",
            "number": "34%",
            "label": "Less shedding in 8 weeks"
          }
        },
        {
          "type": "stat",
          "settings": {
            "eyebrow": "INCREASE",
            "number": "78%",
            "label": "In active growth phase"
          }
        },
        {
          "type": "stat",
          "settings": {
            "eyebrow": "REDUCTION",
            "number": "35%",
            "label": "In stress shedding"
          }
        },
        {
          "type": "stat",
          "settings": {
            "eyebrow": "MORE THAN JUST A",
            "number": "9X",
            "label": "Multi-pathway follicle support"
          }
        },
        {
          "type": "stat",
          "settings": {
            "eyebrow": "FAST AS",
            "number": "8 WEEKS",
            "label": "Healthier scalp in as little"
          }
        }
      ]
    }
  ]
}
{% endschema %}