<section
  id="hair-concerns-{{ section.id }}"
  class="hair-concerns-section"
  style="
    background-color: {{ section.settings.section_bg }};
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  "
>
  <div class="hair-concerns-wrap">
    <div class="hair-concerns-head">
      {% if section.settings.heading != blank %}
        <h2 class="hair-concerns-title">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hair-concerns-text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div
          class="hair-concerns-tabs"
          role="tablist"
          aria-label="{{ section.settings.heading | escape }}"
        >
          {% for block in section.blocks %}
            <button
              type="button"
              class="hair-concerns-tab{% if forloop.first %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="hair-concerns-panel-{{ section.id }}-{{ block.id }}"
              id="hair-concerns-tab-{{ section.id }}-{{ block.id }}"
              data-tab-target="hair-concerns-panel-{{ section.id }}-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="hair-concerns-panels">
        {% for block in section.blocks %}
          <div
            id="hair-concerns-panel-{{ section.id }}-{{ block.id }}"
            class="hair-concerns-panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="hair-concerns-tab-{{ section.id }}-{{ block.id }}"
          >
            <div class="hair-concerns-card">
              <div class="hair-concerns-media">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 1400 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'hair-concerns-placeholder' }}
                {% endif %}

                {% if block.settings.image_overlay_heading != blank or block.settings.image_overlay_text != blank %}
                  <div class="hair-concerns-media-overlay">
                    {% if block.settings.image_overlay_heading != blank %}
                      <div class="hair-concerns-media-heading">
                        {{ block.settings.image_overlay_heading | escape | newline_to_br }}
                      </div>
                    {% endif %}

                    {% if block.settings.image_overlay_text != blank %}
                      <div class="hair-concerns-media-text">
                        {{ block.settings.image_overlay_text | escape | newline_to_br }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              <div class="hair-concerns-info">
                <div class="hair-concerns-box hair-concerns-box--top">
                  {% if block.settings.problem_label != blank %}
                    <div class="hair-concerns-label">{{ block.settings.problem_label }}</div>
                  {% endif %}

                  {% if block.settings.problem_text != blank %}
                    <div class="hair-concerns-box-text">
                      {{ block.settings.problem_text }}
                    </div>
                  {% endif %}
                </div>

                <div class="hair-concerns-box hair-concerns-box--bottom">
                  {% if block.settings.bottom_box_logo != blank %}
                    <div
                      class="hair-concerns-logo"
                      style="
                        --hc-logo-width: {{ block.settings.bottom_box_logo_width }}px;
                        --hc-logo-width-mobile: {{ block.settings.bottom_box_logo_width_mobile }}px;
                      "
                    >
                      <img
                        src="{{ block.settings.bottom_box_logo | image_url: width: 500 }}"
                        alt="{{ block.settings.bottom_box_logo.alt | default: block.settings.solution_label | escape }}"
                        loading="lazy"
                        width="{{ block.settings.bottom_box_logo.width }}"
                        height="{{ block.settings.bottom_box_logo.height }}"
                      >
                    </div>
                  {% endif %}

                  {% if block.settings.solution_label != blank %}
                    <div class="hair-concerns-label">{{ block.settings.solution_label }}</div>
                  {% endif %}

                  {% if block.settings.solution_text != blank %}
                    <div class="hair-concerns-box-text">
                      {{ block.settings.solution_text }}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <style>
    #hair-concerns-{{ section.id }} {
      padding: 70px 20px;
      background: linear-gradient(90deg, #6BAAB1 0%, #3D7E7A 100%);
    }

    #hair-concerns-{{ section.id }} .hair-concerns-wrap {
      max-width: 1440px;
      margin: 0 auto;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-head {
      text-align: center;
      max-width: 1440px;
      margin: 0 auto 34px;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-title {
      margin: 0 0 12px;
      color: {{ section.settings.heading_color }};
      font-family: "Cormorant Garamond";
      font-size: 32px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-text {
      color: var(--Old-colors-Scheme-1-Text-Light, #FFF);
      text-align: center;
      font-family: "DM Sans";
      font-size: 18px;
      font-style: normal;
      font-weight: 500;
      line-height: normal;
      max-width: 720px;
      margin: 0 auto;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: stretch;
      gap: 12px;
      margin: 24px auto 0;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-tab {
      appearance: none;
      border: 1px solid {{ section.settings.pill_border_color }};
      background: transparent;
      color: {{ section.settings.pill_text_color }};
      border-radius: 999px;
      min-height: 44px;
      padding: 10px 18px;
      font-family: "DM Sans";
      font-size: 18px;
      font-style: normal;
      font-weight: 500;
      line-height: normal;
      text-align: center;
      cursor: pointer;
      transition: 0.25s ease;
      width: auto;
      min-width: 0;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-tab:hover,
    #hair-concerns-{{ section.id }} .hair-concerns-tab.is-active {
      background: #C4A882;
      color: #fff;
      border-color: #C4A882;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-panels {
      position: relative;
      transition: height 0.35s ease;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-panel {
      display: none;
      opacity: 0;
      transition: opacity 0.35s ease;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-panel.is-active {
      display: block;
      opacity: 1;
      position: relative;
      z-index: 2;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-panel.is-current-fade {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      z-index: 1;
      opacity: 1;
      pointer-events: none;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-panel.is-current-fade.is-fade-out {
      opacity: 0;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-panel.is-next-fade {
      display: block;
      position: relative;
      z-index: 2;
      opacity: 0;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-panel.is-next-fade.is-fade-in {
      opacity: 1;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-card {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(320px, 1fr);
      border-radius: 18px;
      overflow: hidden;
      background: {{ section.settings.card_bg }};
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
    }

    #hair-concerns-{{ section.id }} .hair-concerns-media {
      min-height: 100%;
      position: relative;
      overflow: hidden;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(102, 102, 102, 0) 0%, #000000 100%);
    }

    #hair-concerns-{{ section.id }} .hair-concerns-media img,
    #hair-concerns-{{ section.id }} .hair-concerns-media svg {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 100%;
      object-fit: cover;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-media-overlay {
      position: absolute;
      left: 26px;
      right: 26px;
      bottom: 22px;
      z-index: 2;
      color: #fff;
      pointer-events: none;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-media-heading {
      margin: 0 0 10px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.28);
      color: var(--Old-colors-Scheme-1-Text-Light, #FFF);
      font-family: "Tenor Sans";
      font-size: 20px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      letter-spacing: -1px;
      text-transform: uppercase;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-media-text {
      color: var(--Old-colors-Scheme-1-Shadow, #9F9F9F);
      font-family: Fustat;
      font-size: 12px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-info {
      display: grid;
      grid-template-rows: 1fr 1fr;
      min-height: 100%;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-box {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 34px 28px;
      text-align: center;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-box--top {
      background: #fff;
      color: {{ section.settings.top_box_text }};
    }

    #hair-concerns-{{ section.id }} .hair-concerns-box--bottom {
      background: #DBEEEC;
      color: {{ section.settings.bottom_box_text }};
    }

    #hair-concerns-{{ section.id }} .hair-concerns-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-logo img {
      display: block;
      width: var(--hc-logo-width, 160px);
      max-width: 100%;
      height: auto;
      object-fit: contain;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-label {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      margin-bottom: 14px;
      padding: 12px 46px;
      border-radius: 999px;
      background: transparent;
      color: var(--New-Colors-Black, #2A2A2A);
      text-align: center;
      font-family: "Cormorant Garamond";
      font-size: 20px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      text-transform: uppercase;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-label::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 4px;
      background: linear-gradient(90deg, #C9DEE0 0%, #C9DEE0 48%, rgba(201, 222, 224, 0.35) 78%, rgba(201, 222, 224, 0) 100%);
      pointer-events: none;
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-box-title {
      margin: 0 0 10px;
      color: var(--New-Colors-Black, #2A2A2A);
      font-family: "Cormorant Garamond";
      font-size: 20px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      letter-spacing: 0;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-box-text {
      color: var(--New-Colors-Black, #2A2A2A);
      text-align: center;
      font-family: "DM Sans";
      font-size: 14px;
      font-style: normal;
      font-weight: 700;
      line-height: normal;
      margin: 0 auto;
    }

    #hair-concerns-{{ section.id }} .hair-concerns-placeholder {
      background: rgba(255, 255, 255, 0.25);
      color: rgba(0, 0, 0, 0.18);
    }

    @media screen and (max-width: 989px) {
      #hair-concerns-{{ section.id }} {
        padding: 56px 18px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-card {
        grid-template-columns: 1fr;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-media {
        min-height: 360px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-info {
        grid-template-rows: auto auto;
      }
    }

    @media screen and (max-width: 768px) {
      #hair-concerns-{{ section.id }} {
        padding: 40px 15px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-title {
        font-size: 26px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-text {
        font-size: 14px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-logo img {
        width: var(--hc-logo-width-mobile, 140px);
      }
    }

    @media screen and (max-width: 767px) {
      #hair-concerns-{{ section.id }} .hair-concerns-tabs {
        gap: 10px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-tab {
        min-height: 40px;
        padding: 9px 14px;
        font-size: 12px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-media {
        min-height: 280px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-media-overlay {
        left: 18px;
        right: 18px;
        bottom: 18px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-media-heading {
        font-size: 16px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-media-text {
        font-size: 10px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-box {
        padding: 28px 20px;
      }
    }

    @media screen and (max-width: 450px) {
      #hair-concerns-{{ section.id }} .hair-concerns-title {
        font-size: 20px;
      }

      #hair-concerns-{{ section.id }} .hair-concerns-media-heading {
        font-size: 14px;
      }
    }
  </style>

  <script>
    (function() {
      var section = document.getElementById('hair-concerns-{{ section.id }}');
      if (!section) return;

      var tabs = section.querySelectorAll('.hair-concerns-tab');
      var panels = section.querySelectorAll('.hair-concerns-panel');
      var panelsWrap = section.querySelector('.hair-concerns-panels');
      var animationDuration = 350;
      var isAnimating = false;

      function activateTab(tab) {
        if (isAnimating || tab.classList.contains('is-active')) return;

        var targetId = tab.getAttribute('data-tab-target');
        var targetPanel = section.querySelector('#' + targetId);
        var currentTab = section.querySelector('.hair-concerns-tab.is-active');
        var currentPanel = section.querySelector('.hair-concerns-panel.is-active');

        if (!targetPanel) return;

        if (!currentPanel) {
          tabs.forEach(function(item) {
            item.classList.remove('is-active');
            item.setAttribute('aria-selected', 'false');
          });

          panels.forEach(function(panel) {
            panel.classList.remove('is-active');
          });

          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          targetPanel.classList.add('is-active');
          return;
        }

        isAnimating = true;

        if (currentTab) {
          currentTab.classList.remove('is-active');
          currentTab.setAttribute('aria-selected', 'false');
        }

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        var currentHeight = currentPanel.offsetHeight;
        panelsWrap.style.height = currentHeight + 'px';

        currentPanel.classList.add('is-current-fade');
        targetPanel.classList.add('is-next-fade');

        var nextHeight = targetPanel.offsetHeight;

        requestAnimationFrame(function() {
          panelsWrap.style.height = nextHeight + 'px';
          currentPanel.classList.add('is-fade-out');
          targetPanel.classList.add('is-fade-in');
        });

        setTimeout(function() {
          currentPanel.classList.remove('is-active', 'is-current-fade', 'is-fade-out');
          targetPanel.classList.remove('is-next-fade', 'is-fade-in');
          targetPanel.classList.add('is-active');

          panelsWrap.style.height = '';
          isAnimating = false;
        }, animationDuration);
      }

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          activateTab(tab);
        });
      });
    })();
  </script>
</section>

{% schema %}
{
