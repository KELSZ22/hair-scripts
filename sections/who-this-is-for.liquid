          "id": "solution_text",
          "label": "Bottom box text",
          "default": "<p>HairScripts was formulated to support both pathways, not just one.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hair concerns split",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "Postpartum shedding"
          }
        },
        {
          "type": "tab",
