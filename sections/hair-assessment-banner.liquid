<div class="hair-assessment-banner-bg" id="section-{{ section.id }}">
  <div class="hair-assessment-banner-bg__outer">
    <div class="hair-assessment-banner-bg__wrapper">
      <div class="hair-assessment-banner-bg__inner">
        <div class="hair-assessment-banner-bg__content">
          {% if section.settings.badge_text != blank %}
            <div class="hair-assessment-banner-bg__badge">
              {{ section.settings.badge_text }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="hair-assessment-banner-bg__heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <p class="hair-assessment-banner-bg__subheading">
              {{ section.settings.subheading }}
            </p>
          {% endif %}

          {% if section.settings.button_label != blank or section.settings.button_label2 != blank %}
            <div class="two-buttons-container">
              {% if section.settings.button_label != blank %}
                <div class="hair-assessment-banner-bg__button-wrap">
                  <a
                    {% if section.settings.button_link != blank %}
                      href="{{ section.settings.button_link }}"
                    {% else %}
                      role="link"
                      aria-disabled="true"
                    {% endif %}
                    class="hair-assessment-banner-bg__button"
                  >
                    {{ section.settings.button_label }}
                  </a>
                </div>
              {% endif %}

              {% if section.settings.button_label2 != blank %}
                <div class="two hair-assessment-banner-bg__button-wrap">
                  <a
                    {% if section.settings.button_link2 != blank %}
                      href="{{ section.settings.button_link2 }}"
                    {% else %}
                      role="link"
                      aria-disabled="true"
                    {% endif %}
                    class="two hair-assessment-banner-bg__button"
                  >
                    {{ section.settings.button_label2 }}
                  </a>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #section-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
  }

  #section-{{ section.id }} *,
  #section-{{ section.id }} *::before,
  #section-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #section-{{ section.id }} .two-buttons-container {
    display: flex;
    gap: 12px;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__outer {
    width: 100%;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__wrapper {
    position: relative;
    width: 100%;
    min-height: 518px;
    padding: 60px 40px;
    display: flex;
    align-items: center;
    background-color: #DCECED;
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    {% endif %}
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    padding: 0;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 735px;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 26px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    padding: 10px 20px;
    position: relative;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 999px;
    padding: 2px;
    background: linear-gradient(270deg, #98B495 0%, #FFFFFF 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__heading {
    margin: 0 0 14px;
    color: #fff;
    font-family: "Cormorant Garamond";
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -1.4px;
    text-transform: uppercase;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__subheading {
    margin: 0 0 22px;
    color: #fff;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 300;
    line-height: normal;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__button-wrap {
    margin-top: 2px;
  }

  #section-{{ section.id }} .two.hair-assessment-banner-bg__button {
    background: transparent;
    border: 1px solid #fff;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 15px 21px;
    border-radius: 999px;
    background: linear-gradient(90deg, #725270 0%, #4d2449 69%, #481d44 84%, #371834 100%);
    color: #FFFFFF;
    text-decoration: none;
    font-family: "DM Sans";
    font-size: 14px;
    font-style: normal;
    font-weight: 500;
    line-height: 1;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  a.header.hs-science-hero__button.hs-science-hero__button--secondary:hover {
    color: #000;
    background: #fff;
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__button:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  #section-{{ section.id }} .hair-assessment-banner-bg__button-arrow {
    line-height: 1;
  }

  @media screen and (max-width: 1024px) {
    #section-{{ section.id }} .hair-assessment-banner-bg__wrapper {
      min-height: 850px;
      padding: 45px 28px 360px;
      align-items: flex-start;
      justify-content: center;
      background-size: cover;
      background-position: center bottom;

      {% if section.settings.background_image_1024 != blank %}
        background-image: url('{{ section.settings.background_image_1024 | image_url: width: 1800 }}');
      {% endif %}
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__inner {
      max-width: 100%;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__content {
      max-width: 560px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin: 0 auto;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__badge {
      margin-bottom: 18px;
      font-size: 12px;
      padding: 9px 28px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__heading {
      max-width: 500px;
      margin-bottom: 16px;
      font-size: 32px;
      line-height: 1.05;
      letter-spacing: 0;
      text-align: center;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__subheading {
      max-width: 540px !important;
      margin-bottom: 22px;
      font-size: 15px;
      line-height: 1.25;
      text-align: center;
    }

    #section-{{ section.id }} .two-buttons-container {
      width: 100%;
      max-width: 520px;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__button-wrap {
      width: 100%;
      margin-top: 0;
      display: flex;
      justify-content: center;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__button {
      width: 100%;
      max-width: 420px;
      min-height: 48px;
      padding: 14px 24px;
      font-size: 15px;
      font-weight: 700;
      text-align: center;
    }
  }

  @media screen and (max-width: 989px) {
    #section-{{ section.id }} .hair-assessment-banner-bg__heading {
      font-size: 32px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__subheading {
      font-size: 15px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__button {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }} .hair-assessment-banner-bg__wrapper {
      min-height: 760px;
      padding: 40px 15px 320px;
      background-position: center bottom;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__content {
      max-width: 520px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__heading {
      font-size: 24px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__subheading {
      font-size: 14px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__button {
      max-width: 360px;
    }
  }

  @media screen and (max-width: 749px) {
    #section-{{ section.id }} .hair-assessment-banner-bg__wrapper {
      min-height: 720px;
      padding: 40px 15px 300px;
      background-position: center bottom;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__inner {
      align-items: center;
      justify-content: flex-start;
      padding: 0;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 450px) {
    #section-{{ section.id }} .hair-assessment-banner-bg__wrapper {
      padding: 36px 18px 245px;
      background-position: center bottom;

      {% if section.settings.background_image_450 != blank %}
        background-image: url('{{ section.settings.background_image_450 | image_url: width: 900 }}');
      {% endif %}
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__badge {
      font-size: 10px;
      padding: 8px 26px;
      margin-bottom: 14px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__heading {
      max-width: 310px;
      font-size: 24px;
      line-height: 1.08;
      margin-bottom: 14px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__subheading {
      max-width: 320px !important;
      font-size: 12px;
      line-height: 1.25;
      margin-bottom: 16px;
    }

    #section-{{ section.id }} .two-buttons-container {
      max-width: 280px;
      gap: 10px;
    }

    #section-{{ section.id }} .hair-assessment-banner-bg__button {
      max-width: 280px;
      min-height: 39px;
      padding: 12px 18px;
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Hair assessment banner bg",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image_1024",
      "label": "Background image 1024px"
    },
    {
      "type": "image_picker",
      "id": "background_image_450",
      "label": "Background image 450px"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "FREE • TAKES 2 MINUTES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NOT SURE WHAT’S CAUSING YOUR HAIR THINNING? LET’S FIND OUT."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "In just 10 questions, unlock a biological blueprint tailored to your life stage and hair type. Get the exact root-cause analysis you need to get the best results."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Take the Free Hair Assessment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label2",
      "label": "Second button label",
      "default": "Take the Free Hair Assessment"
    },
    {
      "type": "url",
      "id": "button_link2",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "Hair assessment banner bg"
    }
  ]
}
{% endschema %}