<div class="hs-video-carousel-section" id="section-{{ section.id }}">
  <div class="hs-video-carousel-outer">
    <div class="hs-video-carousel-wrapper">

      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="hs-video-carousel-header">
          {% if section.settings.heading != blank %}
            <h2 class="hs-video-carousel-heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <p class="hs-video-carousel-subheading">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="hs-video-carousel-slider" data-section-id="{{ section.id }}">
          <div class="hs-video-carousel-viewport">
            <div class="hs-video-carousel-track">
              {% for block in section.blocks %}
                {% assign video_url = block.settings.video_link | append: '' %}
                {% assign youtube_id = blank %}

                {% if video_url contains 'youtu.be/' %}
                  {% assign youtube_id = video_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
                {% elsif video_url contains 'youtube.com/shorts/' %}
                  {% assign youtube_id = video_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
                {% elsif video_url contains 'youtube.com/embed/' %}
                  {% assign youtube_id = video_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
                {% elsif video_url contains 'youtube.com/live/' %}
                  {% assign youtube_id = video_url | split: 'youtube.com/live/' | last | split: '?' | first | split: '&' | first | split: '/' | first %}
                {% elsif video_url contains 'v=' %}
                  {% assign youtube_id = video_url | split: 'v=' | last | split: '&' | first | split: '#' | first %}
                {% endif %}

                <div class="hs-video-carousel-slide" {{ block.shopify_attributes }}>
                  <div
                    class="hs-video-carousel-card{% if block.settings.video_link != blank %} hs-video-carousel-card-button{% endif %}"
                    {% if block.settings.video_link != blank %}
                      role="button"
                      tabindex="0"
                      data-hs-video-url="{{ block.settings.video_link | escape }}"
                      data-hs-youtube-id="{{ youtube_id | escape }}"
                      aria-label="Play YouTube video"
                    {% endif %}
                  >
                    <div class="hs-video-carousel-thumb-wrap">
                      {% if youtube_id != blank %}
                        <img
                          class="hs-video-carousel-thumb"
                          src="https://img.youtube.com/vi/{{ youtube_id }}/maxresdefault.jpg"
                          onerror="this.onerror=null; this.src='https://img.youtube.com/vi/{{ youtube_id }}/hqdefault.jpg';"
                          alt="YouTube video thumbnail"
                          loading="lazy"
                        >
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'hs-video-carousel-thumb hs-video-carousel-placeholder' }}
                      {% endif %}

                      {% if block.settings.video_link != blank %}
                        <span class="hs-video-carousel-play" aria-hidden="true">
                          <svg xmlns="http://www.w3.org/2000/svg" width="69" height="69" viewBox="0 0 69 69" fill="none">
                            <path d="M34.5 5.17578C18.6473 5.17578 5.75 18.0731 5.75 33.9258C5.75 49.7784 18.6473 62.6758 34.5 62.6758C50.3527 62.6758 63.25 49.7784 63.25 33.9258C63.25 18.0731 50.3527 5.17578 34.5 5.17578ZM34.5 9.48828C48.022 9.48828 58.9375 20.4038 58.9375 33.9258C58.9375 47.4478 48.022 58.3633 34.5 58.3633C20.978 58.3633 10.0625 47.4478 10.0625 33.9258C10.0625 20.4038 20.978 9.48828 34.5 9.48828ZM28.2615 22.4258C27.8852 22.42 27.5058 22.5139 27.1665 22.7065C26.488 23.086 26.0715 23.8029 26.0715 24.582V43.2695C26.0715 44.0487 26.488 44.7655 27.1665 45.145C27.4943 45.3319 27.8627 45.4258 28.2278 45.4258C28.6159 45.4258 29.0031 45.3239 29.3452 45.1169L44.7646 35.7732C45.4115 35.3822 45.8035 34.6819 45.8035 33.9258C45.8035 33.1697 45.4115 32.4722 44.7646 32.0784L29.3452 22.7346C29.0132 22.5334 28.6377 22.4315 28.2615 22.4258Z" fill="white"/>
                          </svg>
                        </span>
                      {% endif %}
                    </div>

                    <div class="hs-video-carousel-content">
                      {% if block.settings.video_link != blank %}
                        <h3
                          class="hs-video-carousel-title"
                          data-hs-youtube-title
                          data-video-url="{{ block.settings.video_link | escape }}"
                        >
                          Loading video title...
                        </h3>
                      {% else %}
                        <h3 class="hs-video-carousel-title">
                          Video
                        </h3>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

          {% if section.blocks.size > 1 %}
            <div class="review-carousel-controls">
              <button type="button" class="review-carousel-arrow review-carousel-prev" aria-label="Previous reviews">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M14.5 6.5L9 12L14.5 17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>

              <div class="review-carousel-dots">
                {% for block in section.blocks %}
                  <button
                    type="button"
                    class="review-carousel-dot{% if forloop.first %} is-active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    aria-label="Go to video {{ forloop.index }}"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  ></button>
                {% endfor %}
              </div>

              <button type="button" class="review-carousel-arrow review-carousel-next" aria-label="Next reviews">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M9.5 6.5L15 12L9.5 17.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  #section-{{ section.id }} {
    background: #FAF7F2;
    width: 100%;
  }

  #section-{{ section.id }} .hs-video-carousel-outer {
    width: 100%;
  }

  #section-{{ section.id }} .hs-video-carousel-wrapper {
    width: 100%;
    padding: 60px 40px;
  }

  #section-{{ section.id }} .hs-video-carousel-header {
    padding: 0 0 40px;
  }

  #section-{{ section.id }} .hs-video-carousel-heading {
    margin: 0 0 10px;
    color: #2B221E;
    font-family: "Cormorant Garamond";
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -1.2px;
    text-transform: uppercase;
  }

  #section-{{ section.id }} .hs-video-carousel-subheading {
    margin: 0;
    color: #2B221E;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 300;
    line-height: normal;
  }

  #section-{{ section.id }} .hs-video-carousel-slider {
    width: 100%;
  }

  #section-{{ section.id }} .hs-video-carousel-viewport {
    overflow: hidden;
    width: 100%;
  }

  #section-{{ section.id }} .hs-video-carousel-track {
    display: flex;
    gap: 14px;
    will-change: transform;
    transition: transform 0.35s ease;
  }

  #section-{{ section.id }} .hs-video-carousel-slide {
    flex: 0 0 calc((100% - 56px) / 4.35);
    max-width: calc((100% - 56px) / 4.35);
    min-width: 0;
  }

  #section-{{ section.id }} .hs-video-carousel-card,
  #section-{{ section.id }} .hs-video-carousel-card-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    text-decoration: none;
    color: inherit;
    cursor: default;
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
  }

  #section-{{ section.id }} .hs-video-carousel-card-button {
    cursor: pointer;
  }

  #section-{{ section.id }} .hs-video-carousel-card-button:hover .hs-video-carousel-play {
    transform: translate(-50%, -50%) scale(1.04);
  }

  #section-{{ section.id }} .hs-video-carousel-thumb-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #3D7E7A;
    padding: 12px;
    height: clamp(260px, 30vw, 420px);
    box-sizing: border-box;
  }

  #section-{{ section.id }} .hs-video-carousel-thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  #section-{{ section.id }} .hs-video-carousel-placeholder {
    background: #D7ECEA;
  }

  #section-{{ section.id }} .hs-video-carousel-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 57px;
    height: 57px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.2s ease;
  }

  #section-{{ section.id }} .hs-video-carousel-play svg {
    width: 57px;
    height: 57px;
    display: block;
  }

  #section-{{ section.id }} .hs-video-carousel-thumb-wrap.is-playing {
    background: #000;
  }

  #section-{{ section.id }} .hs-video-carousel-inline-player {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 6px;
    background: #000;
  }

  #section-{{ section.id }} video.hs-video-carousel-inline-player {
    object-fit: cover;
  }

  #section-{{ section.id }} .hs-video-carousel-content {
    padding-top: 10px;
  }

  #section-{{ section.id }} .hs-video-carousel-title {
    margin: 0;
    color: #2B221E;
    font-family: "DM Sans";
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.4;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #section-{{ section.id }} .review-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 18px;
  }

  #section-{{ section.id }} .review-carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #2B221E;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #section-{{ section.id }} .review-carousel-arrow:hover {
    opacity: 0.7;
  }

  #section-{{ section.id }} .review-carousel-arrow svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  #section-{{ section.id }} .review-carousel-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  #section-{{ section.id }} .review-carousel-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(43, 34, 30, 0.28);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  #section-{{ section.id }} .review-carousel-dot.is-active {
    background: #211B18;
    transform: scale(1.05);
  }

  @media screen and (max-width: 1024px) {
    #section-{{ section.id }} .hs-video-carousel-slide {
      flex: 0 0 calc((100% - 42px) / 3.25);
      max-width: calc((100% - 42px) / 3.25);
    }

    #section-{{ section.id }} .hs-video-carousel-thumb-wrap {
      height: 380px;
    }
  }

  @media screen and (max-width: 989px) {
    #section-{{ section.id }} .hs-video-carousel-heading {
      text-align: center;
      font-size: 32px;
    }

    #section-{{ section.id }} .hs-video-carousel-subheading {
      font-size: 14px;
      font-weight: 400;
      line-height: normal;
      max-width: 760px;
      text-align: center;
      margin: 0 auto;
    }

    #section-{{ section.id }} .hs-video-carousel-header {
      padding-bottom: 18px;
    }

    #section-{{ section.id }} .hs-video-carousel-title {
      text-align: center;
    }
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }} .hs-video-carousel-wrapper {
      padding: 40px 0;
    }

    #section-{{ section.id }} .hs-video-carousel-header {
      padding-left: 15px;
      padding-right: 15px;
    }

    #section-{{ section.id }} .hs-video-carousel-heading {
      font-size: 24px;
    }

    #section-{{ section.id }} .hs-video-carousel-title {
      font-size: 14px;
    }

    #section-{{ section.id }} .hs-video-carousel-viewport {
      width: 100%;
      overflow: hidden;
    }

    #section-{{ section.id }} .hs-video-carousel-track {
      gap: 14px;
    }

    #section-{{ section.id }} .hs-video-carousel-slide {
      flex: 0 0 72%;
      max-width: 72%;
    }

    #section-{{ section.id }} .hs-video-carousel-thumb-wrap {
      height: 360px;
    }

    #section-{{ section.id }} .review-carousel-controls {
      display: none;
    }
  }

  @media screen and (max-width: 500px) {
    #section-{{ section.id }} .hs-video-carousel-slide {
      flex: 0 0 72%;
      max-width: 72%;
    }

    #section-{{ section.id }} .hs-video-carousel-thumb-wrap {
      height: 330px;
    }

    #section-{{ section.id }} .review-carousel-controls {
      margin-top: 14px;
    }
  }

  @media screen and (max-width: 450px) {
    #section-{{ section.id }} .hs-video-carousel-heading {
      font-size: 24px;
    }

    #section-{{ section.id }} .hs-video-carousel-thumb-wrap {
      height: 300px;
    }
  }
</style>

<script>
  (function () {
    const youtubeTitleCache = new Map();

    function initHsVideoCarousel(section) {
      if (!section || section.dataset.carouselReady === 'true') return;

      const slider = section.querySelector('.hs-video-carousel-slider');
      const viewport = section.querySelector('.hs-video-carousel-viewport');
      const track = section.querySelector('.hs-video-carousel-track');

      if (!slider || !viewport || !track) return;

      const prevButton = section.querySelector('.review-carousel-prev');
      const nextButton = section.querySelector('.review-carousel-next');
      const dots = Array.from(section.querySelectorAll('.review-carousel-dot'));

      const originalSlides = Array.from(track.children).map(function (slide) {
        return slide.cloneNode(true);
      });

      const totalSlides = originalSlides.length;
      if (!totalSlides) return;

      section.dataset.carouselReady = 'true';

      let cloneCount = 0;
      let currentPosition = 0;
      let isAnimating = false;
      let resizeTimer;
      let startX = 0;
      let endX = 0;
      let pointerStartX = 0;
      let pointerStartY = 0;
      let lastVideoActivationTime = 0;

      function mod(value, total) {
        return ((value % total) + total) % total;
      }

      function isMobilePeekMode() {
        return window.innerWidth <= 768;
      }

      function getVisibleCount() {
        if (window.innerWidth <= 768) return 3;
        if (window.innerWidth <= 1024) return 4;
        return 5;
      }

      function getStep() {
        const firstSlide = track.querySelector('.hs-video-carousel-slide');
        if (!firstSlide) return 0;

        const styles = window.getComputedStyle(track);
        const gap = parseFloat(styles.columnGap || styles.gap) || 0;

        return firstSlide.getBoundingClientRect().width + gap;
      }

      function appendCloneByIndex(index) {
        const slide = originalSlides[mod(index, totalSlides)].cloneNode(true);
        track.appendChild(slide);
      }

      function setActiveDot() {
        if (!dots.length) return;

        const activeIndex = mod(currentPosition - cloneCount, totalSlides);

        dots.forEach(function (dot, index) {
          const isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-current', isActive ? 'true' : 'false');
        });
      }

      function updateSlider(animate) {
        const step = getStep();
        const firstSlide = track.querySelector('.hs-video-carousel-slide');

        if (!step || !firstSlide) return;

        let offset = currentPosition * step;

        if (isMobilePeekMode()) {
          const viewportWidth = viewport.getBoundingClientRect().width;
          const slideWidth = firstSlide.getBoundingClientRect().width;
          const centerOffset = (viewportWidth - slideWidth) / 2;

          offset = offset - centerOffset;
        }

        track.style.transition = animate ? 'transform 0.35s ease' : 'none';
        track.style.transform = 'translate3d(' + (offset * -1) + 'px, 0, 0)';

        setActiveDot();
      }

      function fetchYouTubeTitle(videoUrl) {
        if (!videoUrl) return Promise.resolve('Watch video');

        if (youtubeTitleCache.has(videoUrl)) {
          return youtubeTitleCache.get(videoUrl);
        }

        const request = fetch('https://www.youtube.com/oembed?url=' + encodeURIComponent(videoUrl) + '&format=json')
          .then(function (response) {
            if (!response.ok) throw new Error('YouTube oEmbed failed');
            return response.json();
          })
          .then(function (data) {
            return data && data.title ? data.title : 'Watch video';
          })
          .catch(function () {
            return fetch('https://noembed.com/embed?url=' + encodeURIComponent(videoUrl))
              .then(function (response) {
                if (!response.ok) throw new Error('Noembed failed');
                return response.json();
              })
              .then(function (data) {
                return data && data.title ? data.title : 'Watch video';
              })
              .catch(function () {
                return 'Watch video';
              });
          });

        youtubeTitleCache.set(videoUrl, request);

        return request;
      }

      function updateYouTubeTitles() {
        const titleElements = Array.from(track.querySelectorAll('[data-hs-youtube-title]'));

        titleElements.forEach(function (titleElement) {
          const videoUrl = titleElement.getAttribute('data-video-url');

          if (!videoUrl) {
            titleElement.textContent = 'Watch video';
            return;
          }

          fetchYouTubeTitle(videoUrl).then(function (title) {
            titleElement.textContent = title;
            titleElement.setAttribute('title', title);

            const card = titleElement.closest('.hs-video-carousel-card-button');

            if (card) {
              card.setAttribute('aria-label', 'Play video: ' + title);
            }

            const image = card ? card.querySelector('.hs-video-carousel-thumb') : null;

            if (image) {
              image.setAttribute('alt', title);
            }
          });
        });
      }

      function buildTrack(activeIndex) {
        cloneCount = Math.max(getVisibleCount() + 2, 4);

        track.innerHTML = '';

        for (let i = totalSlides - cloneCount; i < totalSlides; i++) {
          appendCloneByIndex(i);
        }

        for (let i = 0; i < totalSlides; i++) {
          track.appendChild(originalSlides[i].cloneNode(true));
        }

        for (let i = 0; i < cloneCount; i++) {
          appendCloneByIndex(i);
        }

        currentPosition = cloneCount + activeIndex;

        requestAnimationFrame(function () {
          updateSlider(false);
          updateYouTubeTitles();
        });
      }

      function normalizePosition() {
        let jumped = false;

        if (currentPosition < cloneCount) {
          currentPosition += totalSlides;
          jumped = true;
        } else if (currentPosition >= cloneCount + totalSlides) {
          currentPosition -= totalSlides;
          jumped = true;
        }

        if (jumped) {
          updateSlider(false);
        }

        isAnimating = false;
        setActiveDot();
      }

      function goToPrev() {
        if (isAnimating) return;

        isAnimating = true;
        currentPosition -= 1;
        updateSlider(true);
      }

      function goToNext() {
        if (isAnimating) return;

        isAnimating = true;
        currentPosition += 1;
        updateSlider(true);
      }

      function goToIndex(index) {
        if (isAnimating) return;

        const targetIndex = mod(index, totalSlides);
        const activeIndex = mod(currentPosition - cloneCount, totalSlides);

        if (targetIndex === activeIndex) return;

        isAnimating = true;
        currentPosition = cloneCount + targetIndex;
        updateSlider(true);
      }

      function getYouTubeId(url) {
        let parsedUrl;

        try {
          parsedUrl = new URL(url);
        } catch (e) {
          return '';
        }

        const hostname = parsedUrl.hostname.replace('www.', '');

        if (hostname === 'youtu.be') {
          return parsedUrl.pathname.replace('/', '');
        }

        if (hostname.includes('youtube.com')) {
          if (parsedUrl.pathname.includes('/shorts/')) {
            return parsedUrl.pathname.split('/shorts/')[1].split('/')[0];
          }

          if (parsedUrl.pathname.includes('/embed/')) {
            return parsedUrl.pathname.split('/embed/')[1].split('/')[0];
          }

          return parsedUrl.searchParams.get('v') || '';
        }

        return '';
      }

      function getVimeoId(url) {
        let parsedUrl;

        try {
          parsedUrl = new URL(url);
        } catch (e) {
          return '';
        }

        const hostname = parsedUrl.hostname.replace('www.', '');

        if (!hostname.includes('vimeo.com')) return '';

        const parts = parsedUrl.pathname.split('/').filter(Boolean);
        return parts.length ? parts[parts.length - 1] : '';
      }

      function isDirectVideo(url) {
        return /\.(mp4|webm|ogg)(\?.*)?$/i.test(url);
      }

      function createIframe(src) {
        const iframe = document.createElement('iframe');

        iframe.className = 'hs-video-carousel-inline-player';
        iframe.src = src;
        iframe.title = 'Video player';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.loading = 'eager';

        return iframe;
      }

      function createVideo(src) {
        const video = document.createElement('video');

        video.className = 'hs-video-carousel-inline-player';
        video.src = src;
        video.controls = true;
        video.autoplay = true;
        video.muted = true;
        video.playsInline = true;

        video.addEventListener('loadedmetadata', function () {
          video.play().catch(function () {});
        });

        return video;
      }

      function buildVideoElement(videoUrl) {
        const youtubeId = getYouTubeId(videoUrl);
        const vimeoId = getVimeoId(videoUrl);

        if (youtubeId) {
          return createIframe('https://www.youtube.com/embed/' + youtubeId + '?autoplay=1&mute=1&rel=0&playsinline=1&enablejsapi=1');
        }

        if (vimeoId) {
          return createIframe('https://player.vimeo.com/video/' + vimeoId + '?autoplay=1&muted=1&playsinline=1');
        }

        if (isDirectVideo(videoUrl)) {
          return createVideo(videoUrl);
        }

        return createIframe(videoUrl);
      }

      function playVideoInsideCard(videoCard) {
        if (!videoCard) return;

        const videoUrl = videoCard.getAttribute('data-hs-video-url');
        const thumbWrap = videoCard.querySelector('.hs-video-carousel-thumb-wrap');

        if (!videoUrl || !thumbWrap || thumbWrap.classList.contains('is-playing')) return;

        const videoElement = buildVideoElement(videoUrl);

        thumbWrap.innerHTML = '';
        thumbWrap.appendChild(videoElement);
        thumbWrap.classList.add('is-playing');
        videoCard.classList.add('is-playing');
      }

      function activateVideoFromEvent(event) {
        const videoCard = event.target.closest('.hs-video-carousel-card-button');

        if (!videoCard || !track.contains(videoCard)) return false;

        event.preventDefault();
        event.stopPropagation();

        lastVideoActivationTime = Date.now();
        playVideoInsideCard(videoCard);

        return true;
      }

      track.addEventListener('pointerdown', function (event) {
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
      }, true);

      track.addEventListener('pointerup', function (event) {
        const movedX = Math.abs(event.clientX - pointerStartX);
        const movedY = Math.abs(event.clientY - pointerStartY);
        const isDrag = movedX > 8 || movedY > 8;

        if (isDrag) return;

        activateVideoFromEvent(event);
      }, true);

      track.addEventListener('click', function (event) {
        if (Date.now() - lastVideoActivationTime < 500) {
          event.preventDefault();
          event.stopPropagation();
          return;
        }

        activateVideoFromEvent(event);
      }, true);

      track.addEventListener('keydown', function (event) {
        const videoCard = event.target.closest('.hs-video-carousel-card-button');

        if (!videoCard || !track.contains(videoCard)) return;

        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          event.stopPropagation();

          playVideoInsideCard(videoCard);
        }
      });

      track.addEventListener('transitionend', function () {
        normalizePosition();
      });

      if (prevButton) {
        prevButton.addEventListener('click', function () {
          goToPrev();
        });
      }

      if (nextButton) {
        nextButton.addEventListener('click', function () {
          goToNext();
        });
      }

      if (dots.length) {
        dots.forEach(function (dot) {
          dot.addEventListener('click', function () {
            const index = parseInt(dot.getAttribute('data-index'), 10) || 0;
            goToIndex(index);
          });
        });
      }

      viewport.addEventListener('touchstart', function (e) {
        if (isAnimating) return;
        startX = e.touches[0].clientX;
      }, { passive: true });

      viewport.addEventListener('touchend', function (e) {
        if (isAnimating) return;

        endX = e.changedTouches[0].clientX;

        if (startX - endX > 50) {
          goToNext();
        } else if (endX - startX > 50) {
          goToPrev();
        }
      }, { passive: true });

      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);

        resizeTimer = setTimeout(function () {
          const activeIndex = mod(currentPosition - cloneCount, totalSlides);
          isAnimating = false;
          buildTrack(activeIndex);
        }, 150);
      });

      buildTrack(0);
    }

    function initAllHsVideoCarousels(scope) {
      const root = scope || document;
      const sections = root.querySelectorAll('.hs-video-carousel-section');

      sections.forEach(function (section) {
        initHsVideoCarousel(section);
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      initAllHsVideoCarousels(document);
    });

    document.addEventListener('shopify:section:load', function (event) {
      initAllHsVideoCarousels(event.target);
    });
  })();
</script>

