<section
  id="faq-category-tabs-{{ section.id }}"
  class="faq-category-tabs-section"
  style="
    --faq-bg: {{ section.settings.section_bg }};
    --faq-heading: {{ section.settings.heading_color }};
    --faq-subtext: {{ section.settings.subtext_color }};
    --faq-tab-bg: {{ section.settings.tab_bg }};
    --faq-tab-text: {{ section.settings.tab_text }};
    --faq-tab-active-bg: {{ section.settings.tab_active_bg }};
    --faq-tab-active-text: {{ section.settings.tab_active_text }};
    --faq-item-border: {{ section.settings.item_border }};
    --faq-item-bg: {{ section.settings.item_bg }};
    --faq-item-active-bg: {{ section.settings.item_active_bg }};
    --faq-question: {{ section.settings.question_color }};
    --faq-question-active: {{ section.settings.question_active_color }};
    --faq-answer: {{ section.settings.answer_color }};
    --faq-button-bg: {{ section.settings.button_bg }};
    --faq-button-text: {{ section.settings.button_text }};
  "
>
  <div class="faq-category-tabs__wrap">
    <div class="faq-category-tabs__header">
      {% if section.settings.heading != blank %}
        <h2 class="faq-category-tabs__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="faq-category-tabs__subheading">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

      <div class="faq-category-tabs__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        <button
          type="button"
          class="faq-category-tabs__tab is-active"
          role="tab"
          aria-selected="true"
          data-tab="category-1"
        >
          {{ section.settings.category_1_label }}
        </button>

        <button
          type="button"
          class="faq-category-tabs__tab"
          role="tab"
          aria-selected="false"
          data-tab="category-2"
        >
          {{ section.settings.category_2_label }}
        </button>

        <button
          type="button"
          class="faq-category-tabs__tab"
          role="tab"
          aria-selected="false"
          data-tab="category-3"
        >
          {{ section.settings.category_3_label }}
        </button>

        <button
          type="button"
          class="faq-category-tabs__tab"
          role="tab"
          aria-selected="false"
          data-tab="category-4"
        >
          {{ section.settings.category_4_label }}
        </button>
      </div>
    </div>

    <div class="faq-category-tabs__items" data-faq-items>
      {% for block in section.blocks %}
        <div
          class="faq-category-tabs__item{% if forloop.first and block.settings.category == 'category-1' %} is-active{% endif %}"
          data-category="{{ block.settings.category }}"
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="faq-category-tabs__question"
            aria-expanded="{% if forloop.first and block.settings.category == 'category-1' %}true{% else %}false{% endif %}"
          >
            <span class="faq-category-tabs__question-text">{{ block.settings.question }}</span>
            <span class="faq-category-tabs__icon" aria-hidden="true"></span>
          </button>

          <div
            class="faq-category-tabs__answer-wrapper"
            {% unless forloop.first and block.settings.category == 'category-1' %}hidden{% endunless %}
          >
            <div class="faq-category-tabs__answer">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="faq-category-tabs__footer">
      {% if section.settings.footer_text != blank %}
        <div class="faq-category-tabs__footer-text">{{ section.settings.footer_text }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="faq-category-tabs__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>

  <style>
    #faq-category-tabs-{{ section.id }} {
      background: var(--faq-bg);
      padding: 52px 20px 46px;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__wrap {
      max-width: 980px;
      margin: 0 auto;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__header {
      max-width: 760px;
      margin: 0 auto 24px;
      text-align: center;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__heading {
      margin: 0 0 8px;
      color: var(--faq-heading);
      font-size: 28px;
      line-height: 1.1;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__subheading {
      max-width: 560px;
      margin: 0 auto 18px;
      color: var(--faq-subtext);
      font-size: 12px;
      line-height: 1.5;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__subheading p {
      margin: 0;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__tabs {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__tab {
      appearance: none;
      border: 0;
      background: var(--faq-tab-bg);
      color: var(--faq-tab-text);
      min-height: 28px;
      padding: 7px 16px;
      border-radius: 999px;
      font-size: 10px;
      line-height: 1;
      cursor: pointer;
      transition: 0.25s ease;
      white-space: nowrap;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__tab:hover,
    #faq-category-tabs-{{ section.id }} .faq-category-tabs__tab.is-active {
      background: var(--faq-tab-active-bg);
      color: var(--faq-tab-active-text);
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__items {
      max-width: 760px;
      margin: 0 auto;
      border-top: 1px solid var(--faq-item-border);
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__item {
      background: var(--faq-item-bg);
      border-bottom: 1px solid var(--faq-item-border);
      display: none;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__item.is-visible {
      display: block;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__item.is-active {
      background: var(--faq-item-active-bg);
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__question {
      width: 100%;
      border: 0;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      text-align: left;
      padding: 14px 18px;
      cursor: pointer;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__question-text {
      color: var(--faq-question);
      font-size: 12px;
      line-height: 1.45;
      transition: color 0.2s ease;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__item.is-active .faq-category-tabs__question-text {
      color: var(--faq-question-active);
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__icon {
      position: relative;
      width: 14px;
      height: 14px;
      flex: 0 0 14px;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__icon::before,
    #faq-category-tabs-{{ section.id }} .faq-category-tabs__icon::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      background: currentColor;
      transform: translate(-50%, -50%);
      transition: 0.2s ease;
      color: inherit;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__icon::before {
      width: 12px;
      height: 1px;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__icon::after {
      width: 1px;
      height: 12px;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__item.is-active .faq-category-tabs__icon::after {
      opacity: 0;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__question,
    #faq-category-tabs-{{ section.id }} .faq-category-tabs__icon {
      color: var(--faq-question);
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__item.is-active .faq-category-tabs__question,
    #faq-category-tabs-{{ section.id }} .faq-category-tabs__item.is-active .faq-category-tabs__icon {
      color: var(--faq-question-active);
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__answer-wrapper {
      padding: 0 18px 16px;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__answer {
      color: var(--faq-answer);
      font-size: 11px;
      line-height: 1.6;
      max-width: 680px;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__answer p {
      margin: 0;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__footer {
      margin-top: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      text-align: center;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__footer-text {
      color: var(--faq-subtext);
      font-size: 12px;
      line-height: 1.4;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 30px;
      padding: 7px 16px;
      background: var(--faq-button-bg);
      color: var(--faq-button-text);
      border-radius: 999px;
      text-decoration: none;
      font-size: 10px;
      line-height: 1;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    #faq-category-tabs-{{ section.id }} .faq-category-tabs__button:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    @media screen and (max-width: 767px) {
      #faq-category-tabs-{{ section.id }} {
        padding: 38px 14px 34px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__heading {
        font-size: 22px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__subheading {
        font-size: 11px;
        margin-bottom: 16px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__tabs {
        gap: 6px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__tab {
        font-size: 9px;
        padding: 7px 12px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__question {
        padding: 12px 14px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__question-text {
        font-size: 11px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__answer-wrapper {
        padding: 0 14px 14px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__answer {
        font-size: 10px;
      }

      #faq-category-tabs-{{ section.id }} .faq-category-tabs__footer {
        gap: 8px;
      }
    }
  </style>

  <script>
    (function() {
      var section = document.getElementById('faq-category-tabs-{{ section.id }}');
      if (!section) return;

      var tabs = section.querySelectorAll('.faq-category-tabs__tab');
      var items = section.querySelectorAll('.faq-category-tabs__item');

      function closeAllVisibleItems() {
        items.forEach(function(item) {
          if (!item.classList.contains('is-visible')) return;
          item.classList.remove('is-active');

          var button = item.querySelector('.faq-category-tabs__question');
          var answer = item.querySelector('.faq-category-tabs__answer-wrapper');

          if (button) button.setAttribute('aria-expanded', 'false');
          if (answer) answer.hidden = true;
        });
      }

      function openFirstVisibleItem() {
        var firstVisible = section.querySelector('.faq-category-tabs__item.is-visible');
        if (!firstVisible) return;

        firstVisible.classList.add('is-active');

        var button = firstVisible.querySelector('.faq-category-tabs__question');
        var answer = firstVisible.querySelector('.faq-category-tabs__answer-wrapper');

        if (button) button.setAttribute('aria-expanded', 'true');
        if (answer) answer.hidden = false;
      }

      function filterItems(category) {
        items.forEach(function(item) {
          var match = item.getAttribute('data-category') === category;

          item.classList.remove('is-active');
          item.classList.toggle('is-visible', match);

          var button = item.querySelector('.faq-category-tabs__question');
          var answer = item.querySelector('.faq-category-tabs__answer-wrapper');

          if (button) button.setAttribute('aria-expanded', 'false');
          if (answer) answer.hidden = true;
        });

        openFirstVisibleItem();
      }

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var category = tab.getAttribute('data-tab');

          tabs.forEach(function(item) {
            item.classList.remove('is-active');
            item.setAttribute('aria-selected', 'false');
          });

          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');

          filterItems(category);
        });
      });

      items.forEach(function(item) {
        var button = item.querySelector('.faq-category-tabs__question');
        var answer = item.querySelector('.faq-category-tabs__answer-wrapper');

        if (!button || !answer) return;

        button.addEventListener('click', function() {
          var isOpen = item.classList.contains('is-active');

          closeAllVisibleItems();

          if (!isOpen) {
            item.classList.add('is-active');
            button.setAttribute('aria-expanded', 'true');
            answer.hidden = false;
          }
        });
      });

      filterItems('category-1');
    })();
  </script>
</section>

{% schema %}
{
  "name": "FAQ category tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Answers to your most important questions about hair thinning, ingredients, and results.</p>"
    },
    {
      "type": "text",
      "id": "category_1_label",
      "label": "Category 1 label",
      "default": "Category 1"
    },
    {
      "type": "text",
      "id": "category_2_label",
      "label": "Category 2 label",
      "default": "Category 2"
    },
    {
      "type": "text",
      "id": "category_3_label",
      "label": "Category 3 label",
      "default": "Category 3"
    },
    {
      "type": "text",
      "id": "category_4_label",
      "label": "Category 4 label",
      "default": "Category 4"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#d8e6e3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#6a5b51"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#75685f"
    },
    {
      "type": "color",
      "id": "tab_bg",
      "label": "Tab background",
      "default": "#eef4f2"
    },
    {
      "type": "color",
      "id": "tab_text",
      "label": "Tab text color",
      "default": "#6a5b51"
    },
    {
      "type": "color",
      "id": "tab_active_bg",
      "label": "Active tab background",
      "default": "#3d7f7d"
    },
    {
      "type": "color",
      "id": "tab_active_text",
      "label": "Active tab text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "item_border",
      "label": "FAQ border color",
      "default": "#a9bbb7"
    },
    {
      "type": "color",
      "id": "item_bg",
      "label": "FAQ item background",
      "default": "rgba(255,255,255,0)"
    },
    {
      "type": "color",
      "id": "item_active_bg",
      "label": "Active FAQ background",
      "default": "#3d7f7d"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question color",
      "default": "#6a5b51"
    },
    {
      "type": "color",
      "id": "question_active_color",
      "label": "Active question color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#d4ad6b"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "category-1",
          "options": [
            { "value": "category-1", "label": "Category 1" },
            { "value": "category-2", "label": "Category 2" },
            { "value": "category-3", "label": "Category 3" },
            { "value": "category-4", "label": "Category 4" }
          ]
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is this for all hair types and textures?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. This formula is designed for a wide range of hair types, textures, and concerns, from shedding to hormonal or stress-related thinning.</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "FAQ category tabs",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "category": "category-1",
            "question": "Is this for all hair types and textures?",
            "answer": "<p>Yes. This formula is designed for a wide range of hair types, textures, and concerns, from shedding to hormonal or stress-related thinning.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "category-1",
            "question": "How is HairScript different from other brands?",
            "answer": "<p>HairScript focuses on root-cause support with a more complete, science-led approach instead of surface-level claims.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "category-1",
            "question": "How soon will I see results?",
            "answer": "<p>Some people notice early changes in how their hair feels within the first month, while fuller visible changes often take longer.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "category-2",
            "question": "Will this make me shed more before it gets better?",
            "answer": "<p>Not usually, but everyone is different. Hair cycles take time, so consistency matters more than overnight expectations.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "category-3",
            "question": "Can men use this too?",
            "answer": "<p>This depends on the formula and positioning of the product, but many of the supportive ingredients can be relevant more broadly.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "category-4",
            "question": "What if I've had shedding for years?",
            "answer": "<p>Long-term shedding can have several causes. That is exactly why a root-cause, long-view approach matters.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}