        },
        {
          "type": "credential",
          "settings": {
            "text": "Trichology Certification (In Progress)"
          }
        },
        {
          "type": "credential",
          "settings": {
            "text": "Active YouTube Education Community"
          }
        }
      ]
    }
  ]
}
{% endschema %}