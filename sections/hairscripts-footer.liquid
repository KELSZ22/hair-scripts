<script>
  (function () {
    function initHsFooterNewsletter(scope) {
      const root = scope || document;
      const forms = root.querySelectorAll('.hs-footer__newsletter-form');

      forms.forEach(function (form) {
        if (form.dataset.hsFooterNewsletterReady === 'true') return;

        form.dataset.hsFooterNewsletterReady = 'true';

        const input = form.querySelector('.hs-footer__newsletter-input');
        const button = form.querySelector('.hs-footer__newsletter-button');
        const message = form.querySelector('.hs-footer__form-message');

        if (!input || !button || !message) return;

        function setLoading(isLoading) {
          button.disabled = isLoading;
          button.classList.toggle('is-loading', isLoading);
        }

        function clearMessage() {
          message.textContent = '';
          message.classList.remove('is-visible', 'is-success', 'is-error');
        }

        function showMessage(type, text) {
          message.textContent = text;
          message.classList.remove('is-success', 'is-error');
          message.classList.add('is-visible', type === 'success' ? 'is-success' : 'is-error');
        }

        function isValidEmail(email) {
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        }

        function getSectionId() {
          const shopifySection = form.closest('.shopify-section');
          if (!shopifySection || !shopifySection.id) return 'hairscripts-footer';
          return shopifySection.id.replace(/^shopify-section-/, '');
        }

        function urlHasCustomerPosted(url) {
          return /[?&]customer_posted=true(?:&|$)/.test(url || '');
        }

        function parseNewsletterFormState(html) {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const responseForm = doc.querySelector('.hs-footer__newsletter-form');

          if (!responseForm) {
            return {
              needsCaptcha: doc.querySelector('.shopify-challenge__container') !== null,
              successText: '',
              errorText: ''
            };
          }

          const successEl = responseForm.querySelector('[data-hs-newsletter-status="success"]');
          const errorEl = responseForm.querySelector('[data-hs-newsletter-status="error"]');

          return {
            needsCaptcha: doc.querySelector('.shopify-challenge__container') !== null,
            successText: successEl ? successEl.textContent.trim() : '',
            errorText: errorEl ? errorEl.textContent.trim() : ''
          };
        }

        function fetchSectionHtml(pageUrl) {
          const sectionUrl = new URL(pageUrl || window.location.href, window.location.origin);
          sectionUrl.searchParams.set('section_id', getSectionId());
          return fetch(sectionUrl.toString(), {
            credentials: 'same-origin',
            headers: { Accept: 'text/html' }
          }).then(function (response) {
            return response.text();
          });
        }

        function isAlreadySubscribedMessage(text) {
          return /already|subscribed|member|unavailable/i.test(text);
        }

        function applyNewsletterState(state) {
          if (state.needsCaptcha) {
            showMessage('error', 'Please complete the verification and try again.');
            return;
          }

          if (state.successText) {
            showMessage('success', state.successText);
            form.reset();
            return;
          }

          if (state.errorText) {
            if (isAlreadySubscribedMessage(state.errorText)) {
              showMessage('success', 'Thank you! You are now subscribed.');
              form.reset();
              return;
            }

            showMessage('error', state.errorText);
            return;
          }

          showMessage('success', 'Thank you! You are now subscribed.');
          form.reset();
        }

        form.addEventListener('submit', function (event) {
          event.preventDefault();

          const email = input.value.trim();

          clearMessage();

          if (!email || !isValidEmail(email)) {
            showMessage('error', 'Please enter a valid email address.');
            return;
          }

          setLoading(true);

          const formData = new FormData(form);

          fetch(form.action, {
            method: 'POST',
            body: formData,
            credentials: 'same-origin',
            headers: {
              Accept: 'text/html'
            }
          })
            .then(function (response) {
              const responseUrl = response.url || '';

              if (urlHasCustomerPosted(responseUrl)) {
                return { posted: true, url: responseUrl, html: '' };
              }

              return response.text().then(function (html) {
                return {
                  posted: false,
                  url: responseUrl,
                  html: html
                };
              });
            })
            .then(function (result) {
              if (urlHasCustomerPosted(result.url)) {
                applyNewsletterState({ needsCaptcha: false, successText: 'Thank you! You are now subscribed.', errorText: '' });
                return;
              }

              const pageState = parseNewsletterFormState(result.html || '');

              if (pageState.successText || pageState.errorText || pageState.needsCaptcha) {
                applyNewsletterState(pageState);
                return;
              }

              return fetchSectionHtml(result.url).then(function (sectionHtml) {
                applyNewsletterState(parseNewsletterFormState(sectionHtml));
              });
            })
            .catch(function () {
              showMessage('error', 'Something went wrong. Please try again.');
            })
            .finally(function () {
              setLoading(false);
            });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initHsFooterNewsletter(document);
      });
    } else {
      initHsFooterNewsletter(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      initHsFooterNewsletter(event.target);
    });
  })();
</script>

