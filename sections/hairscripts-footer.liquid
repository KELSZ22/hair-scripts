<div class="hs-footer" id="section-{{ section.id }}">
<span id="hs-footer" class="hs-footer__scroll-anchor" tabindex="-1" aria-hidden="true"></span>
  <div class="hs-footer__outer">
    <div class="hs-footer__wrapper">

      <div class="hs-footer__top">
        <div class="hs-footer__brand-col">
          <div class="hs-footer__brand-wrap">
            <div class="hs-footer__founder-wrap">
              <div class="hs-footer__founder-ring">
                <div class="hs-footer__founder-ring-inner">
                  {% if section.settings.founder_image != blank %}
                    {{
                      section.settings.founder_image
                      | image_url: width: 800
                      | image_tag:
                        class: 'hs-footer__founder-image',
                        loading: 'lazy',
                        widths: '200, 400, 600, 800',
                        sizes: '120px',
                        alt: section.settings.founder_name
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'hs-footer__founder-image hs-footer__founder-placeholder' }}
                  {% endif %}
                </div>
              </div>

              <div class="hs-footer__founder-badge">
                <div class="hs-footer__founder-badge-inner">
                  {% if section.settings.founder_name != blank %}
                    <p class="hs-footer__founder-name">{{ section.settings.founder_name }}</p>
                  {% endif %}
                  {% if section.settings.founder_title != blank %}
                    <p class="hs-footer__founder-title">{{ section.settings.founder_title }}</p>
                  {% endif %}
                </div>
              </div>
            </div>

            {% if section.settings.founder_blurb != blank %}
              <div class="hs-footer__brand-copy">
                {{ section.settings.founder_blurb }}
              </div>
            {% endif %}
          </div>
        </div>

        <div class="hs-footer__menu-col">
          {% if section.settings.quick_links_heading != blank %}
            <h3 class="hs-footer__menu-heading">{{ section.settings.quick_links_heading }}</h3>
          {% endif %}

          {% assign quick_links = linklists[section.settings.quick_links_menu].links %}
          {% if quick_links.size > 0 %}
            <ul class="hs-footer__menu-list">
              {% for link in quick_links %}
                <li class="hs-footer__menu-item">
                  <a href="{{ link.url }}" class="hs-footer__menu-link">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>

        <div class="hs-footer__menu-col">
          {% if section.settings.customer_care_heading != blank %}
            <h3 class="hs-footer__menu-heading">{{ section.settings.customer_care_heading }}</h3>
          {% endif %}

          {% assign customer_care_links = linklists[section.settings.customer_care_menu].links %}
          {% if customer_care_links.size > 0 %}
            <ul class="hs-footer__menu-list">
              {% for link in customer_care_links %}
                <li class="hs-footer__menu-item">
                  <a href="{{ link.url }}" class="hs-footer__menu-link">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>

        <div class="hs-footer__signup-col">
          {% if section.settings.newsletter_heading != blank %}
            <h3 class="hs-footer__signup-heading">{{ section.settings.newsletter_heading }}</h3>
          {% endif %}

          {% if section.settings.newsletter_text != blank %}
            <div class="hs-footer__signup-text">{{ section.settings.newsletter_text }}</div>
          {% endif %}

          {%- assign hs_footer_newsletter_form_id = 'hs-footer-newsletter-' | append: section.id -%}
          {% form 'customer', id: hs_footer_newsletter_form_id, class: 'hs-footer__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="return_to" value="{{ request.path }}{{ request.search }}#hs-footer">

            <div class="hs-footer__newsletter-field">
              <input
                type="email"
                name="contact[email]"
                class="hs-footer__newsletter-input"
                value="{% if customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                aria-label="{{ section.settings.newsletter_placeholder }}"
                required
              >
            </div>

            <button type="submit" class="hs-footer__newsletter-button">
              <span class="hs-footer__newsletter-button-text">
                {{ section.settings.newsletter_button_label }}
              </span>
              <span class="hs-footer__newsletter-spinner" aria-hidden="true"></span>
            </button>

            <div class="hs-footer__form-message" aria-live="polite"></div>

            {% if form.posted_successfully? and form.id == hs_footer_newsletter_form_id %}
              <div
                class="hs-footer__form-message hs-footer__form-message--success"
                data-hs-newsletter-status="success"
              >
                Thank you! You are now subscribed.
              </div>
            {% endif %}

            {% if form.errors and form.id == hs_footer_newsletter_form_id %}
              <div
                class="hs-footer__form-message hs-footer__form-message--error"
                data-hs-newsletter-status="error"
              >
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
          {% endform %}

          {% if section.settings.social_heading != blank %}
            <p class="hs-footer__social-heading">{{ section.settings.social_heading }}</p>
          {% endif %}

          <div class="hs-footer__socials">
            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" class="hs-footer__social-link hs-footer__social-link--facebook" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20.9651 20.9651" fill="none">
                  <path d="M15.1414 0H5.82363C2.62063 0 0 2.62063 0 5.82363V15.1414C0 18.3444 2.62063 20.9651 5.82363 20.9651H9.02662V13.1032H8.15308C7.34942 13.1032 6.69717 12.4509 6.69717 11.6473C6.69717 10.8436 7.34942 10.1913 8.15308 10.1913H9.02662V9.3178C9.02662 7.23061 10.7248 5.53244 12.812 5.53244H13.9767C14.7804 5.53244 15.4326 6.18469 15.4326 6.98835C15.4326 7.79201 14.7804 8.44426 13.9767 8.44426H12.812C12.3309 8.44426 11.9384 8.83561 11.9384 9.3178V10.1913H13.9767C14.7804 10.1913 15.4326 10.8436 15.4326 11.6473C15.4326 12.4509 14.7804 13.1032 13.9767 13.1032H11.9384V20.9651H15.1414C18.3444 20.9651 20.9651 18.3444 20.9651 15.1414V5.82363C20.9651 2.62063 18.3444 0 15.1414 0Z" fill="white"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" class="hs-footer__social-link hs-footer__social-link--instagram" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="3.49414 3.49316 20.9651 20.9651" fill="none">
                  <path d="M9.31777 3.49316C6.10662 3.49316 3.49414 6.10564 3.49414 9.31679V18.6346C3.49414 21.8457 6.10662 24.4582 9.31777 24.4582H18.6356C21.8467 24.4582 24.4592 21.8457 24.4592 18.6346V9.31679C24.4592 6.10564 21.8467 3.49316 18.6356 3.49316H9.31777ZM20.0915 6.40498C20.8951 6.40498 21.5474 7.05722 21.5474 7.86088C21.5474 8.66454 20.8951 9.31679 20.0915 9.31679C19.2878 9.31679 18.6356 8.66454 18.6356 7.86088C18.6356 7.05722 19.2878 6.40498 20.0915 6.40498ZM13.9767 8.15206C17.1878 8.15206 19.8003 10.7645 19.8003 13.9757C19.8003 17.1868 17.1878 19.7993 13.9767 19.7993C10.7655 19.7993 8.15304 17.1868 8.15304 13.9757C8.15304 10.7645 10.7655 8.15206 13.9767 8.15206ZM13.9767 11.0639C13.2044 11.0639 12.4638 11.3707 11.9177 11.9167C11.3716 12.4628 11.0649 13.2034 11.0649 13.9757C11.0649 14.748 11.3716 15.4886 11.9177 16.0347C12.4638 16.5807 13.2044 16.8875 13.9767 16.8875C14.7489 16.8875 15.4896 16.5807 16.0356 16.0347C16.5817 15.4886 16.8885 14.748 16.8885 13.9757C16.8885 13.2034 16.5817 12.4628 16.0356 11.9167C15.4896 11.3707 14.7489 11.0639 13.9767 11.0639Z" fill="white"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.youtube_url != blank %}
              <a href="{{ section.settings.youtube_url }}" class="hs-footer__social-link hs-footer__social-link--youtube" aria-label="YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="22" viewBox="2.32935 3.49414 23.2945 20.9651" fill="none">
                  <path d="M21.7476 4.00895C19.4648 3.66652 16.8511 3.49414 13.9766 3.49414C11.1021 3.49414 8.48841 3.66652 6.20555 4.00895C3.9588 4.34672 2.32935 6.2359 2.32935 8.50013V19.4532C2.32935 21.7174 3.9588 23.6054 6.20555 23.9432C8.48841 24.2868 11.1021 24.4592 13.9766 24.4592C16.8511 24.4592 19.4648 24.2868 21.7476 23.9444C23.9944 23.6066 25.6238 21.7174 25.6238 19.4532V8.50013C25.6238 6.2359 23.9944 4.34672 21.7476 4.00895ZM17.9064 15.4908L13.0996 18.2547C11.9348 18.9244 10.4813 18.0835 10.4813 16.7406V11.2128C10.4813 9.86868 11.9348 9.02891 13.0996 9.69863L17.9064 12.4625C19.0746 13.1334 19.0746 14.8199 17.9064 15.4908Z" fill="white"/>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.tiktok_url != blank %}
              <a href="{{ section.settings.tiktok_url }}" class="hs-footer__social-link hs-footer__social-link--tiktok" aria-label="TikTok">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="3.49438 3.49414 20.9651 20.9651" fill="none">
                  <path d="M20.6741 3.49414H7.27974C5.19255 3.49414 3.49438 5.19231 3.49438 7.2795V20.6738C3.49438 22.761 5.19255 24.4592 7.27974 24.4592H20.6741C22.7613 24.4592 24.4594 22.761 24.4594 20.6738V7.2795C24.4594 5.19231 22.7613 3.49414 20.6741 3.49414ZM18.3458 14.0605C18.3143 14.0594 18.2817 14.0582 18.2503 14.0547C17.7157 14.0081 17.0157 13.8136 16.3192 13.4782L16.2551 16.3446C16.212 18.271 14.6105 19.8026 12.6841 19.7595C10.7576 19.7164 9.226 18.1149 9.26909 16.1885C9.29239 15.1286 9.78739 14.149 10.6272 13.4991C11.2631 13.0053 12.1786 13.1241 12.6701 13.7612C13.1616 14.3971 13.0451 15.3114 12.4092 15.803C12.2683 15.9124 12.1844 16.0755 12.1809 16.2525C12.1739 16.5728 12.429 16.8407 12.7505 16.8477C13.0719 16.8547 13.3386 16.5996 13.3456 16.2782L13.4947 9.58216C13.5122 8.7785 14.1784 8.14139 14.9832 8.15886C15.7881 8.17634 16.424 8.84256 16.4065 9.64738C16.3914 10.3427 17.8228 11.094 18.5065 11.1534C19.3079 11.2233 19.8995 11.9291 19.8308 12.7304C19.7586 13.5003 19.1052 14.078 18.3458 14.0605Z" fill="white"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="hs-footer__divider"></div>

      <div class="hs-footer__logo-wrap">
        {% if section.settings.footer_logo != blank %}
          {{
            section.settings.footer_logo
            | image_url: width: 800
            | image_tag:
              class: 'hs-footer__logo-image',
              loading: 'lazy',
              widths: '200, 400, 600, 800',
              sizes: '340px',
              alt: shop.name
          }}
        {% elsif section.settings.logo_text != blank %}
          <div class="hs-footer__logo-text">{{ section.settings.logo_text }}</div>
        {% endif %}
      </div>

      {% if section.settings.disclaimer_text != blank %}
        <div class="hs-footer__disclaimer-wrap">
          <div class="hs-footer__disclaimer">
            {{ section.settings.disclaimer_text }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.copyright_text != blank %}
        <div class="hs-footer__bottom">
<p class="hs-footer__copyright">
  © 2026 HairScripts. All rights reserved.
  <span class="hs-footer__copyright-divider">|</span>

  <span class="hs-footer__credit-break">
    <a
      href="https://launchtoprofitmedia.com"
      target="_blank"
      rel="noopener noreferrer"
      class="hs-footer__credit-link"
    >
      Optimized by Launch to Profit Media
    </a>
  </span>
</p>
</div>
      {% endif %}

    </div>
  </div>
</div>

<style>
  #section-{{ section.id }} {
    background: #171717;
    width: 100%;
  }

  #section-{{ section.id }} .hs-footer__scroll-anchor {
    display: block;
    height: 0;
    scroll-margin-top: var(--header-height, 80px);
  }

  #section-{{ section.id }} .hs-footer__outer,
  #section-{{ section.id }} .hs-footer__wrapper {
    width: 100%;
  }

  #section-{{ section.id }} .hs-footer__wrapper {
    padding: 60px 40px;
  }

  #section-{{ section.id }} .hs-footer__top {
    display: flex;
    gap: 42px;
    align-items: start;
  }

  .hs-footer__brand-col {
    width: 40%;
  }

  .hs-footer__menu-col {
    width: 20%;
  }

  .hs-footer__signup-col {
    width: 20%;
  }

  #section-{{ section.id }} .hs-footer__brand-wrap {
    display: flex;
    gap: 63px;
    align-items: center;
  }

  #section-{{ section.id }} .hs-footer__founder-wrap {
    position: relative;
  }

  #section-{{ section.id }} .hs-footer__founder-ring {
    width: 218px;
    height: 218px;
    border: 3px solid #A96744;
    border-radius: 50%;
    padding: 8px;
  }

  #section-{{ section.id }} .hs-footer__founder-ring-inner {
    width: 100%;
    height: 100%;
    border: 5px solid #D79066;
    border-radius: 50%;
    overflow: hidden;
    background: #2c2c2c;
  }

  #section-{{ section.id }} .hs-footer__founder-image,
  #section-{{ section.id }} .hs-footer__founder-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #section-{{ section.id }} .hs-footer__founder-badge {
    position: absolute;
    right: -90px;
    bottom: 6px;
    z-index: 3;
  }

  #section-{{ section.id }} .hs-footer__founder-badge-inner {
    min-width: 140px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid #E6D8CC;
    background: #F4EFEA;
    text-align: center;
  }

  #section-{{ section.id }} .hs-footer__founder-name {
    margin: 0 0 1px;
    color: #2B221E;
    font-family: "DM Sans";
    font-size: 11px;
    font-weight: 700;
    line-height: normal;
  }

  #section-{{ section.id }} .hs-footer__founder-title {
    margin: 0;
    color: #8A837C;
    font-family: "DM Sans";
    font-size: 8px;
    font-weight: 400;
    line-height: 1.25;
  }

  #section-{{ section.id }} .hs-footer__brand-copy {
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 18px;
    font-weight: 300;
    line-height: 1.45;
    max-width: 250px;
    margin-bottom: 50px;
  }

  #section-{{ section.id }} .hs-footer__brand-copy p {
    margin: 0;
  }

  #section-{{ section.id }} .hs-footer__menu-heading {
    margin: 0 0 14px;
    padding-bottom: 6px;
    border-bottom: 2px solid rgba(255,255,255,0.28);
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 14px;
    font-weight: 500;
    line-height: normal;
    text-transform: uppercase;
    width: 130px;
  }

  #section-{{ section.id }} .hs-footer__signup-heading {
    margin: 0 0 14px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255,255,255,0.28);
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 18px;
    font-weight: 500;
    line-height: normal;
    text-transform: uppercase;
  }

  #section-{{ section.id }} .hs-footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #section-{{ section.id }} .hs-footer__menu-item {
    margin-bottom: 6px;
  }

  #section-{{ section.id }} .hs-footer__menu-item:last-child {
    margin-bottom: 0;
  }

  #section-{{ section.id }} .hs-footer__menu-link {
    color: rgba(255,255,255,0.86);
    text-decoration: none;
    font-family: "DM Sans";
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    transition: opacity 0.2s ease;
  }

  #section-{{ section.id }} .hs-footer__menu-link:hover {
    opacity: 0.75;
  }

  #section-{{ section.id }} .hs-footer__signup-text {
    color: rgba(255,255,255,0.86);
    font-family: "DM Sans";
    font-size: 12px;
    font-weight: 400;
    line-height: normal;
    margin-bottom: 12px;
    max-width: 240px;
  }

  #section-{{ section.id }} .hs-footer__signup-text p {
    margin: 0;
  }

  #section-{{ section.id }} .hs-footer__newsletter-form {
    margin: 0 0 16px;
  }

  #section-{{ section.id }} .hs-footer__newsletter-field {
    margin-bottom: 10px;
  }

  #section-{{ section.id }} .hs-footer__newsletter-input {
    width: 100%;
    height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.7);
    background: transparent;
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 12px;
    text-align: center;
    outline: none;
  }

  #section-{{ section.id }} .hs-footer__newsletter-input::placeholder {
    color: rgba(255,255,255,0.72);
    text-align: center;
  }

  #section-{{ section.id }} .hs-footer__newsletter-button {
    position: relative;
    width: 100%;
    height: 38px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(90deg, #725270 0%, #4d2449 69%, #481d44 84%, #371834 100%);
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #section-{{ section.id }} .hs-footer__newsletter-button:disabled {
    cursor: not-allowed;
    opacity: 0.82;
  }

  #section-{{ section.id }} .hs-footer__newsletter-button-text {
    transition: opacity 0.2s ease;
  }

  #section-{{ section.id }} .hs-footer__newsletter-button.is-loading .hs-footer__newsletter-button-text {
    opacity: 0;
  }

  #section-{{ section.id }} .hs-footer__newsletter-spinner {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.35);
    border-top-color: #FFFFFF;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    animation: hs-footer-spin 0.75s linear infinite;
  }

  #section-{{ section.id }} .hs-footer__newsletter-button.is-loading .hs-footer__newsletter-spinner {
    opacity: 1;
  }

  @keyframes hs-footer-spin {
    to {
      transform: rotate(360deg);
    }
  }

  #section-{{ section.id }} .hs-footer__form-message {
    display: none;
    margin: 10px 0 0;
    font-family: "DM Sans";
    font-size: 11px;
    line-height: 1.4;
    text-align: center;
  }

  #section-{{ section.id }} .hs-footer__form-message.is-visible,
  #section-{{ section.id }} .hs-footer__form-message--success,
  #section-{{ section.id }} .hs-footer__form-message--error {
    display: block;
  }

  #section-{{ section.id }} .hs-footer__form-message--success,
  #section-{{ section.id }} .hs-footer__form-message.is-success {
    color: #FFFFFF;
  }

  #section-{{ section.id }} .hs-footer__form-message--error,
  #section-{{ section.id }} .hs-footer__form-message.is-error {
    color: #f0c8c8;
  }

  #section-{{ section.id }} .hs-footer__social-heading {
    margin: 0 0 8px;
    color: #FFFFFF;
    font-family: "DM Sans";
    font-size: 18px;
    font-weight: 500;
    line-height: 1.2;
  }

  #section-{{ section.id }} .hs-footer__socials {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #section-{{ section.id }} .hs-footer__social-link {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    overflow: visible;
  }

  #section-{{ section.id }} .hs-footer__social-link svg {
    display: block;
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
  }

  #section-{{ section.id }} .hs-footer__social-link--youtube {
    width: 24px;
    flex-basis: 24px;
  }

  #section-{{ section.id }} .hs-footer__social-link--youtube svg {
    width: 24px;
    height: 22px;
  }

  #section-{{ section.id }} .hs-footer__divider {
    height: 1px;
    background: rgba(255,255,255,0.16);
    margin: 28px 0 26px;
  }

  #section-{{ section.id }} .hs-footer__logo-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 18px;
  }

  #section-{{ section.id }} .hs-footer__logo-image {
    display: block;
    max-width: 340px;
    width: 100%;
    height: auto;
  }

  #section-{{ section.id }} .hs-footer__logo-text {
    color: #FFFFFF;
    font-family: "Cormorant Garamond";
    font-size: 48px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -1.5px;
    text-transform: uppercase;
    text-align: center;
  }

  #section-{{ section.id }} .hs-footer__disclaimer-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 14px;
  }

  #section-{{ section.id }} .hs-footer__disclaimer {
    width: auto;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,0.56);
    color: rgba(255,255,255,0.86);
    text-align: center;
    font-family: "DM Sans";
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
  }

  #section-{{ section.id }} .hs-footer__bottom {
    display: flex;
    justify-content: center;
  }

