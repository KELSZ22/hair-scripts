<section
  id="hs-root-causes-{{ section.id }}"
  class="hs-root-causes color-{{ section.settings.color_scheme }}"
>
  <div class="hs-root-causes__inner">
    <div class="hs-root-causes__header">
      {% if section.settings.eyebrow != blank %}
        <p class="hs-root-causes__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hs-root-causes__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hs-root-causes__text">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    <div class="hs-root-causes__grid">
      {% for block in section.blocks %}
        <div class="hs-root-causes__card" {{ block.shopify_attributes }}>
          <div class="hs-root-causes__card-content">
            {% if block.settings.title != blank %}
              <h3 class="hs-root-causes__card-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="hs-root-causes__card-text">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.result != blank %}
            <p class="hs-root-causes__card-result">
  <span class="hs-root-causes__arrow">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0.5 5.9H9.6L5.2 1.5L6.6 0.1L13.5 7L6.6 13.9L5.2 12.5L9.6 8.1H0.5V5.9Z" fill="white"></path>
    </svg>
  </span>

  <span>
    {{ block.settings.result }}
  </span>
</p>
            {% endif %}
          </div>

          {% if block.settings.number != blank %}
            <div class="hs-root-causes__number">
              {{ block.settings.number }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #hs-root-causes-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 12%, rgba(126, 226, 218, 0.55), transparent 34%),
      linear-gradient(120deg, {{ section.settings.background_color_left }} 0%, {{ section.settings.background_color_right }} 100%);
    color: {{ section.settings.text_color }};
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__inner {
    position: relative;
    padding: 60px 40px;
    box-sizing: border-box;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__header {
    width: 100%;
    text-align: center;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__eyebrow {
    margin: 0 0 18px;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 0;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__heading {
    margin: 0;
    font-family: "Cormorant Garamond";
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__text {
    margin-top: 24px;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__text p {
    margin: 0;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 52px 46px;
    margin-top: 72px;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__card {
    position: relative;
    min-height: 176px;
    padding: 34px 140px 34px 36px;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.04);
    box-sizing: border-box;
    display: flex;
    align-items: center;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__card-content {
    position: relative;
    z-index: 2;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__card-title {
    margin: 0 0 16px;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    color: {{ section.settings.card_title_color }};
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__card-text {
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__card-text p {
    margin: 0;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__card-result {
    margin: 18px 0 0;
    font-family: "DM Sans", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    display: flex;
    align-items: center;
    gap: 5px;
    font-style: italic;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__arrow {
     display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  }

  #hs-root-causes-{{ section.id }} .hs-root-causes__number {
    position: absolute;
    top: 30px;
    right: 34px;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    border: 4px solid {{ section.settings.number_border_color }};
    background: {{ section.settings.number_background_color }};
    color: {{ section.settings.number_color }};
    font-family: "DM Sans";
    font-size: 32px;
    font-style: normal;
    font-weight: 400;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  @media screen and (max-width: 768px) {
    #hs-root-causes-{{ section.id }} .hs-root-causes__inner {
      padding: 60px 15px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__heading {
      font-size: 26px;
      line-height: 1.18;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__eyebrow {
      margin-bottom: 14px;
      font-size: 14px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__text {
      margin-top: 18px;
      font-size: 14px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__grid {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 42px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__card {
      min-height: 150px;
      padding: 24px 88px 24px 14px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__card-title {
      margin-bottom: 12px;
      font-size: 16px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__card-text {
      font-size: 12px;
            font-style: italic;

    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__card-result {
      margin-top: 14px;
      font-size: 12px;
      font-style: italic;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__number {
      top: 18px;
      right: 14px;
      width: 42px;
      height: 42px;
      border-width: 2px;
      font-size: 26px;
      font-family: "Cormorant Garamond";
    }
  }

  @media screen and (max-width: 450px) {
    #hs-root-causes-{{ section.id }} .hs-root-causes__heading {
      font-size: 20px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__card {
      padding: 20px 72px 20px 14px;
    }

    #hs-root-causes-{{ section.id }} .hs-root-causes__number {
      width: 38px;
      height: 38px;
      font-size: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "HairScripts Root Causes",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY HAIR THINS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "FOUR ROOT CAUSES. ONE FORMULA\nTHAT ADDRESSES THEM ALL."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hair thinning is rarely one thing. It's a convergence of biological stressors disrupting the follicle's ability to complete a healthy growth cycle.</p>"
    },
    {
      "type": "color",
      "id": "background_color_left",
      "label": "Background color left",
      "default": "#3F8F89"
    },
    {
      "type": "color",
      "id": "background_color_right",
      "label": "Background color right",
      "default": "#55C6BE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#366C68"
    },
    {
      "type": "color",
      "id": "number_background_color",
      "label": "Number background color",
      "default": "#F8F3EC"
    },
    {
      "type": "color",
      "id": "number_border_color",
      "label": "Number border color",
      "default": "#D8C6B4"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#222222"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "type": "cause",
      "name": "Root cause",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hormonal Disruption"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>DHT miniaturizes follicles and shortens the growth phase. Estrogen drops during perimenopause and postpartum periods remove the hormonal support that keeps hair actively growing.</p>"
        },
        {
          "type": "text",
          "id": "result",
          "label": "Result text",
          "default": "Thinning edges, temples, and crown"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HairScripts Root Causes",
      "blocks": [
        {
          "type": "cause",
          "settings": {
            "number": "01",
            "title": "Hormonal Disruption",
            "description": "<p>DHT miniaturizes follicles and shortens the growth phase. Estrogen drops during perimenopause and postpartum periods remove the hormonal support that keeps hair actively growing.</p>",
            "result": "Thinning edges, temples, and crown"
          }
        },
        {
          "type": "cause",
          "settings": {
            "number": "02",
            "title": "Nutritional Deficiency",
            "description": "<p>Hair follicles are among the most metabolically active cells in the body. Even subclinical deficiencies in iron, zinc, and B vitamins are enough to disrupt the growth cycle.</p>",
            "result": "Density loss, slower growth, breakage"
          }
        },
        {
          "type": "cause",
          "settings": {
            "number": "03",
            "title": "Chronic Stress",
            "description": "<p>Elevated cortisol forces follicles from the growth phase into rest prematurely. The result appears as sudden shedding 2–4 months after the stressor — called telogen effluvium.</p>",
            "result": "More hair in the shower, brush, and sink"
          }
        },
        {
          "type": "cause",
          "settings": {
            "number": "04",
            "title": "Oxidative Stress & Scalp Health",
            "description": "<p>Free radical damage at the dermal papilla impairs the cells that direct hair growth. Poor scalp circulation reduces the nutrient delivery follicles need to complete a full growth cycle.</p>",
            "result": "Follicle miniaturization, reduced growth speed"
          }
        }
      ]
    }
  ]
}
{% endschema %}